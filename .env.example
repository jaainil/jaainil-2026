# ==============================================================================
# Jainil Prajapati — Personal Engineering Platform & Shravonix
# Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 🧠 AI & LLM Provider Configuration
# ------------------------------------------------------------------------------

# Google Gemini API Key (Required for primary answer generation)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter API Key (Required for dense embeddings & neural reranking)
# Obtain from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Dense Vector Embedding Model (1536 dimensions)
# Generated via OpenRouter SDK in batches of 20
EMBEDDING_MODEL=text-embedding-3-small

# Neural Reranker Model (Used in DEEP_PATH for ambiguous candidate matches)
# Executed via OpenRouter Rerank endpoint (https://openrouter.ai/api/v1/rerank)
RERANK_MODEL=voyageai/rerank-2.5-lite


# ------------------------------------------------------------------------------
# 🐘 Database & Vector Store (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------

# PostgreSQL connection URI (with pgvector extension installed)
# Format: postgres://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://postgres:your_password@localhost:5432/postgres
POSTGRES_URL=postgres://postgres:your_password@localhost:5432/postgres


# ------------------------------------------------------------------------------
# 🐉 In-Memory Cache & Distributed Mutex (Dragonfly / Redis)
# ------------------------------------------------------------------------------

# Dragonfly / Redis connection URI (used for Tier 1 answer cache, Tier 2 vector
# cache, singleflight mutex locking, and sliding-window rate limiting)
# Format: redis://:<password>@<host>:<port>/<db_index>
DRAGONFLY_URL=redis://:your_password@localhost:6379/0
REDIS_URL=redis://:your_password@localhost:6379/0


# ------------------------------------------------------------------------------
# 📦 Knowledge Base Versioning & Cache Invalidation
# ------------------------------------------------------------------------------

# Active knowledge base version string. Incremented automatically during
# `npm run rag:index` to instantly invalidate stale cached answers across Dragonfly.
KB_VERSION=20260825_1


# ------------------------------------------------------------------------------
# 🧪 RAG Evaluation Benchmark Thresholds (Optional)
# ------------------------------------------------------------------------------

# Minimum percentage thresholds required for `npm run rag:eval` to pass
RAG_MIN_RECALL_AT_3=85
RAG_MIN_REFUSAL_ACCURACY=95


# ------------------------------------------------------------------------------
# 📊 Analytics & Telemetry (Optional)
# ------------------------------------------------------------------------------

# Umami Analytics Website ID
UMAMI_WEBSITE_ID=8169229f-6d5b-4ffc-ac38-9036661b5d94

# ------------------------------------------------------------------------------
# ✍️  Writenex Remote CMS (login at /_writenex)
# ------------------------------------------------------------------------------
# Admin credentials for the remote CMS. NEVER commit real values — they are read
# at server runtime (set in your systemd EnvironmentFile / Docker secrets).
# Generate: openssl rand -base64 24 (password) / openssl rand -hex 32 (secret)
WRITENEX_CMS_USER=admin
WRITENEX_CMS_PASS=change_me_long_random_password
WRITENEX_SECRET=change_me_64_hex_chars
