---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';

import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Seo } from 'astro-seo-meta';
import { Schema } from 'astro-seo-schema';
import '../styles/global.css';

interface ResolvedAuthor {
  name: string;
  avatarUrl?: string;
  slug?: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  articleData?: any;
  resolvedAuthors?: ResolvedAuthor[];
}

const SITE_URL = 'https://jaainil.com';
const PROFILE_IMAGE = `${SITE_URL}/profile.png`;

const {
  title = 'Jainil Prajapati — Full-Stack Developer & DevOps Engineer',
  description = 'Portfolio of Jainil Prajapati. Full-Stack Developer and DevOps Engineer experienced in Next.js, Node.js, Docker containerization, CI/CD pipeline automation, and Linux systems.',
  image = PROFILE_IMAGE,
  articleData = null,
  resolvedAuthors = null,
} = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site || SITE_URL);
const currentUrl = url.toString();

const resolvedOgImage = image?.startsWith('http')
  ? image
  : image?.startsWith('/')
    ? `${SITE_URL}${image}`
    : PROFILE_IMAGE;
const LOGO_URL = `${SITE_URL}/shravonix.png`;
const OG_FALLBACK = `${SITE_URL}/og.jpg`;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE_URL}/#person`,
  name: 'Jainil Prajapati',
  jobTitle: 'Full-Stack Developer & DevOps Engineer',
  url: SITE_URL,
  image: `${SITE_URL}/profile.png`,
  email: 'jainilprajapati9@gmail.com',
  telephone: '+919725284302',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Anand',
    addressRegion: 'Gujarat',
    addressCountry: 'IN',
  },
  sameAs: [
    'https://www.linkedin.com/in/jaainil/',
    'https://github.com/jaainil',
    'https://www.npmjs.com/~imjp',
    'https://www.reddit.com/user/enough_jainil/',
  ],
  worksFor: {
    '@type': 'Organization',
    name: 'Aexawareinfotech Pvt. Ltd.',
    url: 'https://aexaware.com',
  },
  alumniOf: {
    '@type': 'EducationalOrganization',
    name: 'Sardar Vallabhbhai Patel Institute of Technology',
  },
  knowsAbout: [
    'Full-Stack Web Development',
    'DevOps',
    'CI/CD Pipelines',
    'Docker Containerization',
    'Linux Server Administration',
    'Proxmox VE',
    'Next.js',
    'Astro',
    'Node.js',
    'Prisma ORM',
    'PostgreSQL',
  ],
};

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: 'Jainil Prajapati — Full-Stack Developer & DevOps Engineer',
  alternateName: 'Jainil Prajapati Portfolio & Blog',
  description: 'Full-stack development, DevOps pipelines, Docker containerization, Linux administration, and open-source ecosystems by Jainil Prajapati.',
  url: SITE_URL,
  inLanguage: 'en',
  publisher: {
    '@id': `${SITE_URL}/#person`,
  },
  author: {
    '@id': `${SITE_URL}/#person`,
  },
};

const schemaAuthors = resolvedAuthors
  ? resolvedAuthors.map((a) => ({
      '@type': 'Person',
      name: a.name,
      ...(a.avatarUrl && { image: a.avatarUrl }),
      url: a.slug ? `${SITE_URL}/authors/${a.slug}` : `${SITE_URL}/about`,
    }))
  : articleData?.authors?.map((slug: string) => ({
      '@type': 'Person',
      name: slug,
      url: `${SITE_URL}/authors/${slug}`,
    }));

const articleSchema = articleData ? {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  '@id': `${currentUrl}#article`,
  headline: articleData.title,
  description: articleData.description,
  image: [image || OG_FALLBACK],
  author: schemaAuthors,
  publisher: {
    '@id': `${SITE_URL}/#person`,
  },
  datePublished: articleData.publishedAt instanceof Date ? articleData.publishedAt.toISOString() : articleData.publishedAt,
  dateModified: articleData.updatedAt
    ? (articleData.updatedAt instanceof Date ? articleData.updatedAt.toISOString() : articleData.updatedAt)
    : (articleData.publishedAt instanceof Date ? articleData.publishedAt.toISOString() : articleData.publishedAt),
  url: currentUrl,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': currentUrl,
  },
  inLanguage: 'en',
  ...(articleData.tags?.length && { keywords: articleData.tags.join(', ') }),
  ...(articleData.category && { articleSection: articleData.category }),
} : null;

---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (function() {
        var stored = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <link rel="canonical" href={currentUrl} />
    <link rel="alternate" type="application/rss+xml" title="Jainil Prajapati - Tech & DevOps Blog" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/png" href="/profile.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/profile.png" />
    <Seo
      title={title}
      description={description}
      icon="/profile.png"
      themeColor="#000000"
      colorScheme="dark"
      robots="index, follow"
      facebook={{
        image: resolvedOgImage,
        url: currentUrl,
        type: articleData ? 'article' : 'website'
      }}
      twitter={{
        image: resolvedOgImage,
        site: '@jaainil',
        card: 'summary_large_image'
      }}
    />
    {articleSchema && <Schema item={articleSchema as any} />}
    <Schema item={personSchema as any} />
    <Schema item={siteSchema as any} />
    <slot name="head" />
  </head>
  <body style="background-color: var(--color-bg); color: var(--color-text-primary);" class="font-sans transition-colors duration-200">
    <div class="min-h-screen" style="background-color: var(--color-bg);">
      <div class="max-w-7xl mx-auto min-h-screen flex flex-col border-x" style="background-color: var(--color-surface); border-color: var(--color-border);">
        <Navbar />
        <main class="grow">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
  </body>
</html>