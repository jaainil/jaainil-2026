---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';

import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Seo } from 'astro-seo-meta';
import { Schema } from 'astro-seo-schema';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  articleData?: any;
}

const {
  title = 'Shravonix - Tech News & Deep Dives',
  description = 'In-depth technical analysis on AI models, browser engines, web frameworks, Linux kernel, and hardware. Nerdy insights for developers and tech enthusiasts who want deep technical content.',
  image = 'https://shravonix.com/og.jpg',
  articleData = null
} = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
const currentUrl = url.toString();

const siteSchema = {
  '@context': 'http://schema.org',
  '@type': 'WebSite',
  name: 'Shravonix',
  description: description,
  url: 'https://shravonix.com',
  publisher: {
    '@type': 'Organization',
    name: 'Shravonix',
    url: 'https://shravonix.com',
    logo: {
      '@type': 'ImageObject',
      url: 'https://shravonix.com/og.jpg'
    }
  }
};

const articleSchema = articleData ? {
  '@context': 'http://schema.org',
  '@type': 'Article',
  headline: articleData.title,
  description: articleData.description,
  image: [image],
  author: articleData.authors?.map((author: any) => ({
    '@type': 'Person',
    name: author.name,
    image: author.avatarUrl
  })),
  datePublished: articleData.date,
  dateModified: articleData.date,
  url: currentUrl,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': currentUrl
  },
  publisher: {
    '@type': 'Organization',
    name: 'Shravonix',
    url: 'https://shravonix.com',
    logo: {
      '@type': 'ImageObject',
      url: 'https://shravonix.com/og.jpg'
    }
  }
} : null;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (function() {
        var stored = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <link rel="alternate" type="application/rss+xml" title="Shravonix - Tech News & Deep Dives" href="/rss.xml" />
    <Seo
      title={title}
      description={description}
      icon="/favicon.ico"
      themeColor="#000000"
      colorScheme="dark"
      robots="index, follow"
      facebook={{
        image: image,
        url: currentUrl,
        type: articleData ? 'article' : 'website'
      }}
      twitter={{
        image: image,
        site: '@shravonix',
        card: 'summary_large_image'
      }}
      link={[
        { rel: "canonical", href: currentUrl }
      ]}
    />
    {articleSchema && <Schema item={articleSchema} />}
    <Schema item={siteSchema} />
  </head>
  <body style="background-color: var(--color-bg); color: var(--color-text-primary);" class="font-sans transition-colors duration-200">
    <div class="min-h-screen" style="background-color: var(--color-bg);">
      <div class="max-w-7xl mx-auto min-h-screen flex flex-col border-x" style="background-color: var(--color-surface); border-color: var(--color-border);">
        <Navbar />
        <main class="grow">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
  </body>
</html>