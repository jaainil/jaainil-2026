---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';

import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { SEO } from 'astro-seo';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { 
  title = 'TechPulse', 
  description = 'The world\'s best tech news and blog platform.',
  image = 'https://shravonix.com/og.jpg'
} = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={title}
      description={description}
      openGraph={{
        basic: {
          title: title,
          type: 'website',
          image: image,
        },
        optional: {
          description: description,
          siteName: 'TechPulse',
        },
      }}
      twitter={{
        card: 'summary_large_image',
        creator: '@techpulse',
      }}
    />
  </head>
  <body>
    <div class="min-h-screen bg-zinc-50 text-zinc-900 font-sans">
      <div class="max-w-7xl mx-auto bg-white min-h-screen flex flex-col border-x border-zinc-200">
        <Navbar />
        <main class="grow">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
  </body>
</html>