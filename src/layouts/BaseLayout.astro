---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';

import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Seo } from 'astro-seo-meta';
import { Schema } from 'astro-seo-schema';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  articleData?: any;
}

const {
  title = 'Shravonix - Tech News & Deep Dives',
  description = 'In-depth technical analysis on AI models, browser engines, web frameworks, Linux kernel, and hardware. Nerdy insights for developers and tech enthusiasts who want deep technical content.',
  image = 'https://shravonix.com/og.jpg',
  articleData = null
} = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
const currentUrl = url.toString();

const SITE_URL = 'https://shravonix.com';
const LOGO_URL = `${SITE_URL}/shravonix.png`;
const OG_FALLBACK = `${SITE_URL}/og.jpg`;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE_URL}/#organization`,
  name: 'Shravonix',
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: LOGO_URL,
  },
  sameAs: [
    'https://twitter.com/shravonix',
  ],
};

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: 'Shravonix',
  description: description,
  url: SITE_URL,
  publisher: {
    '@id': `${SITE_URL}/#organization`,
  },
};

const articleSchema = articleData ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: articleData.title,
  description: articleData.description,
  image: [image || OG_FALLBACK],
  author: articleData.authors?.map((author: any) => {
    const name = typeof author === 'string' ? author : author.name;
    const avatarUrl = typeof author === 'string' ? undefined : author.avatarUrl;
    return {
      '@type': 'Person',
      name,
      image: avatarUrl,
      url: SITE_URL,
    };
  }),
  datePublished: articleData.publishedAt instanceof Date ? articleData.publishedAt.toISOString() : articleData.publishedAt,
  dateModified: articleData.publishedAt instanceof Date ? articleData.publishedAt.toISOString() : articleData.publishedAt,
  url: currentUrl,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': currentUrl,
  },
  publisher: {
    '@id': `${SITE_URL}/#organization`,
  },
} : null;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (function() {
        var stored = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <link rel="canonical" href={currentUrl} />
    <link rel="alternate" type="application/rss+xml" title="Shravonix - Tech News & Deep Dives" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/shravonix.png" />
    <Seo
      title={title}
      description={description}
      icon="/favicon.ico"
      themeColor="#000000"
      colorScheme="dark"
      robots="index, follow"
      facebook={{
        image: image,
        url: currentUrl,
        type: articleData ? 'article' : 'website'
      }}
      twitter={{
        image: image,
        site: '@shravonix',
        card: 'summary_large_image'
      }}
    />
    {articleSchema && <Schema item={articleSchema as any} />}
    <Schema item={organizationSchema as any} />
    <Schema item={siteSchema as any} />
    <slot name="head" />
  </head>
  <body style="background-color: var(--color-bg); color: var(--color-text-primary);" class="font-sans transition-colors duration-200">
    <div class="min-h-screen" style="background-color: var(--color-bg);">
      <div class="max-w-7xl mx-auto min-h-screen flex flex-col border-x" style="background-color: var(--color-surface); border-color: var(--color-border);">
        <Navbar />
        <main class="grow">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
  </body>
</html>