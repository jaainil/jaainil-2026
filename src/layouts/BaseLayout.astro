---
import '@fontsource-variable/rubik';

import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { SEO } from 'astro-seo';
import { Schema } from 'astro-seo-schema';
import '../styles/global.css';

interface ResolvedAuthor {
  name: string;
  avatarUrl?: string;
  slug?: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  articleData?: any;
  resolvedAuthors?: ResolvedAuthor[];
}

const SITE_URL = 'https://jaainil.com';
const PROFILE_IMAGE = `${SITE_URL}/profile.png`;

const {
  title = 'Jainil Prajapati — Full-Stack Developer & DevOps Engineer',
  description = 'Portfolio of Jainil Prajapati. Full-Stack Developer and DevOps Engineer experienced in Next.js, Node.js, Docker containerization, CI/CD pipeline automation, and Linux systems.',
  image = PROFILE_IMAGE,
  articleData = null,
  resolvedAuthors = null,
} = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site || SITE_URL);
const currentUrl = url.toString();

const resolvedOgImage = image?.startsWith('http')
  ? image
  : image?.startsWith('/')
    ? `${SITE_URL}${image}`
    : PROFILE_IMAGE;
const LOGO_URL = `${SITE_URL}/shravonix.png`;
const OG_FALLBACK = `${SITE_URL}/og.jpg`;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE_URL}/#person`,
  name: 'Jainil Prajapati',
  jobTitle: 'Full-Stack Developer & DevOps Engineer',
  url: SITE_URL,
  image: `${SITE_URL}/profile.png`,
  email: 'jainilprajapati9@gmail.com',
  telephone: '+919725284302',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Anand',
    addressRegion: 'Gujarat',
    addressCountry: 'IN',
  },
  sameAs: [
    'https://www.linkedin.com/in/jaainil/',
    'https://github.com/jaainil',
    'https://www.npmjs.com/~imjp',
    'https://www.reddit.com/user/enough_jainil/',
  ],
  worksFor: {
    '@type': 'Organization',
    name: 'Aexawareinfotech Pvt. Ltd.',
    url: 'https://aexaware.com',
  },
  alumniOf: {
    '@type': 'EducationalOrganization',
    name: 'Sardar Vallabhbhai Patel Institute of Technology',
  },
  knowsAbout: [
    'Full-Stack Web Development',
    'DevOps',
    'CI/CD Pipelines',
    'Docker Containerization',
    'Linux Server Administration',
    'Proxmox VE',
    'Next.js',
    'Astro',
    'Node.js',
    'Prisma ORM',
    'PostgreSQL',
  ],
};

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: 'Jainil Prajapati — Full-Stack Developer & DevOps Engineer',
  alternateName: 'Jainil Prajapati Portfolio & Blog',
  description: 'Full-stack development, DevOps pipelines, Docker containerization, Linux administration, and open-source ecosystems by Jainil Prajapati.',
  url: SITE_URL,
  inLanguage: 'en',
  publisher: {
    '@id': `${SITE_URL}/#person`,
  },
  author: {
    '@id': `${SITE_URL}/#person`,
  },
};

const schemaAuthors = resolvedAuthors
  ? resolvedAuthors.map((a) => ({
      '@type': 'Person',
      name: a.name,
      ...(a.avatarUrl && { image: a.avatarUrl }),
      url: a.slug ? `${SITE_URL}/authors/${a.slug}` : `${SITE_URL}/about`,
    }))
  : articleData?.authors?.map((slug: string) => ({
      '@type': 'Person',
      name: slug,
      url: `${SITE_URL}/authors/${slug}`,
    }));

const articleSchema = articleData ? {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  '@id': `${currentUrl}#article`,
  headline: articleData.title,
  description: articleData.description,
  image: [image || OG_FALLBACK],
  author: schemaAuthors,
  publisher: {
    '@id': `${SITE_URL}/#person`,
  },
  datePublished: articleData.publishedAt instanceof Date ? articleData.publishedAt.toISOString() : articleData.publishedAt,
  dateModified: articleData.updatedAt
    ? (articleData.updatedAt instanceof Date ? articleData.updatedAt.toISOString() : articleData.updatedAt)
    : (articleData.publishedAt instanceof Date ? articleData.publishedAt.toISOString() : articleData.publishedAt),
  url: currentUrl,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': currentUrl,
  },
  inLanguage: 'en',
  ...(articleData.tags?.length && { keywords: articleData.tags.join(', ') }),
  ...(articleData.category && { articleSection: articleData.category }),
} : null;

---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (function() {
        var stored = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <SEO
      title={title}
      description={description}
      canonical={currentUrl}
      openGraph={{
        basic: {
          title: title,
          type: articleData ? 'article' : 'website',
          image: resolvedOgImage,
          url: currentUrl,
        },
        optional: {
          description: description,
          siteName: 'Jainil Prajapati',
        },
        ...(articleData && {
          article: {
            publishedTime: articleData.publishedAt instanceof Date ? articleData.publishedAt.toISOString() : articleData.publishedAt,
            modifiedTime: articleData.updatedAt
              ? (articleData.updatedAt instanceof Date ? articleData.updatedAt.toISOString() : articleData.updatedAt)
              : (articleData.publishedAt instanceof Date ? articleData.publishedAt.toISOString() : articleData.publishedAt),
            authors: articleData.authors || ['Jainil Prajapati'],
            section: articleData.category || 'Technology',
            tags: articleData.tags || [],
          },
        }),
      }}
      twitter={{
        card: 'summary_large_image',
        site: '@jaainil',
        creator: '@jaainil',
        title: title,
        description: description,
        image: resolvedOgImage,
      }}
      extend={{
        link: [
          { rel: 'icon', type: 'image/png', href: '/profile.png' },
          { rel: 'apple-touch-icon', sizes: '180x180', href: '/profile.png' },
          { rel: 'alternate', type: 'application/rss+xml', title: 'Jainil Prajapati - Tech & DevOps Blog', href: '/rss.xml' },
          { rel: 'sitemap', href: '/sitemap-index.xml' },
          { rel: 'api-catalog', href: '/.well-known/api-catalog' },
          { rel: 'service-desc', href: '/.well-known/ai-catalog.json' },
        ],
        meta: [
          { name: 'theme-color', content: '#000000' },
          { name: 'color-scheme', content: 'dark light' },
        ],
      }}
    />
    {articleSchema && <Schema item={articleSchema as any} />}
    <Schema item={personSchema as any} />
    <Schema item={siteSchema as any} />
    <slot name="head" />
  </head>
  <body style="background-color: var(--color-bg); color: var(--color-text-primary);" class="font-sans transition-colors duration-200">
    <Fragment set:html={`<!--
      DIRECTION CONTRACT — seed 0bb616d4, world: Build Instructions (user-chosen).
      THESIS: A portfolio built like a brick instruction book: every project taught
      as numbered steps, each step showing only the piece it added. It refuses the
      terminal-dashboard default this category ships.
      OWN-WORLD: Sky-blue instruction pages, black keylines, brick red for the new
      piece, build yellow for where the build stands, accent blue for controls.
      Chunky rounded grotesque numerals. Isometric brick diagrams with leader-line
      labels and 1:1 call-outs. Stud-grid plates under diagrams.
      STORY: The visitor understands he assembles real systems, believes it because
      every claim links to its artifact, and emails him.
      FIRST VIEWPORT: Header tabs on top. Left: availability badge, name in 900
      display, one-liner, two CTAs. Right: exploded isometric server stack dropping
      together, pieces-in-this-set call-out beside it.
      FORM: Build-instruction booklet, dealt challenger games-toys-physics-play-brick-build-instructions,
      chosen by the user from the dealt hand.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the
      finish review, the verdict, DESIGN.md, and every shipping raster carrying its
      provenance.
    -->`} />
    <div class="min-h-screen" style="background-color: var(--color-bg);">
        <div class="min-h-screen flex flex-col">
          <Navbar />
          <main class="grow">
            <slot />
          </main>
          <Footer />
        </div>
    </div>
    <script is:inline>
      // WebMCP API (W3C Web Machine Learning Model Context Protocol)
      if (typeof window !== 'undefined' && 'modelContext' in navigator && navigator.modelContext?.provideContext) {
        try {
          navigator.modelContext.provideContext({
            tools: [
              {
                name: 'getSiteInfo',
                description: 'Get developer profile, contact details, and site purpose for Jainil Prajapati',
                inputSchema: {
                  type: 'object',
                  properties: {}
                },
                execute: async () => ({
                  name: 'Jainil Prajapati',
                  role: 'Full-Stack Developer & DevOps Engineer',
                  site: 'https://jaainil.com',
                  articlesUrl: 'https://jaainil.com/articles',
                  llmsTxt: 'https://jaainil.com/llms.txt',
                  github: 'https://github.com/jaainil'
                })
              },
              {
                name: 'searchArticles',
                description: 'Search technical articles published on jaainil.com',
                inputSchema: {
                  type: 'object',
                  properties: {
                    query: { type: 'string', description: 'Search term or keyword' }
                  }
                },
                execute: async (args) => {
                  try {
                    const res = await fetch('/llms.txt');
                    const text = await res.text();
                    return { results: text, query: args?.query || '' };
                  } catch (e) {
                    return { error: 'Could not retrieve articles index' };
                  }
                }
              }
            ]
          });
        } catch (err) {
          console.debug('[WebMCP] provideContext initialization:', err);
        }
      }
    </script>
  </body>
</html>