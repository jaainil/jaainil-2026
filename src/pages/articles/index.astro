---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { Article } from '../../types';

const allArticles = await getCollection('articles');
const articles: Article[] = allArticles.map((a) => {
  const { imageUrl, ...rest } = a.data;
  return {
    id: a.id,
    ...rest,
    imageUrl: (imageUrl as any).src ?? imageUrl,
  } as Article;
}).sort((a: Article, b: Article) =>
  new Date(b.date).getTime() - new Date(a.date).getTime()
);

// Derive all unique categories dynamically from articles
const rawCategories = [...new Set(articles.map((a) => a.category))].sort();
const CATEGORIES = ['All', ...rawCategories];

// Read active category from query param
const url = new URL(Astro.request.url);
const activeCategory = url.searchParams.get('category') ?? 'All';

const filteredArticles = activeCategory === 'All'
  ? articles
  : articles.filter((a) => a.category === activeCategory);
---

<BaseLayout title="Article Index — Shravonix" description="Browse every article published on Shravonix, filtered by category.">
  <div class="w-full pb-16">

    <!-- Page Header -->
    <div class="border-b border-zinc-200 px-6 md:px-8 py-10">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="text-[11px] font-mono text-zinc-400 uppercase tracking-widest mb-2">// Archive</p>
          <h1 class="text-4xl md:text-5xl font-display font-bold tracking-tight text-zinc-900">
            Article Index
          </h1>
        </div>
        <p class="text-[11px] font-mono text-zinc-400 uppercase tracking-widest pb-1 hidden md:block">
          {filteredArticles.length} article{filteredArticles.length !== 1 ? 's' : ''}
        </p>
      </div>
    </div>

    <!-- Category Filter + Search -->
    <div class="px-6 md:px-8 py-6 border-b border-zinc-200">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div class="flex items-center gap-0 overflow-x-auto w-full md:w-auto hide-scrollbar border border-zinc-200">
          {CATEGORIES.map((category: string, index: number) => (
            <a
              href={category === 'All' ? '/articles' : `/articles?category=${encodeURIComponent(category)}`}
              class={`px-6 py-3 text-xs font-mono uppercase tracking-widest whitespace-nowrap transition-colors ${index !== 0 ? "border-l border-zinc-200" : ""} ${activeCategory === category ? "bg-zinc-900 text-white" : "bg-white text-zinc-600 hover:bg-zinc-50"}`}
            >
              {category}
            </a>
          ))}
        </div>

        <div class="relative w-full md:w-64 border border-zinc-200">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="text"
            placeholder="SEARCH ARTICLES..."
            class="w-full pl-10 pr-4 py-3 rounded-none bg-white border-none focus:ring-0 text-xs font-mono uppercase tracking-widest placeholder:text-zinc-400 outline-none"
          />
        </div>
      </div>
    </div>

    <!-- Articles Grid -->
    {filteredArticles.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-0 border-b border-zinc-200">
        {filteredArticles.map((article: Article, index: number) => (
          <a
            href={`/articles/${article.id}`}
            class={`group flex flex-col h-full border-b border-zinc-200 hover:bg-zinc-50 transition-colors ${index % 2 === 0 ? "md:border-r" : "md:border-r-0"} ${(index + 1) % 3 !== 0 ? "lg:border-r" : "lg:border-r-0"}`}
          >
            <div class="p-6 md:p-8 grow">
              <div class="aspect-video rounded-none overflow-hidden bg-zinc-100 mb-6 border border-zinc-200">
                <img
                  src={article.imageUrl}
                  alt={article.title}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
              <div class="flex items-center gap-2 text-[11px] font-mono text-zinc-500 uppercase tracking-widest mb-3">
                <span>// {article.category}</span>
              </div>
              <h3 class="text-xl font-display font-bold tracking-tight text-zinc-900 mb-4">
                {article.title}
              </h3>
              {article.description && (
                <p class="text-sm text-zinc-500 font-sans leading-relaxed line-clamp-2">
                  {article.description}
                </p>
              )}
            </div>
            <div class="border-t border-zinc-200 p-4 px-6 md:px-8 flex items-center justify-between mt-auto">
              <div class="flex -space-x-2">
                {article.authors.map((author: { name: string; avatarUrl: string }) => (
                  <img
                    src={author.avatarUrl}
                    alt={author.name}
                    class="w-6 h-6 rounded-none border border-zinc-200"
                    loading="lazy"
                  />
                ))}
              </div>
              <div class="text-[11px] font-mono text-zinc-500 uppercase tracking-widest">
                {article.date}
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="px-6 md:px-8 py-24 text-center border-b border-zinc-200">
        <p class="text-[11px] font-mono text-zinc-400 uppercase tracking-widest">No articles found in this category.</p>
      </div>
    )}

  </div>
</BaseLayout>
