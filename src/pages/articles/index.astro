---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { Schema } from 'astro-seo-schema';
import type { Article } from '../../types';

const allArticles = await getCollection('articles');
const allAuthors = await getCollection('authors');
const authorMap = new Map(allAuthors.map(a => [a.id, a.data]));

const articles: Article[] = allArticles
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .map((a) => {
    const { imageUrl, publishedAt, authors, ...rest } = a.data;
    return {
      id: a.id,
      ...rest,
      imageUrl,
      publishedAt: publishedAt.toISOString().split('T')[0],
      authors: authors.map((slug: string) => {
        const author = authorMap.get(slug);
        return author ? { id: slug, name: author.name, avatarUrl: author.avatarUrl } : { id: slug, name: slug, avatarUrl: '' };
      }),
    } as Article;
  });

// Fixed category order
const CATEGORIES = ['All', 'Linux', 'Tech', 'AI', 'IoT', 'Opinions', 'Programming'];

const fmtDate = (iso: string) =>
  new Date(iso + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const SITE_URL = 'https://jaainil.com';
const pageUrl = `${SITE_URL}/articles`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Articles', item: pageUrl },
  ],
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#webpage`,
  name: 'Technical Blog & Deep Dives — Jainil Prajapati',
  description: 'Technical articles, DevOps pipelines, Linux guides, homelab tutorials, and systems engineering analysis by Jainil Prajapati.',
  url: pageUrl,
  inLanguage: 'en',
  isPartOf: { '@id': `${SITE_URL}/#website` },
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Jainil Prajapati Technical Articles',
  description: 'All technical articles published by Jainil Prajapati',
  url: pageUrl,
  numberOfItems: articles.length,
  itemListElement: articles.map((article, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `${SITE_URL}/articles/${article.id}`,
    name: article.title,
  })),
};
---

<BaseLayout
  title="Technical Blog & Articles — Jainil Prajapati"
  description="Technical articles, DevOps pipelines, Linux guides, homelab tutorials, and systems engineering analysis by Jainil Prajapati."
>
  <Fragment slot="head">
    <Schema item={breadcrumbSchema as any} />
    <Schema item={webPageSchema as any} />
    <Schema item={itemListSchema as any} />
  </Fragment>

  <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-10 sm:pt-16 pb-16">
    <div class="max-w-2xl mb-10">
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight mb-4" style="color: var(--ink);">Field notes</h1>
      <p class="text-lg leading-relaxed" style="color: var(--color-text-secondary);">
        Everything I've written up: Linux deep dives, DevOps pipelines, homelab guides and architecture analysis. <span id="article-count" class="font-bold" style="color: var(--ink);">{articles.length} notes</span> and counting.
      </p>
    </div>

    <!-- Category Filter + Search -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-10">
      <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter by category">
        {CATEGORIES.map((category: string, index: number) => (
          <button
            data-category={category}
            class={`category-btn px-4 py-2.5 rounded-lg text-sm font-bold whitespace-nowrap transition-transform ${index === 0 ? 'hover:-translate-y-0.5' : 'hover:-translate-y-0.5'}`}
            style={`border: 2px solid var(--keyline); box-shadow: 0 2px 0 var(--keyline); background-color: ${index === 0 ? 'var(--action)' : 'var(--paper)'}; color: ${index === 0 ? '#ffffff' : 'var(--ink)'};`}
          >
            {category}
          </button>
        ))}
      </div>

      <div class="relative w-full md:w-72">
        <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 pointer-events-none" style="color: var(--color-text-muted);" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <label class="sr-only" for="search-input">Search articles</label>
        <input
          id="search-input"
          type="text"
          placeholder="Search the notes..."
          class="w-full pl-10 pr-4 py-3 rounded-xl text-sm font-semibold outline-none"
          style="background-color: var(--paper); color: var(--color-text-primary); border: 2px solid var(--keyline); box-shadow: 0 2px 0 var(--keyline);"
        />
      </div>
    </div>

    <!-- Articles Grid -->
    <div id="articles-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {articles.map((article: Article) => (
        <a
          href={`/articles/${article.id}`}
          data-category={article.category}
          data-title={article.title.toLowerCase()}
          data-description={(article.description ?? '').toLowerCase()}
          class="article-card group flex flex-col h-full rounded-2xl overflow-hidden transition-transform hover:-translate-y-1"
          style="background: var(--paper); border: 2px solid var(--keyline); box-shadow: 0 4px 0 var(--keyline);"
        >
          {article.imageUrl && (
            <div class="aspect-video overflow-hidden" style="border-bottom: 2px solid var(--keyline); background-color: var(--color-image-bg);">
              <Image
                src={article.imageUrl}
                alt={article.title}
                class="w-full h-full object-cover"
                width={600}
                height={338}
                format="webp"
                quality={80}
                loading="lazy"
              />
            </div>
          )}
          <div class="p-6 grow flex flex-col">
            <span class="self-start px-2.5 py-1 rounded-md text-[11px] font-black uppercase tracking-wide mb-3" style="border: 2px solid var(--keyline); background: var(--marker); color: #10151b;">
              {article.category}
            </span>
            <h2 class="text-lg font-extrabold tracking-tight leading-snug mb-2 group-hover:underline underline-offset-4 decoration-2" style="color: var(--ink);">
              {article.title}
            </h2>
            {article.description && (
              <p class="text-sm leading-relaxed line-clamp-2" style="color: var(--color-text-secondary);">
                {article.description}
              </p>
            )}
          </div>
          <div class="border-t-2 px-6 py-3.5 flex items-center justify-between mt-auto" style="border-color: var(--keyline);">
            <div class="flex -space-x-2">
              {article.authors.map((author: { name: string; avatarUrl: string }) => (
                <img
                  src={author.avatarUrl}
                  alt={author.name}
                  class="w-6 h-6 rounded-md object-cover"
                  style="border: 2px solid var(--keyline);"
                  loading="lazy"
                  decoding="async"
                  width="24"
                  height="24"
                />
              ))}
            </div>
            <span class="text-xs font-bold" style="color: var(--color-text-muted);">
              {fmtDate(article.publishedAt)}
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- Empty state -->
    <div id="empty-state" class="hidden py-20 text-center rounded-2xl" style="border: 2px dashed var(--keyline); background: var(--paper);">
      <p class="text-lg font-bold" style="color: var(--ink);">No notes match that.</p>
      <p class="text-sm mt-2" style="color: var(--color-text-muted);">Try another word or clear the category filter.</p>
    </div>
  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.category-btn');
  const cards = document.querySelectorAll<HTMLAnchorElement>('.article-card');
  const grid = document.getElementById('articles-grid')!;
  const emptyState = document.getElementById('empty-state')!;
  const countEl = document.getElementById('article-count')!;
  const searchInput = document.getElementById('search-input') as HTMLInputElement;

  let activeCategory = 'All';
  let searchQuery = '';

  function applyFilters() {
    let visible = 0;
    cards.forEach((card) => {
      const category = card.dataset.category ?? '';
      const title = card.dataset.title ?? '';
      const description = card.dataset.description ?? '';

      const matchesCategory = activeCategory === 'All' || category.toLowerCase() === activeCategory.toLowerCase();
      const matchesSearch = searchQuery === '' || title.includes(searchQuery) || description.includes(searchQuery);

      if (matchesCategory && matchesSearch) {
        card.style.display = '';
        visible++;
      } else {
        card.style.display = 'none';
      }
    });

    countEl.textContent = `${visible} note${visible !== 1 ? 's' : ''}`;

    if (visible === 0) {
      grid.classList.add('hidden');
      emptyState.classList.remove('hidden');
    } else {
      grid.classList.remove('hidden');
      emptyState.classList.add('hidden');
    }
  }

  function setActiveButton(category: string) {
    buttons.forEach((btn) => {
      const isActive = btn.dataset.category === category;
      btn.style.backgroundColor = isActive ? 'var(--action)' : 'var(--paper)';
      btn.style.color = isActive ? '#ffffff' : 'var(--ink)';
    });
  }

  const params = new URLSearchParams(window.location.search);
  const initialCategory = params.get('category') ?? 'All';
  activeCategory = initialCategory;
  setActiveButton(activeCategory);
  const initialQuery = (params.get('q') ?? '').toLowerCase().trim();
  if (initialQuery) {
    searchQuery = initialQuery;
    searchInput.value = initialQuery;
  }
  applyFilters();

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCategory = btn.dataset.category ?? 'All';
      setActiveButton(activeCategory);

      const url = new URL(window.location.href);
      if (activeCategory === 'All') {
        url.searchParams.delete('category');
      } else {
        url.searchParams.set('category', activeCategory);
      }
      history.replaceState(null, '', url.toString());

      applyFilters();
    });
  });

  searchInput.addEventListener('input', () => {
    searchQuery = searchInput.value.toLowerCase().trim();
    applyFilters();
  });
</script>
