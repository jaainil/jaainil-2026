---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import ArticleInteractive from '../../components/react/ArticleInteractive';
import AnimatedToc from '../../components/AnimatedToc.astro';
import ReadingProgressBar from '../../components/react/ReadingProgressBar';
import BackToTop from '../../components/react/BackToTop';
import { Schema } from 'astro-seo-schema';
import type { ImageMetadata } from 'astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);

const allArticles = await getCollection('articles');
const allAuthors = await getCollection('authors');
const authorMap = new Map(allAuthors.map(a => [a.id, a.data]));

const resolvedAuthors = article.data.authors.map((slug: string) => {
  const author = authorMap.get(slug);
  return author
    ? { name: author.name, avatarUrl: author.avatarUrl, slug }
    : { name: slug, avatarUrl: '', slug };
});

const relatedArticles = (() => {
  const currentTags = article.data.tags || [];
  const currentCategory = article.data.category;

  const articles = allArticles
    .filter((a) => a.id !== article.id)
    .map((a) => {
      const articleTags = a.data.tags || [];
      
      let score = 0;
      
      if (currentTags.length > 0 && articleTags.length > 0) {
        const commonTags = currentTags.filter((tag: string) => articleTags.includes(tag));
        score += commonTags.length * 10;
      }
      
      if (a.data.category === currentCategory) {
        score += 5;
      }
      
      const daysSincePublished = (Date.now() - a.data.publishedAt.getTime()) / (1000 * 60 * 60 * 24);
      score += Math.max(0, 10 - daysSincePublished * 0.1);
      
      return {
        article: a,
        score
      };
    })
    .sort((a, b) => b.score - a.score)
    .slice(0, 3)
    .map((item) => item.article);

  return articles;
})();

const TOC_ITEMS = headings.map((h) => ({
  id: h.slug,
  title: h.text,
}));

// article.data.imageUrl is typed as string in JSON schema but resolves to ImageMetadata at runtime
const imageUrlMeta = article.data.imageUrl as unknown as ImageMetadata;
const ogImage = imageUrlMeta?.src
  ? new URL(imageUrlMeta.src, Astro.site).toString()
  : 'https://jaainil.com/og.jpg';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://jaainil.com',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Articles',
      item: 'https://jaainil.com/articles',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: article.data.title,
      item: `https://jaainil.com/articles/${article.id}`,
    },
  ],
};
---

<BaseLayout 
  title={`${article.data.title} — Jainil Prajapati`}
  description={article.data.description}
  image={ogImage}
  articleData={article.data}
  resolvedAuthors={resolvedAuthors}
>
  <Fragment slot="head">
    <Schema item={breadcrumbSchema as any} />
    <script src="https://giscus.app/client.js"
      data-repo="jaainil/shravonix-com"
      data-repo-id="R_kgDORu0rcg"
      data-category="Comments (site)"
      data-category-id="DIC_kwDORu0rcs4C834X"
      data-mapping="title"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="preferred_color_scheme"
      data-lang="en"
      data-loading="lazy"
      crossorigin="anonymous"
      async>
    </script>
    <style>
      .giscus-frame {
        width: 100% !important;
      }
      .giscus {
        width: 100%;
      }
      .giscus-frame, .giscus-body {
        background-color: var(--color-bg) !important;
        color-scheme: light dark;
      }
    </style>
    <script is:inline>
      function updateGiscusTheme() {
        const theme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
        const iframe = document.querySelector('.giscus-frame');
        if (iframe && iframe.contentWindow) {
          iframe.contentWindow.postMessage({ giscus: { setConfig: { theme } } }, 'https://giscus.app');
        }
      }
      
      const observer = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          if (mutation.attributeName === 'class') {
            updateGiscusTheme();
          }
        });
      });
      
      observer.observe(document.documentElement, { attributes: true });
      
      document.addEventListener('DOMContentLoaded', () => {
        setTimeout(updateGiscusTheme, 100);
      });
    </script>
  </Fragment>
  <ReadingProgressBar client:only="react" />
  <BackToTop client:only="react" />
  <div class="max-w-7xl mx-auto border-x min-h-screen" style="border-color: var(--color-border); background-color: var(--color-surface);">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 p-6 sm:p-10 lg:p-16">
      <div class="flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-2 text-xs font-mono font-semibold uppercase tracking-wider mb-6" style="color: var(--color-text-muted);">
            <span>//</span>
            <span>{article.data.category}</span>
          </div>
          
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-medium tracking-tight leading-[1.1]" style="color: var(--color-text-primary);">
            {article.data.title}
          </h1>
        </div>
        
        <div class="text-xs font-mono font-semibold uppercase tracking-wider mt-12 lg:mt-0" style="color: var(--color-text-muted);">
          {article.data.publishedAt.toISOString().split('T')[0]}
        </div>
      </div>
      
      <div class="w-full h-full min-h-[300px] lg:min-h-[400px]" style="background-color: var(--color-image-bg);">
        <Image
          src={article.data.imageUrl}
          alt={article.data.imageAlt || article.data.title}
          class="w-full h-full object-cover"
          width={800}
          height={600}
          format="webp"
          quality={85}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>

    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 px-6 sm:px-10 lg:px-16 py-4 border-y" style="border-color: var(--color-border);">
      <div class="flex items-center gap-4">
        <div class="flex gap-1.5">
          {resolvedAuthors.map((author) => (
            <img 
              src={author.avatarUrl} 
              alt={author.name} 
              class="w-9 h-9 object-cover"
              style="background-color: var(--color-image-bg);"
              loading="lazy"
              decoding="async"
              width="36"
              height="36"
            />
          ))}
        </div>
        <div class="text-xs font-mono font-medium uppercase tracking-wider leading-relaxed max-w-md" style="color: var(--color-text-secondary);">
          {resolvedAuthors.map((a, i) => (
            <>
              {i > 0 && ', '}
              <a 
                href="/about" 
                class="hover:underline transition-colors"
                style="color: var(--color-text-secondary);"
                onmouseenter="this.style.color='var(--color-text-primary)'"
                onmouseleave="this.style.color='var(--color-text-secondary)'"
              >
                {a.name}
              </a>
            </>
          ))}
        </div>
      </div>
      
      <div class="flex flex-wrap items-center gap-4 sm:gap-6 text-xs font-mono font-medium uppercase tracking-wider" style="color: var(--color-text-muted);">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{article.data.publishedAt.toISOString().split('T')[0]}</span>
        </div>
        <ArticleInteractive client:only="react" articleTitle={article.data.title} />
      </div>
    </div>

    <div class="flex flex-col md:flex-row relative border-b" style="border-color: var(--color-border);">
      <div class="hidden md:block w-64 lg:w-72 shrink-0 border-r py-8 sm:py-12 lg:py-16 pl-6 sm:pl-10 lg:pl-16 pr-8 lg:pr-12" style="border-color: var(--color-border);">
        <div class="sticky top-24">
          <AnimatedToc items={TOC_ITEMS} />
        </div>
      </div>

      <div class="grow py-8 sm:py-12 lg:py-16 px-6 sm:px-10 lg:px-16 md:pl-8 lg:pl-12">
          <div class="prose prose-lg max-w-none prose-headings:font-display prose-headings:font-medium prose-headings:tracking-tight prose-a:text-blue-600 hover:prose-a:text-blue-700 prose-img:rounded-none dark:prose-invert">
            <Content />
          </div>

<style is:global>
  /* ponytail: scrollable tables instead of layout shift on mobile */
  .prose table { display: block; max-width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .prose thead, .prose tbody, .prose tr { display: table; width: 100%; }
</style>

        <div class="mt-16 pt-8 border-t" style="border-color: var(--color-border);">
          <div class="flex items-center gap-3 mb-6 pb-6 border-b" style="border-color: var(--color-border);">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--color-text-muted);">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
            <h2 class="text-xl font-display font-bold tracking-tight" style="color: var(--color-text-primary);">Comments</h2>
          </div>
          <div class="giscus" id="comments"></div>
        </div>
      </div>
    </div>

    <div class="border-b" style="border-color: var(--color-border);">
      <div class="px-6 sm:px-10 lg:px-16 py-12 border-b" style="border-color: var(--color-border);">
        <h2 class="text-2xl font-display font-bold tracking-tight" style="color: var(--color-text-primary);">Related Articles</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-0">
        {relatedArticles.map((relatedArticle, index) => (
          <a
            href={`/articles/${relatedArticle.id}`}
            class={`group flex flex-col h-full transition-colors ${index !== 2 ? "md:border-r" : ""} ${index !== 0 ? "border-t md:border-t-0" : ""}`}
            style="border-color: var(--color-border);"
            onmouseenter="this.style.backgroundColor='var(--color-hover)'"
            onmouseleave="this.style.backgroundColor=''"
          >
            <div class="p-6 md:p-8 grow">
              <div class="aspect-video rounded-none overflow-hidden mb-6 border" style="background-color: var(--color-image-bg); border-color: var(--color-border);">
                <Image
                  src={relatedArticle.data.imageUrl}
                  alt={relatedArticle.data.title}
                  class="w-full h-full object-cover"
                  width={400}
                  height={225}
                  format="webp"
                  quality={80}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="flex items-center gap-2 text-[11px] font-mono uppercase tracking-widest mb-3" style="color: var(--color-text-muted);">
                <span>// {relatedArticle.data.category}</span>
              </div>
              <h3 class="text-xl font-display font-bold tracking-tight mb-4" style="color: var(--color-text-primary);">
                {relatedArticle.data.title}
              </h3>
            </div>
            <div class="border-t p-4 px-6 md:p-8 flex items-center justify-between mt-auto" style="border-color: var(--color-border);">
              <div class="flex -space-x-2">
                {(() => {
                  const authorSlugs = relatedArticle.data.authors;
                  const authorData = authorSlugs.map((slug: string) => {
                    const author = authorMap.get(slug);
                    return author ? { name: author.name, avatarUrl: author.avatarUrl } : { name: slug, avatarUrl: '' };
                  });
                  return authorData.map((author) => (
                    <img 
                      src={author.avatarUrl} 
                      alt={author.name} 
                      class="w-6 h-6 rounded-none border"
                      style="border-color: var(--color-border);"
                      loading="lazy"
                      decoding="async"
                      width="24"
                      height="24"
                    />
                  ));
                })()}
              </div>
              <div class="text-[11px] font-mono uppercase tracking-widest" style="color: var(--color-text-muted);">
                {relatedArticle.data.publishedAt.toISOString().split('T')[0]}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>

    <div class="w-full py-16 px-6 sm:px-10 lg:px-16 flex flex-col md:flex-row items-center justify-between gap-8" style="background-color: var(--color-footer-bg); color: var(--color-footer-heading);">
      <div class="md:w-1/2">
        <h3 class="text-3xl md:text-4xl font-display font-bold tracking-tight mb-4">Never miss an update</h3>
        <p class="font-mono text-xs uppercase tracking-widest" style="color: var(--color-footer-text);">Join 50,000+ developers getting our weekly tech insights.</p>
      </div>
      <div class="w-full md:w-1/2">
        <form class="flex flex-col sm:flex-row gap-0 border" style="border-color: var(--color-footer-border);">
          <input 
            type="email" 
            placeholder="YOUR EMAIL ADDRESS" 
            autocomplete="off"
            class="border-none rounded-none px-4 py-4 grow focus:outline-none focus:ring-0 text-xs font-mono uppercase tracking-widest w-full"
            style="background-color: var(--color-footer-surface); color: var(--color-footer-heading);"
          />
          <button 
            type="submit" 
            class="px-8 py-4 rounded-none font-mono text-xs font-bold uppercase tracking-widest transition-colors border-t sm:border-t-0 sm:border-l whitespace-nowrap w-full sm:w-auto"
            style="background-color: var(--color-footer-heading); color: var(--color-footer-bg); border-color: var(--color-footer-border);"
          >
            Subscribe
          </button>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>
