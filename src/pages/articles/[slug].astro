---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro-lqip/components';
import ArticleInteractive from '../../components/react/ArticleInteractive';
import AnimatedToc from '../../components/react/AnimatedToc';
import { SocialShareButtons } from '../../components/react/SocialShareButtons';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);

const allArticles = await getCollection('articles');
const relatedArticles = allArticles
  .filter((a) => a.id !== article.id)
  .sort((a) => (a.data.category === article.data.category ? -1 : 1))
  .slice(0, 3);

const TOC_ITEMS = headings.map((h) => ({
  id: h.slug,
  title: h.text,
}));

const articleUrl = `https://shravonix.com/articles/${article.id}`;
const ogImage = article.data.imageUrl ? `https://shravonix.com${article.data.imageUrl}` : 'https://shravonix.com/og.jpg';
---

<BaseLayout 
  title={`${article.data.title} - Shravonix`}
  description={article.data.description}
  image={ogImage}
  articleData={article.data}
>
  <div class="max-w-7xl mx-auto border-x min-h-screen relative" style="border-color: var(--color-border); background-color: var(--color-surface);">
    
    <!-- Reading Progress Bar -->
    <div id="reading-progress" class="fixed top-0 left-0 right-0 h-1 z-[60] transition-all duration-100" style="width: 0%; background: var(--color-accent-bg);"></div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 p-6 sm:p-10 lg:p-16">
      <div class="flex flex-col justify-between">
        <div>
          <!-- Breadcrumb -->
          <nav class="flex items-center gap-2 text-[10px] font-mono uppercase tracking-widest mb-6" style="color: var(--color-text-muted);">
            <a href="/" class="hover:underline">Home</a>
            <span>/</span>
            <a href="/articles" class="hover:underline">Articles</a>
            <span>/</span>
            <a href={`/articles?category=${encodeURIComponent(article.data.category)}`} class="hover:underline">{article.data.category}</a>
            <span>/</span>
            <span style="color: var(--color-text-primary);">{article.data.title}</span>
          </nav>
          
          <div class="flex items-center gap-2 text-xs font-mono font-semibold uppercase tracking-wider mb-6" style="color: var(--color-text-muted);">
            <span>//</span>
            <span>{article.data.category}</span>
          </div>
          
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-medium tracking-tight leading-[1.1]" style="color: var(--color-text-primary);">
            {article.data.title}
          </h1>
        </div>
        
        <div class="text-xs font-mono font-semibold uppercase tracking-wider mt-12 lg:mt-0" style="color: var(--color-text-muted);">
          {article.data.date}
        </div>
      </div>
      
      <div class="w-full h-full min-h-[300px] lg:min-h-[400px]" style="background-color: var(--color-image-bg);">
        <Image
          src={article.data.imageUrl}
          alt={article.data.imageAlt || article.data.title}
          class="w-full h-full object-cover"
          width={800}
          height={600}
          format="webp"
          quality={85}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          lqip="color"
        />
      </div>
    </div>

    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 px-6 sm:px-10 lg:px-16 py-4 border-y" style="border-color: var(--color-border);">
      <div class="flex items-center gap-4">
        <div class="flex gap-1.5">
          {article.data.authors.map((author) => (
            <img 
              src={author.avatarUrl} 
              alt={author.name} 
              class="w-9 h-9 object-cover"
              style="background-color: var(--color-image-bg);"
            />
          ))}
        </div>
        <div class="text-xs font-mono font-medium uppercase tracking-wider leading-relaxed max-w-md" style="color: var(--color-text-secondary);">
          {article.data.authors.map((a) => a.name).join(', ')}
        </div>
      </div>
      
      <div class="flex flex-wrap items-center gap-4 sm:gap-6 text-xs font-mono font-medium uppercase tracking-wider" style="color: var(--color-text-muted);">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{article.data.date}</span>
        </div>
        <ArticleInteractive client:only="react" articleTitle={article.data.title} />
        <div class="border-l pl-4" style="border-color: var(--color-border);">
          <SocialShareButtons client:only="react" articleTitle={article.data.title} articleUrl={articleUrl} />
        </div>
      </div>
    </div>

    <div class="flex flex-col md:flex-row relative border-b" style="border-color: var(--color-border);">
      <div class="hidden md:block w-64 lg:w-72 shrink-0 border-r py-8 sm:py-12 lg:py-16 pl-6 sm:pl-10 lg:pl-16 pr-8 lg:pr-12" style="border-color: var(--color-border);">
        <div class="sticky top-24">
          <AnimatedToc items={TOC_ITEMS} client:idle />
        </div>
      </div>

      <div id="article-content" class="grow py-8 sm:py-12 lg:py-16 px-6 sm:px-10 lg:px-16 md:pl-8 lg:pl-12 prose prose-lg max-w-none prose-headings:font-display prose-headings:font-medium prose-headings:tracking-tight prose-a:text-blue-600 hover:prose-a:text-blue-700 prose-img:rounded-none dark:prose-invert">
        <Content />
      </div>
    </div>

    <div class="border-b" style="border-color: var(--color-border);">
      <div class="px-6 sm:px-10 lg:px-16 py-12 border-b" style="border-color: var(--color-border);">
        <h2 class="text-2xl font-display font-bold tracking-tight" style="color: var(--color-text-primary);">Related Articles</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-0">
        {relatedArticles.map((relatedArticle, index) => (
          <a
            href={`/articles/${relatedArticle.id}`}
            class={`group flex flex-col h-full transition-colors ${index !== 2 ? "md:border-r" : ""} ${index !== 0 ? "border-t md:border-t-0" : ""}`}
            style="border-color: var(--color-border);"
            onmouseenter="this.style.backgroundColor='var(--color-hover)'"
            onmouseleave="this.style.backgroundColor=''"
          >
            <div class="p-6 md:p-8 grow">
              <div class="aspect-video rounded-none overflow-hidden mb-6 border" style="background-color: var(--color-image-bg); border-color: var(--color-border);">
                <Image
                  src={relatedArticle.data.imageUrl}
                  alt={relatedArticle.data.title}
                  class="w-full h-full object-cover"
                  width={400}
                  height={225}
                  format="webp"
                  quality={80}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="flex items-center gap-2 text-[11px] font-mono uppercase tracking-widest mb-3" style="color: var(--color-text-muted);">
                <span>// {relatedArticle.data.category}</span>
              </div>
              <h3 class="text-xl font-display font-bold tracking-tight mb-4" style="color: var(--color-text-primary);">
                {relatedArticle.data.title}
              </h3>
            </div>
            <div class="border-t p-4 px-6 md:p-8 flex items-center justify-between mt-auto" style="border-color: var(--color-border);">
              <div class="flex -space-x-2">
                {relatedArticle.data.authors.map((author) => (
                  <img 
                    src={author.avatarUrl} 
                    alt={author.name} 
                    class="w-6 h-6 rounded-none border"
                    style="border-color: var(--color-border);"
                    loading="lazy"
                  />
                ))}
              </div>
              <div class="text-[11px] font-mono uppercase tracking-widest" style="color: var(--color-text-muted);">
                {relatedArticle.data.date}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>

    <div class="w-full py-16 px-6 sm:px-10 lg:px-16 flex flex-col md:flex-row items-center justify-between gap-8" style="background-color: var(--color-footer-bg); color: var(--color-footer-heading);">
      <div class="md:w-1/2">
        <h3 class="text-3xl md:text-4xl font-display font-bold tracking-tight mb-4">Never miss an update</h3>
        <p class="font-mono text-xs uppercase tracking-widest" style="color: var(--color-footer-text);">Join 50,000+ developers getting our weekly tech insights.</p>
      </div>
      <div class="w-full md:w-1/2">
        <form class="flex flex-col sm:flex-row gap-0 border" style="border-color: var(--color-footer-border);">
          <input 
            type="email" 
            placeholder="YOUR EMAIL ADDRESS" 
            autocomplete="off"
            class="border-none rounded-none px-4 py-4 grow focus:outline-none focus:ring-0 text-xs font-mono uppercase tracking-widest w-full"
            style="background-color: var(--color-footer-surface); color: var(--color-footer-heading);"
          />
          <button 
            type="submit" 
            class="px-8 py-4 rounded-none font-mono text-xs font-bold uppercase tracking-widest transition-colors border-t sm:border-t-0 sm:border-l whitespace-nowrap w-full sm:w-auto"
            style="background-color: var(--color-footer-heading); color: var(--color-footer-bg); border-color: var(--color-footer-border);"
          >
            Subscribe
          </button>
        </form>
      </div>
    </div>

    <!-- Back to Top Button -->
    <button
      id="back-to-top"
      aria-label="Back to top"
      class="fixed bottom-6 right-6 w-12 h-12 flex items-center justify-center border z-50 transition-all duration-300 opacity-0 translate-y-4 pointer-events-none"
      style="border-color: var(--color-border); background: var(--color-surface); color: var(--color-text-muted);"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
      </svg>
    </button>
  </div>
</BaseLayout>

<script>
  const progressBar = document.getElementById('reading-progress') as HTMLElement | null;
  const articleContent = document.getElementById('article-content') as HTMLElement | null;
  const backToTopBtn = document.getElementById('back-to-top') as HTMLButtonElement | null;

  function updateProgress() {
    if (!progressBar || !articleContent) return;
    const wh = window.innerHeight;
    const dh = document.documentElement.scrollHeight;
    const st = window.scrollY;
    const ct = articleContent.offsetTop;
    const cb = ct + articleContent.offsetHeight;
    const sd = cb - ct - wh;
    let p = 0;
    if (sd > 0) { p = (st - ct + wh / 2) / dh; }
    p = Math.max(0, Math.min(1, p));
    progressBar.style.width = (p * 100).toFixed(2) + '%';
  }

  function updateBackToTop() {
    if (!backToTopBtn) return;
    if (window.scrollY > 500) {
      backToTopBtn.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
    } else {
      backToTopBtn.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
    }
  }

  backToTopBtn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  window.addEventListener('scroll', () => {
    requestAnimationFrame(() => {
      updateProgress();
      updateBackToTop();
    });
  });

  updateProgress();
  updateBackToTop();
</script>
