---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import ArticleInteractive from '../../components/react/ArticleInteractive';
import AnimatedToc from '../../components/AnimatedToc.astro';
import GiscusComments from '../../components/GiscusComments.astro';
import ReadingProgressBar from '../../components/react/ReadingProgressBar';
import BackToTop from '../../components/react/BackToTop';
import { Schema } from 'astro-seo-schema';
import type { ImageMetadata } from 'astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);

const allArticles = await getCollection('articles');
const allAuthors = await getCollection('authors');
const authorMap = new Map(allAuthors.map(a => [a.id, a.data]));

const resolvedAuthors = article.data.authors.map((slug: string) => {
  const author = authorMap.get(slug);
  return author
    ? { name: author.name, avatarUrl: author.avatarUrl, slug }
    : { name: slug, avatarUrl: '', slug };
});

const relatedArticles = (() => {
  const currentTags = article.data.tags || [];
  const currentCategory = article.data.category;

  const articles = allArticles
    .filter((a) => a.id !== article.id)
    .map((a) => {
      const articleTags = a.data.tags || [];

      let score = 0;

      if (currentTags.length > 0 && articleTags.length > 0) {
        const commonTags = currentTags.filter((tag: string) => articleTags.includes(tag));
        score += commonTags.length * 10;
      }

      if (a.data.category === currentCategory) {
        score += 5;
      }

      const daysSincePublished = (Date.now() - a.data.publishedAt.getTime()) / (1000 * 60 * 60 * 24);
      score += Math.max(0, 10 - daysSincePublished * 0.1);

      return {
        article: a,
        score
      };
    })
    .sort((a, b) => b.score - a.score)
    .slice(0, 3)
    .map((item) => item.article);

  return articles;
})();

const TOC_ITEMS = headings.map((h) => ({
  id: h.slug,
  title: h.text,
}));

// article.data.imageUrl is typed as string in JSON schema but resolves to ImageMetadata at runtime
const imageUrlMeta = article.data.imageUrl as unknown as ImageMetadata | undefined;
const ogImage = imageUrlMeta?.src
  ? new URL(imageUrlMeta.src, Astro.site).toString()
  : 'https://jaainil.com/og.jpg';

const fmtDate = (d: Date) =>
  new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }).format(d);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://jaainil.com',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Articles',
      item: 'https://jaainil.com/articles',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: article.data.title,
      item: `https://jaainil.com/articles/${article.id}`,
    },
  ],
};
---

<BaseLayout
  title={`${article.data.title} — Jainil Prajapati`}
  description={article.data.description}
  image={ogImage}
  articleData={article.data}
  resolvedAuthors={resolvedAuthors}
>
  <Fragment slot="head">
    <Schema item={breadcrumbSchema as any} />
  </Fragment>
  <ReadingProgressBar client:only="react" />
  <BackToTop client:only="react" />

  <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-8 sm:pt-12 pb-16">
    <div class="rounded-2xl overflow-hidden" style="background: var(--paper); border: 2px solid var(--keyline); box-shadow: 0 4px 0 var(--keyline);">

      <!-- Sheet header -->
      <div class="p-6 sm:p-10 lg:p-12 pb-0">
        <div class="flex flex-wrap items-center gap-3 mb-5">
          <span class="px-2.5 py-1 rounded-md text-[11px] font-black uppercase tracking-wide" style="border: 2px solid var(--keyline); background: var(--marker); color: #10151b;">
            {article.data.category}
          </span>
          <span class="text-sm font-bold" style="color: var(--color-text-muted);">{fmtDate(article.data.publishedAt)}</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight leading-[1.08] max-w-4xl" style="color: var(--ink);">
          {article.data.title}
        </h1>

        {article.data.imageUrl && (
          <div class="mt-8 rounded-xl overflow-hidden" style="border: 2px solid var(--keyline); background-color: var(--color-image-bg);">
            <Image
              src={article.data.imageUrl}
              alt={article.data.imageAlt || article.data.title}
              class="w-full object-cover"
              width={800}
              height={600}
              format="webp"
              quality={85}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        )}

        <!-- Author strip -->
        <div class="mt-8 pt-6 flex flex-wrap items-center justify-between gap-4" style="border-top: 2px dashed var(--color-border-soft);">
          <div class="flex items-center gap-3">
            <div class="flex gap-1.5">
              {resolvedAuthors.map((author) => (
                <img
                  src={author.avatarUrl}
                  alt={author.name}
                  class="w-9 h-9 rounded-lg object-cover"
                  style="border: 2px solid var(--keyline); background-color: var(--color-image-bg);"
                  loading="lazy"
                  decoding="async"
                  width="36"
                  height="36"
                />
              ))}
            </div>
            <p class="text-sm font-semibold" style="color: var(--color-text-secondary);">
              By
              {resolvedAuthors.map((a, i) => (
                <>
                  {i > 0 && ','}{' '}
                  <a href="/about" class="font-bold underline underline-offset-4" style="color: var(--ink);">{a.name}</a>
                </>
              ))}
            </p>
          </div>
          <ArticleInteractive client:only="react" articleTitle={article.data.title} />
        </div>
      </div>

      <!-- Body -->
      <div class="py-10 lg:py-12 px-6 sm:px-10 lg:px-12">
        <div class="max-w-[72ch] mx-auto">
          <div class="prose prose-lg max-w-none prose-headings:font-black prose-headings:tracking-tight prose-img:rounded-xl prose-img:border-2" style="border-color: var(--keyline);">
            <Content />
          </div>
        </div>
      </div>

      <AnimatedToc items={TOC_ITEMS} />
    </div>

    <GiscusComments />

    <!-- Related notes -->
    <div class="mt-12">
      <h2 class="text-2xl sm:text-3xl font-black tracking-tight mb-6" style="color: var(--ink);">More notes</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {relatedArticles.map((relatedArticle) => (
          <a
            href={`/articles/${relatedArticle.id}`}
            class="group flex flex-col h-full rounded-2xl overflow-hidden transition-transform hover:-translate-y-1"
            style="background: var(--paper); border: 2px solid var(--keyline); box-shadow: 0 4px 0 var(--keyline);"
          >
            {relatedArticle.data.imageUrl && (
              <div class="aspect-video overflow-hidden" style="border-bottom: 2px solid var(--keyline); background-color: var(--color-image-bg);">
                <Image
                  src={relatedArticle.data.imageUrl}
                  alt={relatedArticle.data.title}
                  class="w-full h-full object-cover"
                  width={400}
                  height={225}
                  format="webp"
                  quality={80}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
            <div class="p-6 grow">
              <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-black uppercase tracking-wide mb-3" style="border: 2px solid var(--keyline); background: var(--marker); color: #10151b;">
                {relatedArticle.data.category}
              </span>
              <h3 class="text-lg font-extrabold tracking-tight leading-snug group-hover:underline underline-offset-4 decoration-2" style="color: var(--ink);">
                {relatedArticle.data.title}
              </h3>
            </div>
            <div class="border-t-2 px-6 py-3.5 flex items-center justify-between mt-auto" style="border-color: var(--keyline);">
              <div class="flex -space-x-2">
                {(() => {
                  const authorSlugs = relatedArticle.data.authors;
                  const authorData = authorSlugs.map((slug: string) => {
                    const author = authorMap.get(slug);
                    return author ? { name: author.name, avatarUrl: author.avatarUrl } : { name: slug, avatarUrl: '' };
                  });
                  return authorData.map((author) => (
                    <img
                      src={author.avatarUrl}
                      alt={author.name}
                      class="w-6 h-6 rounded-md object-cover"
                      style="border: 2px solid var(--keyline);"
                      loading="lazy"
                      decoding="async"
                      width="24"
                      height="24"
                    />
                  ));
                })()}
              </div>
              <span class="text-xs font-bold" style="color: var(--color-text-muted);">
                {fmtDate(relatedArticle.data.publishedAt)}
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* ponytail: scrollable tables instead of layout shift on mobile */
  .prose table { display: block; max-width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .prose thead, .prose tbody, .prose tr { display: table; width: 100%; }
  .prose a { color: var(--color-link); text-decoration-thickness: 2px; text-underline-offset: 3px; }
</style>
