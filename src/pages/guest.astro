---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Schema } from 'astro-seo-schema';

const SITE_URL = 'https://shravonix.com';
const pageUrl = `${SITE_URL}/guest`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Write for Us', item: pageUrl },
  ],
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${pageUrl}#webpage`,
  name: 'Write for Us — Shravonix',
  description: 'Contribute a guest post to Shravonix. Share your technical expertise with thousands of developers by writing about AI, Linux, IoT, or software engineering.',
  url: pageUrl,
  inLanguage: 'en',
  isPartOf: { '@id': `${SITE_URL}/#website` },
};
---

<BaseLayout
  title="Write for Us — Shravonix"
  description="Contribute a guest post to Shravonix. Share your technical expertise with thousands of developers by writing about AI, Linux, IoT, or software engineering."
>
  <Fragment slot="head">
    <Schema item={breadcrumbSchema as any} />
    <Schema item={webPageSchema as any} />
  </Fragment>
  <div class="w-full pb-16">
    
    <!-- Page heading -->
    <div class="border-b px-6 md:px-8 py-8" style="border-color: var(--color-border);">
      <p class="text-[11px] font-mono uppercase tracking-widest mb-2" style="color: var(--color-text-muted);">// Contribute</p>
      <h1 class="text-4xl md:text-5xl font-display font-bold tracking-tight" style="color: var(--color-text-primary);">
        Write for Shravonix
      </h1>
    </div>

    <!-- Intro Section -->
    <section class="border-b px-6 md:px-8 py-16" style="border-color: var(--color-border);">
      <div class="max-w-3xl">
        <h2 class="text-sm font-mono font-bold uppercase tracking-widest mb-6" style="color: var(--color-text-primary);">
          // Why Write For Us
        </h2>
        <p class="text-lg font-sans leading-relaxed mb-6" style="color: var(--color-text-secondary);">
          Shravonix welcomes contributions from the tech community. Whether you're a seasoned developer, researcher, or tech enthusiast, we want to hear your story.
        </p>
        <p class="text-lg font-sans leading-relaxed" style="color: var(--color-text-secondary);">
          We focus on <strong>technical depth</strong> — articles that go beyond surface-level reporting to explore how technology actually works.
        </p>
      </div>
    </section>

    <!-- What We Look For -->
    <section class="border-b px-6 md:px-8 py-16" style="border-color: var(--color-border);">
      <div class="max-w-3xl">
        <h2 class="text-sm font-mono font-bold uppercase tracking-widest mb-6" style="color: var(--color-text-primary);">
          // What We're Looking For
        </h2>
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <span class="text-xs font-mono uppercase tracking-widest mt-1 shrink-0" style="color: var(--color-accent-text);">01</span>
            <div>
              <h3 class="text-base font-display font-bold mb-2" style="color: var(--color-text-primary);">Technical Deep Dives</h3>
              <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Articles that explain how technology works under the hood — kernel internals, system architecture, algorithms, etc.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <span class="text-xs font-mono uppercase tracking-widest mt-1 shrink-0" style="color: var(--color-accent-text);">02</span>
            <div>
              <h3 class="text-base font-display font-bold mb-2" style="color: var(--color-text-primary);">Industry Analysis</h3>
              <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Thoughtful commentary on tech trends, company strategies, and market movements.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <span class="text-xs font-mono uppercase tracking-widest mt-1 shrink-0" style="color: var(--color-accent-text);">03</span>
            <div>
              <h3 class="text-base font-display font-bold mb-2" style="color: var(--color-text-primary);">Tutorials & Guides</h3>
              <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Practical how-to guides that help readers build real things or solve specific problems.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <span class="text-xs font-mono uppercase tracking-widest mt-1 shrink-0" style="color: var(--color-accent-text);">04</span>
            <div>
              <h3 class="text-base font-display font-bold mb-2" style="color: var(--color-text-primary);">Opinions & Commentary</h3>
              <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Thought-provoking perspectives on technology's impact on society and industry.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Categories -->
    <section class="border-b px-6 md:px-8 py-16" style="border-color: var(--color-border);">
      <div class="max-w-3xl">
        <h2 class="text-sm font-mono font-bold uppercase tracking-widest mb-6" style="color: var(--color-text-primary);">
          // Categories
        </h2>
        <div class="flex flex-wrap gap-3">
          {['Linux', 'Tech', 'AI', 'IoT', 'Opinions'].map((cat) => (
            <span 
              class="px-4 py-2 text-xs font-mono uppercase tracking-widest border"
              style="border-color: var(--color-border); color: var(--color-text-secondary);"
            >
              {cat}
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section class="border-b px-6 md:px-8 py-16" style="border-color: var(--color-border);">
      <div class="max-w-3xl">
        <h2 class="text-sm font-mono font-bold uppercase tracking-widest mb-6" style="color: var(--color-text-primary);">
          // How It Works
        </h2>
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <span class="text-xs font-mono uppercase tracking-widest mt-1 shrink-0" style="color: var(--color-accent-text);">01</span>
            <div>
              <h3 class="text-base font-display font-bold mb-2" style="color: var(--color-text-primary);">Submit Your Idea</h3>
              <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Open a GitHub issue with your article proposal. We'll review it and get back to you within 48 hours.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <span class="text-xs font-mono uppercase tracking-widest mt-1 shrink-0" style="color: var(--color-accent-text);">02</span>
            <div>
              <h3 class="text-base font-display font-bold mb-2" style="color: var(--color-text-primary);">Write Your Article</h3>
              <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Once approved, write your article in MDX format. We provide templates and guidelines to help you get started.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <span class="text-xs font-mono uppercase tracking-widest mt-1 shrink-0" style="color: var(--color-accent-text);">03</span>
            <div>
              <h3 class="text-base font-display font-bold mb-2" style="color: var(--color-text-primary);">Review & Publish</h3>
              <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Our editorial team reviews your article for clarity and technical accuracy. Once finalized, we publish and promote it.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="px-6 md:px-8 py-16" style="border-color: var(--color-border);">
      <div class="max-w-3xl">
        <h2 class="text-sm font-mono font-bold uppercase tracking-widest mb-6" style="color: var(--color-text-primary);">
          // Ready to Contribute
        </h2>
        <p class="text-base font-sans leading-relaxed mb-8" style="color: var(--color-text-secondary);">
          Have an idea? We'd love to hear it. Submit your article proposal via GitHub Issues and we'll get back to you soon.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="https://github.com/jaainil/shravonix-com/issues/new?template=GUEST_POST.md"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 border text-xs font-mono uppercase tracking-widest transition-colors"
            style="border-color: var(--color-text-primary); color: var(--color-text-primary);"
            onmouseenter="this.style.backgroundColor='var(--color-text-primary)';this.style.color='var(--color-surface)'"
            onmouseleave="this.style.backgroundColor='';this.style.color='var(--color-text-primary)'"
          >
            Submit Article
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
          <a
            href="/authors"
            class="inline-flex items-center gap-2 px-6 py-3 border text-xs font-mono uppercase tracking-widest transition-colors"
            style="border-color: var(--color-border); color: var(--color-text-secondary);"
            onmouseenter="this.style.backgroundColor='var(--color-hover)';this.style.color='var(--color-text-primary)'"
            onmouseleave="this.style.backgroundColor='';this.style.color='var(--color-text-secondary)'"
          >
            View All Authors
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>
