---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { marked } from 'marked';
import fs from 'node:fs';
import path from 'node:path';

const filePath = path.join(process.cwd(), 'public/policies/terms-of-service.md');
const markdown = fs.readFileSync(filePath, 'utf-8');
const content = marked.parse(markdown);
---

<BaseLayout title="Terms of Service — Jainil Prajapati" description="Terms of service for jaainil.com.">
  <div class="w-full">
    <div class="border-b px-6 md:px-8 py-8" style="border-color: var(--color-border);">
      <p class="text-[11px] font-mono uppercase tracking-widest mb-2" style="color: var(--color-text-muted);">// Legal</p>
      <h1 class="text-4xl md:text-5xl font-display font-bold tracking-tight" style="color: var(--color-text-primary);">
        Terms of Service
      </h1>
      <p class="mt-4 text-sm" style="color: var(--color-text-muted);">
        Last updated: January 1, 2026
      </p>
    </div>

    <div class="px-6 md:px-8 py-12 max-w-3xl mx-auto">
      <div class="prose prose-stone dark:prose-invert max-w-none" set:html={content} />
    </div>
  </div>
</BaseLayout>
