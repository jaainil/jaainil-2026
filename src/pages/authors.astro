---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Schema } from 'astro-seo-schema';

const authors = await getCollection('authors');

const SITE_URL = 'https://shravonix.com';
const pageUrl = `${SITE_URL}/authors`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Authors', item: pageUrl },
  ],
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#webpage`,
  name: 'Authors & Contributors — Jainil Prajapati',
  description: 'Writers and contributors behind technical articles and engineering deep dives.',
  url: pageUrl,
  inLanguage: 'en',
  isPartOf: { '@id': `${SITE_URL}/#website` },
};
---

<BaseLayout
  title="Authors & Contributors — Jainil Prajapati"
  description="Writers and contributors behind technical articles and engineering deep dives."
>
  <Fragment slot="head">
    <Schema item={breadcrumbSchema as any} />
    <Schema item={webPageSchema as any} />
  </Fragment>
  <div class="w-full pb-16">
    
    <!-- Page heading -->
    <div class="border-b px-6 md:px-8 py-8" style="border-color: var(--color-border);">
      <p class="text-[11px] font-mono uppercase tracking-widest mb-2" style="color: var(--color-text-muted);">// Team</p>
      <h1 class="text-4xl md:text-5xl font-display font-bold tracking-tight" style="color: var(--color-text-primary);">
        Our Authors
      </h1>
    </div>

    <!-- Authors Grid -->
    <div class="border-b px-6 md:px-8 py-16" style="border-color: var(--color-border);">
      {authors.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {authors.map((author) => (
            <div class="border p-6 transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)'" onmouseleave="this.style.backgroundColor=''">
              <div class="flex items-center gap-4 mb-4">
                <img
                  src={author.data.avatarUrl}
                  alt={author.data.name}
                  class="w-12 h-12 border"
                  style="border-color: var(--color-border);"
                  loading="lazy"
                  decoding="async"
                  width="48"
                  height="48"
                />
                <div>
                  <h3 class="text-base font-display font-bold" style="color: var(--color-text-primary);">
                    {author.data.name}
                  </h3>
                  {author.data.role && (
                    <p class="text-xs font-mono uppercase tracking-widest" style="color: var(--color-text-muted);">
                      {author.data.role}
                    </p>
                  )}
                </div>
              </div>
              {author.data.bio && (
                <p class="text-sm font-sans mb-4" style="color: var(--color-text-secondary);">
                  {author.data.bio}
                </p>
              )}
              {author.data.social && (
                <div class="flex flex-wrap gap-4">
                  {author.data.social.github && (
                    <a
                      href={`https://github.com/${author.data.social.github}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="transition-colors"
                      style="color: var(--color-text-muted);"
                      onmouseenter="this.style.color='var(--color-text-primary)'"
                      onmouseleave="this.style.color='var(--color-text-muted)'"
                    >
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                      </svg>
                    </a>
                  )}
                  {author.data.social.linkedin && (
                    <a
                      href={`https://www.linkedin.com/in/${author.data.social.linkedin}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="transition-colors"
                      style="color: var(--color-text-muted);"
                      onmouseenter="this.style.color='var(--color-text-primary)'"
                      onmouseleave="this.style.color='var(--color-text-muted)'"
                    >
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                      </svg>
                    </a>
                  )}
                  {author.data.social.twitter && (
                    <a
                      href={`https://twitter.com/${author.data.social.twitter}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="transition-colors"
                      style="color: var(--color-text-muted);"
                      onmouseenter="this.style.color='var(--color-text-primary)'"
                      onmouseleave="this.style.color='var(--color-text-muted)'"
                    >
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.007 4.126H5.078z"/>
                      </svg>
                    </a>
                  )}
                </div>
              )}
            </div>
          ))}
        </div>
      ) : (
        <p class="text-sm font-sans" style="color: var(--color-text-secondary);">No authors yet.</p>
      )}
    </div>

    <!-- CTA -->
    <section class="px-6 md:px-8 py-16">
      <div class="max-w-3xl">
        <h2 class="text-sm font-mono font-bold uppercase tracking-widest mb-6" style="color: var(--color-text-primary);">
          // Want to Write for Us?
        </h2>
        <p class="text-base font-sans leading-relaxed mb-8" style="color: var(--color-text-secondary);">
          We're always looking for new voices in tech. If you're passionate about technology and have something valuable to share, we'd love to hear from you.
        </p>
        <a
          href="/guest"
          class="inline-flex items-center gap-2 px-6 py-3 border text-xs font-mono uppercase tracking-widest transition-colors"
          style="border-color: var(--color-text-primary); color: var(--color-text-primary);"
          onmouseenter="this.style.backgroundColor='var(--color-text-primary)';this.style.color='var(--color-surface)'"
          onmouseleave="this.style.backgroundColor='';this.style.color='var(--color-text-primary)'"
        >
          Learn More
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </section>

  </div>
</BaseLayout>
