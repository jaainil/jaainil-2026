---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const allArticles = await getCollection('articles');
const allAuthors = await getCollection('authors');
const authorMap = new Map(allAuthors.map(a => [a.id, a.data]));

const featuredArticles = allArticles
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 6)
  .map(a => ({
    ...a,
    data: {
      ...a.data,
      authors: a.data.authors.map((slug: string) => {
        const author = authorMap.get(slug);
        return author ? { name: author.name, avatarUrl: author.avatarUrl } : { name: slug, avatarUrl: '' };
      })
    }
  }));
---

<BaseLayout title="404 — Page Not Found" description="The page you're looking for doesn't exist.">
  <div class="w-full pb-16">
    
    <!-- 404 Header -->
    <div class="border-b px-6 md:px-8 py-16" style="border-color: var(--color-border);">
      <div class="flex items-center gap-4 mb-8">
        <span class="text-[11px] font-mono uppercase tracking-widest" style="color: var(--color-text-muted);">
          // Error 404
        </span>
        <span class="text-[11px] font-mono uppercase tracking-widest px-3 py-1" style="background-color: var(--color-accent-bg); color: var(--color-accent-text);">
          Not Found
        </span>
      </div>
      <h1 class="text-6xl md:text-8xl font-display font-bold tracking-tight mb-8" style="color: var(--color-text-primary);">
        Oops!
      </h1>
      <p class="text-xl md:text-2xl max-w-2xl" style="color: var(--color-text-secondary);">
        The page you're looking for doesn't exist or has been moved. Let's get you back on track.
      </p>
    </div>

    <!-- Action Buttons -->
    <div class="border-b px-6 md:px-8 py-12" style="border-color: var(--color-border);">
      <div class="flex flex-col sm:flex-row gap-6">
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 border text-sm font-mono uppercase tracking-widest transition-colors text-center"
          style="border-color: var(--color-text-primary); color: var(--color-text-primary); background-color: var(--color-accent-bg); color: var(--color-accent-text);"
          onmouseenter="this.style.backgroundColor='var(--color-text-primary)';this.style.color='var(--color-surface)'"
          onmouseleave="this.style.backgroundColor='var(--color-accent-bg)';this.style.color='var(--color-accent-text)'"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Go Home
        </a>
        <a
          href="/articles"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 border text-sm font-mono uppercase tracking-widest transition-colors text-center"
          style="border-color: var(--color-border); color: var(--color-text-primary);"
          onmouseenter="this.style.backgroundColor='var(--color-hover)'"
          onmouseleave="this.style.backgroundColor=''"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
          Browse Articles
        </a>
      </div>
    </div>

    <!-- Suggested Articles -->
    <div class="px-6 md:px-8 py-16">
      <h2 class="text-2xl font-display font-bold tracking-tight mb-8" style="color: var(--color-text-primary);">
        Latest Articles
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-0">
        {featuredArticles.map((article, index) => (
          <a
            href={`/articles/${article.id}`}
            class={`group flex flex-col h-full border-b transition-colors ${index % 2 === 0 ? "md:border-r" : "md:border-r-0"} ${(index + 1) % 3 !== 0 ? "lg:border-r" : "lg:border-r-0"}`}
            style="border-color: var(--color-border);"
            onmouseenter="this.style.backgroundColor='var(--color-hover)'"
            onmouseleave="this.style.backgroundColor=''"
          >
            <div class="p-6 md:p-8 grow">
              <div class="aspect-video rounded-none overflow-hidden mb-6 border" style="background-color: var(--color-image-bg); border-color: var(--color-border);">
                <Image
                  src={article.data.imageUrl}
                  alt={article.data.title}
                  class="w-full h-full object-cover"
                  width={400}
                  height={225}
                  format="webp"
                  quality={80}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="flex items-center gap-2 text-[11px] font-mono uppercase tracking-widest mb-3" style="color: var(--color-text-muted);">
                <span>// {article.data.category}</span>
              </div>
              <h3 class="text-xl font-display font-bold tracking-tight mb-4" style="color: var(--color-text-primary);">
                {article.data.title}
              </h3>
              {article.data.description && (
                <p class="text-sm font-sans leading-relaxed line-clamp-2" style="color: var(--color-text-secondary);">
                  {article.data.description}
                </p>
              )}
            </div>
            <div class="border-t p-4 px-6 md:p-8 flex items-center justify-between mt-auto" style="border-color: var(--color-border);">
              <div class="flex -space-x-2">
                {article.data.authors.map((author) => (
                  <img
                    src={author.avatarUrl}
                    alt={author.name}
                    class="w-6 h-6 rounded-none border"
                    style="border-color: var(--color-border);"
                    loading="lazy"
                    decoding="async"
                    width="24"
                    height="24"
                  />
                ))}
              </div>
              <div class="text-[11px] font-mono uppercase tracking-widest" style="color: var(--color-text-muted);">
                {article.data.publishedAt.toISOString().split('T')[0]}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Search Box -->
    <div class="border-t px-6 md:px-8 py-16" style="border-color: var(--color-border);">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-2xl font-display font-bold tracking-tight mb-6" style="color: var(--color-text-primary);">
          Still looking?
        </h2>
        <p class="text-lg mb-8" style="color: var(--color-text-secondary);">
          Search for what you're trying to find
        </p>
        <div class="relative mx-auto max-w-md border" style="border-color: var(--color-border);">
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="text"
            placeholder="SEARCH..."
            class="w-full pl-12 pr-4 py-4 rounded-none border-none text-sm focus:outline-none focus:ring-0 font-mono uppercase tracking-widest"
            style="background-color: var(--color-surface); color: var(--color-text-primary);"

          />
        </div>
      </div>
    </div>

  </div>
</BaseLayout>

<script>
  const searchInput = document.querySelector<HTMLInputElement>('input[type="text"]');
  if (searchInput) {
    searchInput.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter') {
        const value = (e.currentTarget as HTMLInputElement).value.trim();
        if (value) {
          window.location.href = `/articles?q=${encodeURIComponent(value)}`;
        }
      }
    });
  }
</script>
