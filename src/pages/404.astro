---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles');
const allAuthors = await getCollection('authors');
const authorMap = new Map(allAuthors.map((a) => [a.id, a.data]));

const featuredArticles = allArticles
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);
---

<BaseLayout title="404 — Page Not Found" description="The page you're looking for doesn't exist.">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-12 sm:pt-20 pb-16">

    <div class="rounded-2xl p-8 sm:p-14 text-center mb-14" style="background: var(--paper); border: 2px solid var(--keyline); box-shadow: 0 4px 0 var(--keyline);">
      <!-- The missing piece: an empty dashed seat where the brick should be -->
      <svg viewBox="0 0 200 90" class="w-44 mx-auto mb-6" role="img" aria-label="An empty dashed outline where a brick should be">
        <polygon points="100,10 180,40 100,70 20,40" fill="rgba(229,57,53,0.10)" stroke="var(--piece)" stroke-width="3" stroke-dasharray="8 7" stroke-linejoin="round"/>
        <line x1="100" y1="88" x2="100" y2="74" stroke="var(--piece)" stroke-width="3" stroke-dasharray="5 5" stroke-linecap="round"/>
      </svg>
      <h1 class="text-5xl sm:text-7xl font-black tracking-tight mb-4" style="color: var(--ink);">404</h1>
      <p class="text-xl font-bold mb-2" style="color: var(--ink);">This piece isn't in the set.</p>
      <p class="text-base max-w-md mx-auto mb-8" style="color: var(--color-text-secondary);">
        The page you're after doesn't exist or moved. The build continues below.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl font-bold transition-transform hover:-translate-y-0.5"
          style="background: var(--action); color: #fff; border: 2px solid var(--keyline); box-shadow: 0 3px 0 var(--keyline);"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
          Back to the cover
        </a>
        <a
          href="/articles"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl font-bold transition-transform hover:-translate-y-0.5"
          style="background: var(--paper); color: var(--ink); border: 2px solid var(--keyline); box-shadow: 0 3px 0 var(--keyline);"
        >
          Field notes
        </a>
      </div>
    </div>

    <h2 class="text-2xl sm:text-3xl font-black tracking-tight mb-6" style="color: var(--ink);">Latest notes</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {featuredArticles.map((article) => (
        <a
          href={`/articles/${article.id}`}
          class="group flex flex-col h-full rounded-2xl overflow-hidden transition-transform hover:-translate-y-1"
          style="background: var(--paper); border: 2px solid var(--keyline); box-shadow: 0 4px 0 var(--keyline);"
        >
          {article.data.imageUrl && (
            <div class="aspect-video overflow-hidden" style="border-bottom: 2px solid var(--keyline); background-color: var(--color-image-bg);">
              <img
                src={article.data.imageUrl.src}
                alt={article.data.title}
                class="w-full h-full object-cover"
                loading="lazy"
                decoding="async"
                width="400"
                height="225"
              />
            </div>
          )}
          <div class="p-6 grow">
            <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-black uppercase tracking-wide mb-3" style="border: 2px solid var(--keyline); background: var(--marker); color: #10151b;">
              {article.data.category}
            </span>
            <h3 class="text-lg font-extrabold tracking-tight leading-snug group-hover:underline underline-offset-4 decoration-2" style="color: var(--ink);">
              {article.data.title}
            </h3>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-12 max-w-md mx-auto">
      <label class="sr-only" for="search-input">Search articles</label>
      <div class="relative">
        <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 pointer-events-none" style="color: var(--color-text-muted);" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          id="search-input"
          type="text"
          placeholder="Search the notes..."
          class="w-full pl-10 pr-4 py-3.5 rounded-xl text-sm font-semibold outline-none"
          style="background-color: var(--paper); color: var(--color-text-primary); border: 2px solid var(--keyline); box-shadow: 0 2px 0 var(--keyline);"
        />
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const searchInput = document.getElementById('search-input');
  if (searchInput) {
    searchInput.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter') {
        const value = (e.currentTarget as HTMLInputElement).value.trim();
        if (value) {
          window.location.href = `/articles?q=${encodeURIComponent(value)}`;
        }
      }
    });
  }
</script>
