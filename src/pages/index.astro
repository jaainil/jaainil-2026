---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { Article } from '../types';

const allArticles = await getCollection('articles');
const articles: Article[] = allArticles.map((a) => {
  const { imageUrl, ...rest } = a.data;
  return {
    id: a.id,
    ...rest,
    imageUrl: `/articles/${a.id}/${imageUrl}`,
  };
}).sort((a: Article, b: Article) =>
  new Date(b.date).getTime() - new Date(a.date).getTime()
);

const featuredArticle = articles[0];
const secondaryFeatured = articles.slice(1, 3);
const gridArticles = articles.slice(3);

const CATEGORIES = ['All', 'AI & ML', 'Web Dev', 'Hardware', 'Industry'];
---

<BaseLayout title="TechPulse - Tech News & Blog">
  <div class="w-full pb-16">
    <div class="border-b border-zinc-200 grid grid-cols-1 lg:grid-cols-3 mb-16">
      <div class="lg:col-span-2 border-b lg:border-b-0 lg:border-r border-zinc-200 flex flex-col group cursor-pointer hover:bg-zinc-50 transition-colors">
        <a href={`/articles/${featuredArticle.id}`} class="flex flex-col h-full">
          <div class="p-6 md:p-8 grow">
            <div class="rounded-none overflow-hidden mb-8 aspect-video bg-zinc-100 relative border border-zinc-200">
              <img 
                src={featuredArticle.imageUrl} 
                alt={featuredArticle.title}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <div class="flex items-center gap-2 text-[11px] font-mono text-zinc-500 uppercase tracking-widest mb-4">
              <span>// {featuredArticle.category}</span>
            </div>
            <h1 class="text-3xl md:text-5xl font-display font-bold tracking-tight text-zinc-900 mb-6">
              {featuredArticle.title}
            </h1>
          </div>
          <div class="border-t border-zinc-200 p-4 px-6 md:px-8 flex items-center gap-4 text-xs font-mono text-zinc-500">
            <div class="flex -space-x-2">
              {featuredArticle.authors.map((author: { name: string; avatarUrl: string }) => (
                <img 
                  src={author.avatarUrl} 
                  alt={author.name} 
                  class="w-8 h-8 rounded-none border border-zinc-200"
                  loading="lazy"
                />
              ))}
            </div>
            <span class="text-zinc-900 font-medium">
              {featuredArticle.authors.map((a: { name: string }) => a.name).join(', ')}
            </span>
            <span class="ml-auto uppercase tracking-widest">{featuredArticle.date}</span>
          </div>
        </a>
      </div>
      
      <div class="flex flex-col">
        {secondaryFeatured.map((article: Article, index: number) => (
          <a href={`/articles/${article.id}`} class={`group flex flex-col flex-1 hover:bg-zinc-50 transition-colors ${index === 0 ? "border-b border-zinc-200" : ""}`}>
            <div class="p-6 md:p-8 grow">
              <div class="rounded-none overflow-hidden mb-6 aspect-video bg-zinc-100 relative border border-zinc-200">
                <img 
                  src={article.imageUrl} 
                  alt={article.title}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
              <div class="flex items-center gap-2 text-[11px] font-mono text-zinc-500 uppercase tracking-widest mb-3">
                <span>// {article.category}</span>
              </div>
              <h3 class="text-xl font-display font-bold tracking-tight text-zinc-900 mb-4">
                {article.title}
              </h3>
              <div class="mt-auto pt-4 text-[11px] font-mono text-zinc-500 uppercase tracking-widest">
                {article.date}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>

    <div class="px-6 md:px-8">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
        <div class="flex items-center gap-0 overflow-x-auto w-full md:w-auto hide-scrollbar border border-zinc-200">
          {CATEGORIES.map((category: string, index: number) => (
            <a
              href={category === 'All' ? '/' : `/?category=${encodeURIComponent(category)}`}
              class={`px-6 py-3 text-xs font-mono uppercase tracking-widest whitespace-nowrap transition-colors ${index !== 0 ? "border-l border-zinc-200" : ""} ${category === 'All' ? "bg-zinc-900 text-white" : "bg-white text-zinc-600 hover:bg-zinc-50"}`}
            >
              {category}
            </a>
          ))}
        </div>
        
        <div class="relative w-full md:w-64 border border-zinc-200">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input 
            type="text" 
            placeholder="SEARCH ARTICLES..." 
            class="w-full pl-10 pr-4 py-3 rounded-none bg-white border-none focus:ring-0 text-xs font-mono uppercase tracking-widest placeholder:text-zinc-400 outline-none"
          />
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-0 border-t border-zinc-200">
      {gridArticles.map((article: Article, index: number) => (
        <a href={`/articles/${article.id}`} class={`group flex flex-col h-full border-b border-zinc-200 hover:bg-zinc-50 transition-colors ${index % 2 === 0 ? "md:border-r" : "md:border-r-0"} ${(index + 1) % 3 !== 0 ? "lg:border-r" : "lg:border-r-0"}`}>
          <div class="p-6 md:p-8 grow">
            <div class="aspect-video rounded-none overflow-hidden bg-zinc-100 mb-6 border border-zinc-200">
              <img 
                src={article.imageUrl} 
                alt={article.title}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <div class="flex items-center gap-2 text-[11px] font-mono text-zinc-500 uppercase tracking-widest mb-3">
              <span>// {article.category}</span>
            </div>
            <h3 class="text-xl font-display font-bold tracking-tight text-zinc-900 mb-4">
              {article.title}
            </h3>
          </div>
          <div class="border-t border-zinc-200 p-4 px-6 md:px-8 flex items-center justify-between mt-auto">
            <div class="flex -space-x-2">
              {article.authors.map((author: { name: string; avatarUrl: string }) => (
                <img 
                  src={author.avatarUrl} 
                  alt={author.name} 
                  class="w-6 h-6 rounded-none border border-zinc-200"
                  loading="lazy"
                />
              ))}
            </div>
            <div class="text-[11px] font-mono text-zinc-500 uppercase tracking-widest">
              {article.date}
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="flex justify-center items-center gap-0 mt-16 text-sm font-mono border border-zinc-200 w-fit mx-auto">
      <button class="p-3 text-zinc-400 hover:text-zinc-900 transition-colors border-r border-zinc-200 hover:bg-zinc-50" disabled>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <a href="#" class="w-10 h-10 flex items-center justify-center rounded-none bg-zinc-900 text-white border-r border-zinc-200">1</a>
      <a href="#" class="w-10 h-10 flex items-center justify-center rounded-none text-zinc-500 hover:bg-zinc-50 transition-colors border-r border-zinc-200">2</a>
      <a href="#" class="w-10 h-10 flex items-center justify-center rounded-none text-zinc-500 hover:bg-zinc-50 transition-colors border-r border-zinc-200">3</a>
      <a href="#" class="p-3 text-zinc-400 hover:text-zinc-900 transition-colors hover:bg-zinc-50">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</BaseLayout>