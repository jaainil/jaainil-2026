---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro-lqip/components';
import type { Article } from '../types';

const allArticles = await getCollection('articles');
const articles: Article[] = allArticles.map((a) => {
  const { imageUrl, date, ...rest } = a.data;
  return {
    id: a.id,
    ...rest,
    imageUrl,
    date: date.toISOString().split('T')[0],
  } as Article;
}).sort((a: Article, b: Article) =>
  new Date(b.date).getTime() - new Date(a.date).getTime()
);

const featuredArticle = articles[0];
const secondaryFeatured = articles.slice(1, 3);
const gridArticles = articles.slice(3);

// Canonical categories for this news site
const SITE_CATEGORIES = ['Linux', 'Tech', 'AI', 'IoT', 'Opinions'];

// For each category, grab up to 3 matching articles — skip empty categories
const categoryArticles = SITE_CATEGORIES.map((cat) => ({
  name: cat,
  articles: articles.filter((a) => {
    const articleCategory = (a.category || '').toLowerCase().trim();
    const targetCategory = cat.toLowerCase().trim();
    return articleCategory === targetCategory;
  }).slice(0, 3),
})).filter((section) => section.articles.length > 0);
---

<BaseLayout title="Shravonix — Tech News & Deep Dives">
  <div class="w-full pb-16">

    <!-- Page heading with correct top padding -->
    <div class="border-b px-6 md:px-8 py-8" style="border-color: var(--color-border);">
      <p class="text-[11px] font-mono uppercase tracking-widest mb-2" style="color: var(--color-text-muted);">// Latest</p>
      <h1 class="text-4xl md:text-5xl font-display font-bold tracking-tight" style="color: var(--color-text-primary);">
        Tech Deep Dives
      </h1>
    </div>

    <!-- Featured Articles Hero -->
    {featuredArticle && (
      <div class="border-b grid grid-cols-1 lg:grid-cols-3" style="border-color: var(--color-border);">
        <!-- Primary featured -->
        <div class="lg:col-span-2 border-b lg:border-b-0 lg:border-r flex flex-col group cursor-pointer transition-colors" style="border-color: var(--color-border);">
          <a href={`/articles/${featuredArticle.id}`} class="flex flex-col h-full" onmouseenter="this.parentElement.style.backgroundColor='var(--color-hover)'" onmouseleave="this.parentElement.style.backgroundColor=''">
            <div class="p-6 md:p-8 grow">
              <div class="rounded-none overflow-hidden mb-8 aspect-video relative border" style="background-color: var(--color-image-bg); border-color: var(--color-border);">
                <Image
                  src={featuredArticle.imageUrl}
                  alt={featuredArticle.imageAlt ?? featuredArticle.title}
                  class="w-full h-full object-cover"
                  width={1200}
                  height={675}
                  format="webp"
                  quality={85}
                  loading="eager"
                  lqip="color"
                />
              </div>
              <div class="flex items-center gap-2 text-[11px] font-mono uppercase tracking-widest mb-4" style="color: var(--color-text-muted);">
                <span>// {featuredArticle.category}</span>
              </div>
              <h2 class="text-3xl md:text-5xl font-display font-bold tracking-tight mb-4" style="color: var(--color-text-primary);">
                {featuredArticle.title}
              </h2>
              {featuredArticle.description && (
                <p class="text-sm font-sans leading-relaxed line-clamp-3" style="color: var(--color-text-secondary);">
                  {featuredArticle.description}
                </p>
              )}
            </div>
            <div class="border-t p-4 px-6 md:px-8 flex items-center gap-4 text-xs font-mono" style="border-color: var(--color-border); color: var(--color-text-muted);">
              <div class="flex -space-x-2">
                {featuredArticle.authors.map((author: { name: string; avatarUrl: string }) => (
                  <img
                    src={author.avatarUrl}
                    alt={author.name}
                    class="w-8 h-8 rounded-none border"
                    style="border-color: var(--color-border);"
                    loading="lazy"
                  />
                ))}
              </div>
              <span class="font-medium" style="color: var(--color-text-primary);">
                {featuredArticle.authors.map((a: { name: string }) => a.name).join(', ')}
              </span>
              <span class="ml-auto uppercase tracking-widest">{featuredArticle.date}</span>
            </div>
          </a>
        </div>

        <!-- Secondary featured (2 stacked) -->
        <div class="flex flex-col">
          {secondaryFeatured.map((article: Article, index: number) => (
            <a
              href={`/articles/${article.id}`}
              class={`group flex flex-col flex-1 transition-colors ${index === 0 ? "border-b" : ""}`}
              style={`border-color: var(--color-border);`}
              onmouseenter="this.style.backgroundColor='var(--color-hover)'"
              onmouseleave="this.style.backgroundColor=''"
            >
              <div class="p-6 md:p-8 grow">
                <div class="rounded-none overflow-hidden mb-6 aspect-video relative border" style="background-color: var(--color-image-bg); border-color: var(--color-border);">
                  <Image
                    src={article.imageUrl}
                    alt={article.imageAlt ?? article.title}
                    class="w-full h-full object-cover"
                    width={600}
                    height={338}
                    format="webp"
                    quality={80}
                    loading="lazy"
                     lqip="color"
                   />
                </div>
                <div class="flex items-center gap-2 text-[11px] font-mono uppercase tracking-widest mb-3" style="color: var(--color-text-muted);">
                  <span>// {article.category}</span>
                </div>
                <h3 class="text-xl font-display font-bold tracking-tight mb-3" style="color: var(--color-text-primary);">
                  {article.title}
                </h3>
                <div class="mt-auto pt-4 text-[11px] font-mono uppercase tracking-widest" style="color: var(--color-text-muted);">
                  {article.date}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Divider: Latest → More -->
    <div class="flex items-center px-6 md:px-8 border-b" style="border-color: var(--color-border);">
      <span class="text-[10px] font-mono uppercase tracking-[0.2em] py-3 pr-6 border-r w-48 shrink-0" style="color: var(--color-text-muted); border-color: var(--color-border);">// More</span>
      <div class="flex-1 h-px" style="background: repeating-linear-gradient(90deg, var(--color-border) 0px, var(--color-border) 4px, transparent 4px, transparent 10px);"></div>
    </div>

    <!-- Category Filter Bar -->
    <div class="px-6 md:px-8 py-6 border-b" style="border-color: var(--color-border);">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div class="flex items-center gap-0 overflow-x-auto w-full md:w-auto hide-scrollbar border" style="border-color: var(--color-border);">
          {['All', ...SITE_CATEGORIES].map((category: string, index: number) => (
            <button
              data-category={category}
              class={`home-cat-btn px-6 py-3 text-xs font-mono uppercase tracking-widest whitespace-nowrap transition-colors${index !== 0 ? " border-l" : ""}`}
              style={`border-color: var(--color-border); ${index === 0 ? "background-color: var(--color-accent-bg); color: var(--color-accent-text);" : "background-color: var(--color-surface); color: var(--color-text-secondary);"}`}
            >
              {category}
            </button>
          ))}
        </div>

        <div class="relative w-full md:w-64 border" style="border-color: var(--color-border);">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4" style="color: var(--color-text-muted);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            id="home-search-input"
            type="text"
            placeholder="SEARCH ARTICLES..."
            class="w-full pl-10 pr-4 py-3 rounded-none border-none focus:ring-0 text-xs font-mono uppercase tracking-widest outline-none"
            style="background-color: var(--color-surface); color: var(--color-text-primary);"
          />
        </div>
      </div>
    </div>

    <!-- More Articles Grid (remaining after featured 3) -->
    {gridArticles.length > 0 && (
      <div id="home-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-0 border-b" style="border-color: var(--color-border);">
        {gridArticles.map((article: Article, index: number) => (
          <a
            href={`/articles/${article.id}`}
            data-category={article.category}
            data-title={article.title.toLowerCase()}
            data-description={(article.description ?? '').toLowerCase()}
            class={`home-article-card group flex flex-col h-full border-b transition-colors ${index % 2 === 0 ? "md:border-r" : "md:border-r-0"} ${(index + 1) % 3 !== 0 ? "lg:border-r" : "lg:border-r-0"}`}
            style="border-color: var(--color-border);"
            onmouseenter="this.style.backgroundColor='var(--color-hover)'"
            onmouseleave="this.style.backgroundColor=''"
          >
            <div class="p-6 md:p-8 grow">
              <div class="aspect-video rounded-none overflow-hidden mb-6 border" style="background-color: var(--color-image-bg); border-color: var(--color-border);">
                <Image
                  src={article.imageUrl}
                  alt={article.imageAlt ?? article.title}
                  class="w-full h-full object-cover"
                  width={600}
                  height={338}
                  format="webp"
                  quality={80}
                     loading="lazy"
                     lqip="color"
                   />
                </div>
                <div class="flex items-center gap-2 text-[11px] font-mono uppercase tracking-widest mb-3" style="color: var(--color-text-muted);">
                  <span>// {article.category}</span>
              </div>
              <h3 class="text-xl font-display font-bold tracking-tight mb-4" style="color: var(--color-text-primary);">
                {article.title}
              </h3>
            </div>
            <div class="border-t p-4 px-6 md:px-8 flex items-center justify-between mt-auto" style="border-color: var(--color-border);">
              <div class="flex -space-x-2">
                {article.authors.map((author: { name: string; avatarUrl: string }) => (
                  <img
                    src={author.avatarUrl}
                    alt={author.name}
                    class="w-6 h-6 rounded-none border"
                    style="border-color: var(--color-border);"
                    loading="lazy"
                  />
                ))}
              </div>
              <div class="text-[11px] font-mono uppercase tracking-widest" style="color: var(--color-text-muted);">
                {article.date}
              </div>
            </div>
          </a>
        ))}
      </div>
    )}

    <!-- Empty state for home search -->
    <div id="home-empty-state" class="hidden px-6 md:px-8 py-16 text-center border-b" style="border-color: var(--color-border);">
      <p class="text-[11px] font-mono uppercase tracking-widest" style="color: var(--color-text-muted);">No articles found.</p>
    </div>

    <!-- Divider: Grid → Category sections -->
    <div class="flex items-center px-6 md:px-8 border-b" style="border-color: var(--color-border);">
      <span class="text-[10px] font-mono uppercase tracking-[0.2em] py-3 pr-6 border-r w-48 shrink-0" style="color: var(--color-text-muted); border-color: var(--color-border);">// By Category</span>
      <div class="flex-1 h-px" style="background: repeating-linear-gradient(90deg, var(--color-border) 0px, var(--color-border) 4px, transparent 4px, transparent 10px);"></div>
    </div>

    <!-- Category Sections — dynamically rendered per category that has articles -->
    {categoryArticles.map((section) => (
      <section class="border-b" style="border-color: var(--color-border);">
        <!-- Divider-style section header -->
        <div class="flex items-center border-b" style="border-color: var(--color-border);">
          <div class="flex items-center gap-3 px-6 md:px-8 py-4 border-r shrink-0 w-48" style="border-color: var(--color-border);">
            <span class="text-[10px] font-mono uppercase tracking-[0.2em]" style="color: var(--color-text-muted);">//</span>
            <h2 class="text-[11px] font-mono font-bold uppercase tracking-[0.2em]" style="color: var(--color-text-primary);">
              {section.name}
            </h2>
          </div>
          <div class="flex-1 h-px mx-4" style="background: repeating-linear-gradient(90deg, var(--color-border) 0px, var(--color-border) 4px, transparent 4px, transparent 10px);"></div>
          <a
            href={`/articles?category=${encodeURIComponent(section.name)}`}
            class="text-[10px] font-mono uppercase tracking-[0.2em] transition-colors flex items-center gap-1 px-6 md:px-8 py-4 border-l shrink-0"
            style="border-color: var(--color-border); color: var(--color-text-muted);"
            onmouseenter="this.style.color='var(--color-text-primary)'"
            onmouseleave="this.style.color='var(--color-text-muted)'"
          >
            View All
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <!-- Articles in this category -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-0">
          {section.articles.map((article: Article, index: number) => (
            <a
              href={`/articles/${article.id}`}
              class={`group flex flex-col h-full transition-colors ${index !== section.articles.length - 1 ? "border-b md:border-b-0 md:border-r" : ""}`}
              style="border-color: var(--color-border);"
              onmouseenter="this.style.backgroundColor='var(--color-hover)'"
              onmouseleave="this.style.backgroundColor=''"
            >
              <div class="p-6 md:p-8 grow">
                <div class="aspect-video rounded-none overflow-hidden mb-6 border" style="background-color: var(--color-image-bg); border-color: var(--color-border);">
                  <Image
                    src={article.imageUrl}
                    alt={article.imageAlt ?? article.title}
                    class="w-full h-full object-cover"
                    width={600}
                    height={338}
                    format="webp"
                    quality={80}
                    loading="lazy"
                     lqip="color"
                   />
                </div>
                <div class="flex items-center gap-2 text-[11px] font-mono uppercase tracking-widest mb-3" style="color: var(--color-text-muted);">
                  <span>// {article.category}</span>
                </div>
                <h3 class="text-lg font-display font-bold tracking-tight mb-3" style="color: var(--color-text-primary);">
                  {article.title}
                </h3>
                {article.description && (
                  <p class="text-sm font-sans leading-relaxed line-clamp-2" style="color: var(--color-text-secondary);">
                    {article.description}
                  </p>
                )}
              </div>
              <div class="border-t p-4 px-6 md:px-8 flex items-center justify-between mt-auto" style="border-color: var(--color-border);">
                <div class="flex -space-x-2">
                  {article.authors.map((author: { name: string; avatarUrl: string }) => (
                    <img
                      src={author.avatarUrl}
                      alt={author.name}
                      class="w-6 h-6 rounded-none border"
                      style="border-color: var(--color-border);"
                      loading="lazy"
                    />
                  ))}
                </div>
                <div class="text-[11px] font-mono uppercase tracking-widest" style="color: var(--color-text-muted);">
                  {article.date}
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}

    <!-- View All Articles CTA -->
    <div class="px-6 md:px-8 py-10 flex justify-center border-b" style="border-color: var(--color-border);">
      <a
        href="/articles"
        class="flex items-center gap-2 px-8 py-3 border text-xs font-mono uppercase tracking-widest transition-colors"
        style="border-color: var(--color-text-primary); color: var(--color-text-primary);"
        onmouseenter="this.style.backgroundColor='var(--color-text-primary)';this.style.color='var(--color-surface)'"
        onmouseleave="this.style.backgroundColor='';this.style.color='var(--color-text-primary)'"
      >
        Browse All Articles
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

  </div>
</BaseLayout>

<script>
  const searchInput = document.getElementById('home-search-input') as HTMLInputElement;
  const grid = document.getElementById('home-grid');
  const emptyState = document.getElementById('home-empty-state');
  const cards = document.querySelectorAll<HTMLAnchorElement>('.home-article-card');
  const catBtns = document.querySelectorAll<HTMLButtonElement>('.home-cat-btn');

  let activeCategory = 'All';
  let searchQuery = '';

  function applyFilters() {
    let visible = 0;

    cards.forEach((card) => {
      const category = card.dataset.category ?? '';
      const title = card.dataset.title ?? '';
      const description = card.dataset.description ?? '';

      const matchesCategory = activeCategory === 'All' || category.toLowerCase() === activeCategory.toLowerCase();
      const matchesSearch = searchQuery === '' || title.includes(searchQuery) || description.includes(searchQuery);

      card.style.display = matchesCategory && matchesSearch ? '' : 'none';
      if (matchesCategory && matchesSearch) visible++;
    });

    if (grid && emptyState) {
      if (visible === 0) {
        grid.classList.add('hidden');
        emptyState.classList.remove('hidden');
      } else {
        grid.classList.remove('hidden');
        emptyState.classList.add('hidden');
      }
    }
  }

  function setActiveBtn(category: string) {
    catBtns.forEach((btn) => {
      const isActive = btn.dataset.category === category;
      btn.style.backgroundColor = isActive ? 'var(--color-accent-bg)' : 'var(--color-surface)';
      btn.style.color = isActive ? 'var(--color-accent-text)' : 'var(--color-text-secondary)';
    });
  }

  catBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCategory = btn.dataset.category ?? 'All';
      setActiveBtn(activeCategory);
      applyFilters();
    });
  });

  if (searchInput) {
    searchInput.addEventListener('input', () => {
      searchQuery = searchInput.value.toLowerCase().trim();
      applyFilters();
    });
  }
</script>
