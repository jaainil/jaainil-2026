---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { Article } from '../types';

const allArticles = await getCollection('articles');
const allAuthors = await getCollection('authors');
const authorMap = new Map(allAuthors.map((a) => [a.id, a.data]));

const latestArticles: Article[] = allArticles
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3)
  .map((a) => {
    const { imageUrl, publishedAt, authors, ...rest } = a.data;
    return {
      id: a.id,
      ...rest,
      imageUrl,
      publishedAt: publishedAt.toISOString().split('T')[0],
      authors: authors.map((slug: string) => {
        const author = authorMap.get(slug);
        return author ? { id: slug, name: author.name, avatarUrl: author.avatarUrl } : { id: slug, name: slug, avatarUrl: '' };
      }),
    } as Article;
  });

const totalArticlesCount = allArticles.length;

// ---- Isometric brick scene, drawn from real projection math ----
const ISO_X = 0.866;
const ISO_Y = 0.5;
const U = 38; // px per grid unit

const iso = (o: { x: number; y: number }, r: number, l: number, z = 0) =>
  `${(o.x + (r - l) * ISO_X * U).toFixed(1)},${(o.y + (r + l) * ISO_Y * U + z).toFixed(1)}`;

const face = (points: string, fill: string) =>
  `<polygon points="${points}" fill="${fill}" stroke="var(--keyline)" stroke-width="2" stroke-linejoin="round"/>`;

function brick(o: { x: number; y: number }, R: number, L: number, H: number, c: { t: string; r: string; l: string }, z = 0, cls = '') {
  const t2 = iso(o, R, 0, z), t3 = iso(o, R, L, z), t4 = iso(o, 0, L, z);
  const b2 = iso(o, R, 0, z + H), b3 = iso(o, R, L, z + H), b4 = iso(o, 0, L, z + H);
  let s = `<g${cls ? ` class="${cls}"` : ''}>`;
  s += face(`${t4} ${b4} ${b3} ${t3}`, c.l);
  s += face(`${t2} ${b2} ${b3} ${t3}`, c.r);
  s += face(`${iso(o, 0, 0, z)} ${t2} ${t3} ${t4}`, c.t);
  const rs = 10, hs = 7;
  for (let i = 0; i < 2; i++) {
    for (let j = 0; j < 2; j++) {
      const r = (i + 0.5) * (R / 2), l = (j + 0.5) * (L / 2);
      const cx = o.x + (r - l) * ISO_X * U;
      const cy = o.y + (r + l) * ISO_Y * U + z;
      s += `<path d="M ${(cx - rs).toFixed(1)} ${(cy - hs).toFixed(1)} L ${(cx - rs).toFixed(1)} ${cy.toFixed(1)} A ${rs} ${(rs * ISO_Y).toFixed(1)} 0 0 0 ${(cx + rs).toFixed(1)} ${cy.toFixed(1)} L ${(cx + rs).toFixed(1)} ${(cy - hs).toFixed(1)} Z" fill="${c.r}" stroke="var(--keyline)" stroke-width="2" stroke-linejoin="round"/>`;
      s += `<ellipse cx="${cx.toFixed(1)}" cy="${(cy - hs).toFixed(1)}" rx="${rs}" ry="${(rs * ISO_Y).toFixed(1)}" fill="${c.t}" stroke="var(--keyline)" stroke-width="2"/>`;
    }
  }
  s += `</g>`;
  return s;
}

const O = { x: 320, y: 88 };
const plate = { t: 'var(--p-t)', r: 'var(--p-r)', l: 'var(--p-l)' };
const blue = { t: 'var(--b-t)', r: 'var(--b-r)', l: 'var(--b-l)' };
const red = { t: 'var(--r-t)', r: 'var(--r-r)', l: 'var(--r-l)' };

// origin of a brick seated at plate coordinates (r0, l0)
const org = (r0: number, l0: number) => ({
  x: O.x + (r0 - l0) * ISO_X * U,
  y: O.y + (r0 + l0) * ISO_Y * U,
});

let scene = '';
scene += brick(O, 6.6, 6.6, 14, plate, 0);                                       // baseplate
scene += brick(org(0.4, 0.4), 2.6, 2.6, 56, blue, 0);                            // back brick
scene += brick(org(3.4, 0.4), 2.6, 2.6, 56, blue, 0);                            // right brick
scene += brick(org(3.4, 3.4), 2.6, 2.6, 56, blue, 0);                            // front brick
scene += brick(org(0.4, 3.4), 2.6, 2.6, 56, red, -104, 'piece-drop');            // the dropping piece

// seat marker + dashed drop arrow under the red brick
const seatX = O.x + (1.7 - 4.7) * ISO_X * U;
const seatY = O.y + (1.7 + 4.7) * ISO_Y * U;
scene += `<polygon points="${iso(O, 0.4, 3.4, 1)} ${iso(O, 3.0, 3.4, 1)} ${iso(O, 3.0, 6.0, 1)} ${iso(O, 0.4, 6.0, 1)}" fill="rgba(229,57,53,0.14)" stroke="var(--piece)" stroke-width="2" stroke-dasharray="6 5" stroke-linejoin="round"/>`;
scene += `<line x1="${seatX.toFixed(1)}" y1="${(seatY - 40).toFixed(1)}" x2="${seatX.toFixed(1)}" y2="${(seatY - 14).toFixed(1)}" stroke="var(--piece)" stroke-width="3" stroke-dasharray="7 6" stroke-linecap="round"/>`;
scene += `<polygon points="${seatX.toFixed(1)},${(seatY - 6).toFixed(1)} ${(seatX - 9).toFixed(1)},${(seatY - 20).toFixed(1)} ${(seatX + 9).toFixed(1)},${(seatY - 20).toFixed(1)}" fill="var(--piece)" stroke="var(--keyline)" stroke-width="2" stroke-linejoin="round"/>`;

// leader-line labels, annotated directly on the drawing
const label = (x: number, y: number, tx: number, ty: number, text: string, anchor: 'start' | 'end') => {
  const midX = anchor === 'start' ? tx - 26 : tx + 26;
  return `<g>
    <polyline points="${x},${y} ${midX},${ty} ${tx},${ty}" fill="none" stroke="var(--keyline)" stroke-width="2"/>
    <circle cx="${tx}" cy="${ty}" r="4" fill="var(--keyline)"/>
    <text x="${x}" y="${y + 5}" font-size="14" font-weight="600" fill="var(--ink)" text-anchor="${anchor}" style="paint-order: stroke; stroke: var(--paper); stroke-width: 4;">${text}</text>
  </g>`;
};
scene += label(96, 330, 168, 262, 'Debian 12 baseplate', 'start');
scene += label(556, 300, 470, 244, 'Docker services, 3 of them', 'end');

const sceneSvg = `<svg viewBox="0 0 640 400" class="w-full h-auto" role="img" aria-label="Isometric diagram: a Debian baseplate carrying three Docker service bricks, with a Next.js app brick dropping into the last seat">${scene}</svg>`;

// ---- Content ----
const steps = [
  {
    n: '1',
    years: '2021 – 2025',
    title: 'Learned by running real servers',
    body: 'B.E. in Information Technology at SVIT. In parallel, a homelab that got out of hand: a Proxmox host, Debian VMs, Nginx reverse proxies, UFW firewalls, and enough downtime to learn what uptime costs.',
    added: ['Linux administration', 'Docker & Compose', 'DNS, DHCP, subnetting'],
  },
  {
    n: '2',
    years: '2024 – 2025',
    title: 'Built software in public',
    body: 'Moderated r/AI_India as it grew from 1,000 to 21,000 members. Founded Shravonix and published 25-plus deep dives on AI and infrastructure, peaking at 5,000 monthly readers. Shipped React and Remix apps on the side.',
    added: ['Technical writing', 'Community operations', 'React & Remix'],
  },
  {
    n: '3',
    years: 'Sep 2025 – now',
    title: 'Shipping client work at Aexaware Infotech',
    body: 'Full-time in Vadodara. Full-stack apps on Next.js, Node and Prisma, delivered from schema to deployment. GitHub Actions pipelines, Docker Compose environments, Nginx and SSL on Debian servers, migrations with a rollback plan.',
    added: ['Production delivery', 'CI/CD pipelines', 'Client communication'],
    current: true,
  },
];

const builds = [
  {
    n: '01',
    name: 'Writenex CMS',
    desc: 'A visual editor for Astro content collections. Published on npm, and this site is written through it.',
    steps: [
      'Designed a TypeScript-first fields API: 25-plus field types with autocomplete inference.',
      'Auto-discovers collections and content config, so setup is zero-config.',
      'Added shadow-copy version history and drag-and-drop media management.',
    ],
    pieces: ['Astro', 'TypeScript', 'MDX & Markdoc'],
    callout: { value: 'v1.9', label: 'live on npm as @imjp/writenex-astro' },
    link: { href: 'https://writenex-writenex.vercel.app/astro', label: 'Open the docs' },
  },
  {
    n: '02',
    name: 'Dokploy templates',
    desc: 'Deployment blueprints for the open-source PaaS, upstreamed to the official repository.',
    steps: [
      'Wrote a meta.json CLI validator: schema checks, dedupe, and port checks across 100-plus templates.',
      'Added GitHub Actions CI so a broken compose file never merges.',
      'Shipped 10-plus templates, including Habitica, Statping-NG, BookLore and Gitea.',
    ],
    pieces: ['Docker Compose', 'GitHub Actions', 'JSON Schema'],
    callout: { value: '10+', label: 'pull requests merged upstream' },
    link: { href: 'https://github.com/Dokploy/templates/pulls?q=is%3Apr+author%3Ajaainil', label: 'Read the merged PRs' },
  },
  {
    n: '03',
    name: 'Blog Maker',
    desc: 'A multi-tenant blogging SaaS: sign up, get a blog, pay for it.',
    steps: [
      'Modeled the Prisma and PostgreSQL schema with tenant isolation from day one.',
      'Wired Stripe webhooks with retry logic and idempotency checks.',
      'Fetched data server-side; initial page loads land under 200ms.',
    ],
    pieces: ['Next.js', 'Prisma', 'Stripe'],
    callout: { value: '<200ms', label: 'initial page load, measured' },
    link: { href: 'https://blog-maker.vercel.app/', label: 'Open the demo' },
  },
  {
    n: '04',
    name: 'India AI Tracker',
    desc: 'A dashboard tracking 150-plus Indian AI startups, research initiatives and LLM projects.',
    steps: [
      'Collected and structured the dataset by hand before writing any UI.',
      'Built command-menu search and dynamic filters with CMDK.',
      'Charted it with Recharts in both themes.',
    ],
    pieces: ['React', 'Recharts', 'CMDK'],
    callout: { value: '150+', label: 'organizations tracked' },
    link: { href: 'https://india-ai-tracker.vercel.app', label: 'Open the dashboard' },
  },
  {
    n: '05',
    name: 'MemoryView',
    desc: 'A searchable directory of AI and ML learning resources for developers and students.',
    steps: [
      'Curated 150-plus resources, sorted by what each one actually teaches.',
      'Wired Fuse.js for instant fuzzy search, no server round trips.',
      'Rendered it server-side with Remix for fast loads and clean indexing.',
    ],
    pieces: ['Remix', 'Fuse.js', 'Tailwind'],
    callout: { value: '150+', label: 'resources cataloged' },
    link: { href: 'https://remix-llm-resoures.vercel.app/', label: 'Open the directory' },
  },
  {
    n: '06',
    name: 'Shravonix',
    desc: 'The publication you are reading right now: independent technical writing on Linux, AI and infrastructure.',
    steps: [
      'Founded it and grew it to 5,000 monthly readers at peak.',
      'Built on Astro with static pages behind an edge CDN.',
      'Migrated the full archive to this site, and still publishing.',
    ],
    pieces: ['Astro', 'MDX', 'Edge CDN'],
    callout: { value: '25+', label: 'deep dives published' },
    link: { href: '/articles', label: 'Read the publication' },
  },
];

const stamps = [
  { issuer: 'SVIT · 2024', name: 'MECIA Hacks', detail: 'Finalist. Built and shipped an AI-assisted web app in 24 hours.' },
  { issuer: 'Hack2skill', name: 'Snap AR Lens Hackathon', detail: 'Built an interactive Snapchat lens with custom 3D elements.' },
  { issuer: 'Web3Dev', name: 'Web Development Bootcamp', detail: 'Hands-on training in JavaScript and full-stack architecture.' },
  { issuer: 'freeCodeCamp', name: 'Responsive Web Design', detail: 'Certified. Responsive layouts and flexbox standards.' },
];

const inventory = [
  { color: 'var(--action)', name: 'Frontend', parts: ['Astro', 'React', 'Next.js', 'Remix', 'Vite', 'Tailwind CSS', 'TypeScript', 'Radix UI'] },
  { color: 'var(--piece)', name: 'Backend & data', parts: ['Node.js', 'Express', 'Prisma ORM', 'PostgreSQL', 'MongoDB', 'Redis', 'Stripe'] },
  { color: 'var(--marker)', name: 'DevOps & infra', parts: ['Docker', 'Docker Compose', 'GitHub Actions', 'Linux (Debian)', 'Proxmox VE', 'Nginx', 'Vercel'] },
  { color: 'var(--action)', name: 'Networking', parts: ['TCP/IP & DNS', 'DHCP & subnetting', 'UFW firewalls', 'Reverse proxies', 'SSL'] },
  { color: 'var(--piece)', name: 'AI & automation', parts: ['LLM integrations', 'LangChain basics', 'Webhooks', 'Fuse.js search'] },
  { color: 'var(--marker)', name: 'Design & media', parts: ['Figma', 'Photoshop', 'Illustrator', 'Premiere Pro', 'After Effects'] },
  { color: 'var(--action)', name: 'Workbench', parts: ['Git & GitHub', 'Bash', 'Postman', 'SSH'] },
];

const elsewhere = [
  { label: 'GitHub', handle: '@jaainil', href: 'https://github.com/jaainil' },
  { label: 'LinkedIn', handle: '/in/jaainil', href: 'https://www.linkedin.com/in/jaainil/' },
  { label: 'Instagram', handle: '@jaainil', href: 'https://www.instagram.com/jaainil/' },
  { label: 'npm', handle: '~imjp', href: 'https://www.npmjs.com/~imjp' },
  { label: 'Reddit', handle: 'u/enough_jainil', href: 'https://www.reddit.com/user/enough_jainil/' },
];

const fmtDate = (iso: string) =>
  new Date(iso + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const SITE_URL = 'https://jaainil.com';
const homePageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${SITE_URL}/#webpage`,
  name: 'Jainil Prajapati — Full-Stack Developer & DevOps Engineer',
  description: 'Portfolio and technical writings of Jainil Prajapati. Full-stack development, Docker workflows, CI/CD automation, Linux administration, and Dokploy open-source contributions.',
  url: SITE_URL,
  inLanguage: 'en',
  isPartOf: { '@id': `${SITE_URL}/#website` },
  about: { '@id': `${SITE_URL}/#person` },
  mainEntity: { '@id': `${SITE_URL}/#person` },
};
---

<BaseLayout
  title="Jainil Prajapati — Full-Stack Developer & DevOps Engineer"
  description="Portfolio and technical writings of Jainil Prajapati. Full-stack development, Docker workflows, CI/CD automation, Linux administration, and Dokploy open-source contributions."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(homePageSchema)} />
  </Fragment>

  <!-- HERO: the cover page of the booklet -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 pt-10 sm:pt-16 pb-14">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-8 items-center">
      <div class="lg:col-span-6">
        <p class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg text-sm font-bold mb-6" style="background: var(--marker); border: 2px solid var(--keyline); box-shadow: 0 2px 0 var(--keyline); color: #10151b;">
          Open to full-time roles
        </p>
        <h1 class="text-5xl sm:text-6xl xl:text-7xl font-black tracking-tight leading-[0.95] mb-5" style="color: var(--ink);">
          Jainil Prajapati
        </h1>
        <p class="text-lg sm:text-xl leading-relaxed max-w-xl mb-8 font-medium" style="color: var(--color-text-secondary);">
          Full-stack developer and DevOps engineer in Gujarat, India. I build the web app and the infrastructure under it, then write up how it went.
        </p>
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <a
            href="#builds"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl font-bold transition-transform hover:-translate-y-0.5"
            style="background: var(--action); color: #fff; border: 2px solid var(--keyline); box-shadow: 0 3px 0 var(--keyline);"
          >
            See the builds
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m0 0l-6-6m6 6l6-6" /></svg>
          </a>
          <a
            href="mailto:jainilprajapati9@gmail.com"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl font-bold transition-transform hover:-translate-y-0.5"
            style="background: var(--paper); color: var(--ink); border: 2px solid var(--keyline); box-shadow: 0 3px 0 var(--keyline);"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            Email me
          </a>
          <a
            href="/resume/Jainil.pdf"
            download="Jainil-Prajapati-Resume.pdf"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl font-bold transition-transform hover:-translate-y-0.5"
            style="background: var(--paper); color: var(--ink); border: 2px solid var(--keyline); box-shadow: 0 3px 0 var(--keyline);"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0l-5-5m5 5l5-5M5 20h14" /></svg>
            Résumé
          </a>
        </div>
        <p class="text-sm font-semibold" style="color: var(--color-text-muted);">
          Full-stack & DevOps Engineer at Aexaware Infotech · Dokploy contributor · npm publisher
        </p>
      </div>

      <div class="lg:col-span-6">
        <div class="iso-scene rounded-2xl p-4 sm:p-6" style="background: var(--paper); border: 2px solid var(--keyline); box-shadow: 0 4px 0 var(--keyline);">
          <div class="stud-grid rounded-xl mb-4" style="border: 2px dashed var(--color-border-soft);">
            <Fragment set:html={sceneSvg} />
          </div>
          <div class="rounded-xl p-4" style="border: 2px solid var(--keyline);">
            <h2 class="text-xs font-black uppercase tracking-wider mb-3" style="color: var(--ink);">Pieces in this set</h2>
            <ul class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm font-semibold" style="color: var(--color-text-secondary);">
              <li class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded-[3px]" style="background: var(--plate); border: 2px solid var(--keyline);"></span>Debian baseplate</li>
              <li class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded-[3px]" style="background: var(--action); border: 2px solid var(--keyline);"></span>Docker services</li>
              <li class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded-[3px]" style="background: var(--piece); border: 2px solid var(--keyline);"></span>Next.js apps</li>
              <li class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded-[3px]" style="background: var(--marker); border: 2px solid var(--keyline);"></span>CI on every push</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- THE BUILD SO FAR -->
  <section id="build" class="border-t-2 py-14" style="border-color: var(--keyline);">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl mb-10">
      <h2 class="text-3xl sm:text-4xl font-black tracking-tight mb-3" style="color: var(--ink);">The build so far</h2>
      <p class="text-lg leading-relaxed" style="color: var(--color-text-secondary);">
        Three steps, in order. Each one lists only what that step added.
      </p>
    </div>

    <ol class="space-y-0">
      {steps.map((step, i) => (
        <li class="relative grid md:grid-cols-[120px_1fr] gap-4 md:gap-8">
          <div class="flex md:flex-col items-center md:items-start gap-3">
            <span class="text-6xl md:text-7xl font-black leading-none tracking-tight" style={{ color: step.current ? 'var(--piece)' : 'var(--ink)' }}>{step.n}</span>
            {i < steps.length - 1 && (
              <svg class="hidden md:block w-6 h-16 ml-3" fill="none" aria-hidden="true">
                <line x1="12" y1="0" x2="12" y2="52" stroke="var(--keyline)" stroke-width="2.5" stroke-dasharray="7 6"/>
                <polygon points="12,62 4,48 20,48" fill="var(--keyline)"/>
              </svg>
            )}
          </div>

          <div
            class="relative rounded-2xl p-6 sm:p-7 mb-8"
            style={`background: var(--paper); border: 2px solid var(--keyline); box-shadow: 0 4px 0 var(--keyline); ${step.current ? 'background: var(--color-surface-elevated);' : ''}`}
          >
            {step.current && (
              <span class="absolute -top-3.5 right-6 px-3 py-1 rounded-lg text-xs font-black uppercase tracking-wide" style="background: var(--marker); border: 2px solid var(--keyline); color: #10151b;">
                You are here
              </span>
            )}
            <p class="text-sm font-bold uppercase tracking-wider mb-1.5" style="color: var(--color-text-muted);">{step.years}</p>
            <h3 class="text-xl sm:text-2xl font-extrabold tracking-tight mb-3" style="color: var(--ink);">{step.title}</h3>
            <p class="leading-relaxed mb-5 max-w-3xl" style="color: var(--color-text-secondary);">{step.body}</p>
            <div>
              <p class="text-xs font-black uppercase tracking-wider mb-2.5" style="color: var(--piece);">Added in this step</p>
              <ul class="flex flex-wrap gap-2">
                {step.added.map((piece) => (
                  <li
                    class="px-3 py-1.5 rounded-lg text-sm font-semibold"
                    style={`border: 2px solid var(--keyline); ${step.current ? 'background: var(--paper); color: var(--ink);' : 'background: var(--color-surface-elevated); color: var(--color-text-muted);'}`}
                  >
                    {piece}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </li>
      ))}
    </ol>
    </div>
  </section>

  <!-- STAMPS -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 pb-14">
    <div class="max-w-2xl mb-8">
      <h2 class="text-2xl sm:text-3xl font-black tracking-tight mb-2" style="color: var(--ink);">Stamps collected</h2>
      <p class="text-base leading-relaxed" style="color: var(--color-text-secondary);">Hackathons and certificates, kept for the record.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
      {stamps.map((stamp, i) => (
        <div
          class="rounded-xl p-4 transition-transform hover:rotate-0"
          style={`background: var(--paper); border: 2px solid var(--keyline); box-shadow: 0 3px 0 var(--keyline); transform: rotate(${i % 2 === 0 ? '-1.2deg' : '1.2deg'});`}
        >
          <div class="rounded-lg p-3 h-full" style="border: 2px dashed var(--color-border-soft);">
            <p class="text-[11px] font-black uppercase tracking-wide mb-1.5" style="color: var(--piece);">{stamp.issuer}</p>
            <h3 class="text-sm font-extrabold leading-snug mb-1.5" style="color: var(--ink);">{stamp.name}</h3>
            <p class="text-xs leading-relaxed" style="color: var(--color-text-secondary);">{stamp.detail}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- BUILDS -->
  <section id="builds" class="py-14" style="border-top: 2px solid var(--keyline); background: var(--paper);">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="max-w-2xl mb-10">
        <h2 class="text-3xl sm:text-4xl font-black tracking-tight mb-3" style="color: var(--ink);">Builds</h2>
        <p class="text-lg leading-relaxed" style="color: var(--color-text-secondary);">
          Four things I built end to end. Every claim links to the artifact, so you can check my work.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        {builds.map((b) => (
          <article class="rounded-2xl p-6 sm:p-7 flex flex-col" style="background: var(--color-surface-elevated); border: 2px solid var(--keyline); box-shadow: 0 4px 0 var(--keyline);">
            <div class="flex items-start justify-between gap-4 mb-1">
              <span class="text-5xl font-black leading-none tracking-tight" style="color: var(--piece);">{b.n}</span>
              <span class="text-right px-3 py-2 rounded-xl" style="border: 2px solid var(--keyline); background: var(--paper);">
                <span class="block text-xl font-black leading-none" style="color: var(--ink);">{b.callout.value}</span>
                <span class="block text-[11px] font-semibold mt-1 max-w-[180px]" style="color: var(--color-text-muted);">{b.callout.label}</span>
              </span>
            </div>
            <h3 class="text-2xl font-extrabold tracking-tight mt-3 mb-2" style="color: var(--ink);">{b.name}</h3>
            <p class="leading-relaxed mb-5" style="color: var(--color-text-secondary);">{b.desc}</p>

            <ol class="space-y-3 mb-5">
              {b.steps.map((s, si) => (
                <li class="flex items-start gap-3">
                  <span class="grid place-items-center w-7 h-7 shrink-0 rounded-lg text-sm font-black" style={`border: 2px solid var(--keyline); ${si === b.steps.length - 1 ? 'background: var(--piece); color: #fff;' : 'background: var(--paper); color: var(--ink);'}`}>{si + 1}</span>
                  <span class="text-sm leading-relaxed pt-1" style="color: var(--color-text-secondary);">{s}</span>
                </li>
              ))}
            </ol>

            <ul class="flex flex-wrap gap-2 mb-6">
              {b.pieces.map((p) => (
                <li class="px-2.5 py-1 rounded-md text-xs font-bold" style="border: 2px solid var(--keyline); background: var(--paper); color: var(--ink);">{p}</li>
              ))}
            </ul>

            <a
              href={b.link.href}
              target={b.link.href.startsWith('http') ? '_blank' : undefined}
              rel={b.link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="mt-auto inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl font-bold transition-transform hover:-translate-y-0.5"
              style="background: var(--action); color: #fff; border: 2px solid var(--keyline); box-shadow: 0 3px 0 var(--keyline);"
            >
              {b.link.label}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7m0 0H8m9 0v9" /></svg>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PARTS INVENTORY -->
  <section id="inventory" class="border-t-2 py-14" style="border-color: var(--keyline);">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl mb-8">
      <h2 class="text-2xl sm:text-3xl font-black tracking-tight mb-2" style="color: var(--ink);">Parts in the kit</h2>
      <p class="text-base leading-relaxed" style="color: var(--color-text-secondary);">The full inventory, sorted by where each part goes. No filler pieces.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-0.5 rounded-2xl overflow-hidden" style="background: var(--keyline); border: 2px solid var(--keyline); box-shadow: 0 4px 0 var(--keyline);">
      {inventory.map((comp) => (
        <div class="p-5" style="background: var(--paper);">
          <div class="flex items-center justify-between mb-3">
            <p class="flex items-center gap-2 text-xs font-black uppercase tracking-wide" style="color: var(--ink);">
              <span class="w-3 h-3 rounded-[3px] shrink-0" style={`background: ${comp.color}; border: 2px solid var(--keyline);`}></span>
              {comp.name}
            </p>
            <span class="text-[11px] font-black px-1.5 py-0.5 rounded" style="border: 2px solid var(--keyline); background: var(--color-surface-elevated); color: var(--color-text-muted);">{comp.parts.length} pcs</span>
          </div>
          <p class="text-sm leading-relaxed font-medium" style="color: var(--color-text-secondary);">
            {comp.parts.join(' · ')}
          </p>
        </div>
      ))}
      <!-- Last compartment: the honest note, spanning the leftover slots -->
      <div class="p-5 flex items-center sm:col-span-1 lg:col-span-2" style="background: var(--color-surface-elevated);">
        <p class="text-sm leading-relaxed font-medium" style="color: var(--color-text-muted);">
          Depth over breadth: I'd rather ship one Postgres schema at 2am than list thirty logos.
        </p>
      </div>
    </div>
    </div>
  </section>

  <!-- FIELD NOTES -->
  <section id="notes" class="border-t-2 py-14" style="border-color: var(--keyline);">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
      <div class="max-w-2xl">
        <h2 class="text-3xl sm:text-4xl font-black tracking-tight mb-3" style="color: var(--ink);">Field notes</h2>
        <p class="text-lg leading-relaxed" style="color: var(--color-text-secondary);">
          I write up what I learn at Shravonix. Latest three:
        </p>
      </div>
      <a href="/articles" class="inline-flex items-center gap-2 font-bold underline underline-offset-4 decoration-2 hover:opacity-80" style="color: var(--color-link);">
        All {totalArticlesCount} notes
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m0 0l-6-6m6 6l-6 6" /></svg>
      </a>
    </div>

    <div class="rounded-2xl overflow-hidden" style="background: var(--paper); border: 2px solid var(--keyline); box-shadow: 0 4px 0 var(--keyline);">
      {latestArticles.map((article, i) => (
        <a
          href={`/articles/${article.id}`}
          class={`flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-6 px-6 py-5 transition-colors hover:bg-[var(--color-hover)] ${i > 0 ? 'border-t-2' : ''}`}
          style="border-color: var(--keyline);"
        >
          <span class="text-2xl font-black w-8 shrink-0" style="color: var(--piece);">{String(i + 1).padStart(2, '0')}</span>
          <span class="flex-1">
            <span class="block font-extrabold text-lg leading-snug" style="color: var(--ink);">{article.title}</span>
            <span class="block text-sm mt-0.5" style="color: var(--color-text-muted);">{fmtDate(article.publishedAt)} · {article.category} · {article.readingTime || '5 min read'}</span>
          </span>
          <svg class="w-5 h-5 shrink-0 hidden sm:block" fill="none" stroke="var(--ink)" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
        </a>
      ))}
    </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="mx-auto max-w-6xl px-4 sm:px-6 pb-16">
    <div class="rounded-2xl p-7 sm:p-10 grid lg:grid-cols-12 gap-8" style="background: var(--paper); border: 2px solid var(--keyline); box-shadow: 0 4px 0 var(--keyline);">
      <div class="lg:col-span-7">
        <h2 class="text-3xl sm:text-4xl font-black tracking-tight mb-4" style="color: var(--ink);">Open a build slot</h2>
        <p class="text-lg leading-relaxed mb-8 max-w-xl" style="color: var(--color-text-secondary);">
          Need an app built, containerized and deployed? Or an engineer who owns the whole stack, not just the pretty parts? Email works fastest.
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href="mailto:jainilprajapati9@gmail.com"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl font-bold transition-transform hover:-translate-y-0.5"
            style="background: var(--piece); color: #fff; border: 2px solid var(--keyline); box-shadow: 0 3px 0 var(--keyline);"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            jainilprajapati9@gmail.com
          </a>
          <a
            href="tel:+919725284302"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl font-bold transition-transform hover:-translate-y-0.5"
            style="background: var(--paper); color: var(--ink); border: 2px solid var(--keyline); box-shadow: 0 3px 0 var(--keyline);"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            +91 97252 84302
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="rounded-xl p-5 h-full" style="border: 2px dashed var(--keyline); background: var(--color-surface-elevated);">
          <h3 class="text-xs font-black uppercase tracking-wider mb-3" style="color: var(--ink);">Elsewhere</h3>
          <ul class="space-y-2 mb-5">
            {elsewhere.map((e) => (
              <li>
                <a href={e.href} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between px-3.5 py-2.5 rounded-lg text-sm font-bold transition-transform hover:-translate-y-0.5" style="background: var(--paper); border: 2px solid var(--keyline); color: var(--ink);">
                  <span>{e.label}</span>
                  <span class="font-semibold" style="color: var(--color-text-muted);">{e.handle}</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="text-sm font-semibold" style="color: var(--color-text-muted);">
            Anand, Gujarat, India. Open to remote and relocation.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

