export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import { Schema } from 'astro-seo-schema';

const SITE_URL = 'https://jaainil.com';
const pageUrl = `${SITE_URL}/pieces`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Pieces', item: pageUrl },
  ],
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#webpage`,
  name: 'Pieces in the Kit — Tools & Devices of Jainil Prajapati',
  description: 'The tools, devices, operating system, and workflow pieces used daily by Jainil Prajapati.',
  url: pageUrl,
  inLanguage: 'en',
  isPartOf: { '@id': `${SITE_URL}/#website` },
  about: { '@id': `${SITE_URL}/#person` },
};

interface PieceItem {
  name: string;
  link?: string;
  icon: string;
}

interface Compartment {
  title: string;
  color: string;
  pieces: PieceItem[];
}

