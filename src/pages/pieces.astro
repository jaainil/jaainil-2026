const totalPieces = compartments.reduce((acc, c) => acc + c.pieces.length, 0);
---

<BaseLayout
  title="Pieces in the Kit — Jainil Prajapati"
  description="The tools, devices, operating system, and workflow pieces used daily by Jainil Prajapati."
>
  <Fragment slot="head">
    <Schema item={breadcrumbSchema as any} />
    <Schema item={webPageSchema as any} />
  </Fragment>

  <div class="mx-auto max-w-4xl px-4 sm:px-6 pt-10 sm:pt-16 pb-20">
    <!-- BREADCRUMB -->
    <nav class="mb-6" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider" style="color: var(--color-text-muted);">
        <li>
          <a href="/" class="hover:underline underline-offset-4" style="color: var(--color-link);">Home</a>
        </li>
        <li aria-hidden="true">/</li>
        <li style="color: var(--ink);">Pieces in the kit</li>
      </ol>
    </nav>

    <!-- HEADER -->
    <header class="mb-10">
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight mb-3" style="color: var(--ink);">
        Pieces in the kit
      </h1>
      <p class="text-base sm:text-lg leading-relaxed font-medium mb-5" style="color: var(--color-text-secondary);">
        The operating system, tools, and hardware pieces I use to build and ship software.
      </p>

      <!-- TAGS STRIP -->
      <div class="flex flex-wrap items-center gap-2.5">
        <span
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-extrabold uppercase tracking-wide"
          style="background: var(--marker); color: #10151b; border: 2px solid var(--keyline); box-shadow: 0 2px 0 var(--keyline);"
        >
          <span class="w-2.5 h-2.5 rounded-full" style="background: var(--piece);"></span>
          {totalPieces} pieces cataloged
        </span>
        <span
          class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-bold"
          style="background: var(--paper); color: var(--ink); border: 2px solid var(--keyline); box-shadow: 0 2px 0 var(--keyline);"
        >
          No sponsored filler
        </span>
      </div>
    </header>

    <!-- COMPARTMENTS -->
    <div class="space-y-6">
      {compartments.map((comp) => (
        <section
          class="rounded-2xl p-5 sm:p-6"
          style="background: var(--paper); border: 2px solid var(--keyline); box-shadow: 0 4px 0 var(--keyline);"
        >
          <!-- COMPARTMENT HEADER -->
          <div class="flex items-center justify-between pb-3 mb-4" style="border-bottom: 2px solid var(--keyline);">
            <h2 class="flex items-center gap-2 text-xs font-black uppercase tracking-wider" style="color: var(--ink);">
              <span class="w-3 h-3 rounded-[3px] shrink-0" style={`background: ${comp.color}; border: 2px solid var(--keyline);`}></span>
              {comp.title}
            </h2>
            <span
              class="text-xs font-black px-2 py-0.5 rounded-md"
              style="background: var(--color-surface-elevated); border: 1.5px solid var(--keyline); color: var(--color-text-muted);"
            >
              {comp.pieces.length} {comp.pieces.length === 1 ? 'pc' : 'pcs'}
            </span>
          </div>

          <!-- PIECES TILES GRID (ICON + NAME) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {comp.pieces.map((piece) => {
              const Tag = piece.link ? 'a' : 'div';
              const linkProps = piece.link
                ? {
                    href: piece.link,
                    target: '_blank',
                    rel: 'noopener noreferrer',
                    'aria-label': `${piece.name} (opens in new tab)`,
                  }
                : {};

              return (
                <Tag
                  {...linkProps}
                  class="group flex items-center justify-between gap-3 p-3.5 rounded-xl transition-transform hover:-translate-y-0.5"
                  style="background: var(--color-surface-elevated); border: 2px solid var(--keyline); box-shadow: 0 2px 0 var(--keyline);"
                >
                  <div class="flex items-center gap-3 min-w-0">
                    <span
                      class="grid place-items-center w-8 h-8 rounded-lg shrink-0 transition-transform group-hover:scale-105 [&>svg]:w-4 [&>svg]:h-4 [&>svg.wide-logo]:w-5 [&>svg.wide-logo]:h-auto"
                      style="background: var(--paper); border: 1.5px solid var(--keyline); color: var(--ink);"
                      set:html={piece.icon}
                    />
                    <span class="font-bold text-sm tracking-tight truncate" style="color: var(--ink);">
                      {piece.name}
                    </span>
                  </div>

                  {piece.link && (
                    <svg
                      class="w-3.5 h-3.5 shrink-0 opacity-40 group-hover:opacity-100 transition-opacity"
                      style="color: var(--ink);"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7m0 0H7m10 0v10" />
                    </svg>
                  )}
                </Tag>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
