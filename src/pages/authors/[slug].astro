---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro-lqip/components';
import { Schema } from 'astro-seo-schema';

export async function getStaticPaths() {
  const authors = await getCollection('authors');
  return authors.map((author) => ({
    params: { slug: author.id },
    props: { author },
  }));
}

const { author } = Astro.props;
const allArticles = await getCollection('articles');

const authorArticles = allArticles
  .filter((article) => article.data.authors.includes(author.id))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const SITE_URL = 'https://shravonix.com';
const authorUrl = `${SITE_URL}/authors/${author.id}`;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${authorUrl}#person`,
  name: author.data.name,
  url: authorUrl,
  ...(author.data.avatarUrl && { image: author.data.avatarUrl }),
  ...(author.data.bio && { description: author.data.bio }),
  ...(author.data.role && { jobTitle: author.data.role }),
  worksFor: {
    '@id': `${SITE_URL}/#organization`,
  },
  sameAs: [
    ...(author.data.social?.twitter ? [`https://twitter.com/${author.data.social.twitter}`] : []),
    ...(author.data.social?.github ? [`https://github.com/${author.data.social.github}`] : []),
    ...(author.data.social?.linkedin ? [`https://linkedin.com/in/${author.data.social.linkedin}`] : []),
  ],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Authors', item: `${SITE_URL}/authors` },
    { '@type': 'ListItem', position: 3, name: author.data.name, item: authorUrl },
  ],
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${authorUrl}#webpage`,
  name: `${author.data.name} — Shravonix`,
  description: author.data.bio || `Articles and profile of ${author.data.name} on Shravonix`,
  url: authorUrl,
  inLanguage: 'en',
  isPartOf: { '@id': `${SITE_URL}/#website` },
  about: { '@id': `${authorUrl}#person` },
};
---

<BaseLayout title={`${author.data.name} — Shravonix`} description={author.data.bio || `Articles and profile of ${author.data.name} on Shravonix`}>
  <Fragment slot="head">
    <Schema item={personSchema as any} />
    <Schema item={breadcrumbSchema as any} />
    <Schema item={webPageSchema as any} />
  </Fragment>
  <div class="w-full pb-16">
    
    <!-- Author Header -->
    <div class="border-b px-6 md:px-8 py-16" style="border-color: var(--color-border);">
      <div class="flex items-center gap-6">
        <img
          src={author.data.avatarUrl}
          alt={author.data.name}
          class="w-20 h-20 border"
          style="border-color: var(--color-border);"
        />
        <div>
          <p class="text-[11px] font-mono uppercase tracking-widest mb-2" style="color: var(--color-text-muted);">// Author</p>
          <h1 class="text-4xl md:text-5xl font-display font-bold tracking-tight mb-2" style="color: var(--color-text-primary);">
            {author.data.name}
          </h1>
          {author.data.role && (
            <p class="text-sm font-mono uppercase tracking-widest" style="color: var(--color-accent-text);">
              {author.data.role}
            </p>
          )}
        </div>
      </div>
    </div>

    <!-- Bio -->
    {author.data.bio && (
      <div class="border-b px-6 md:px-8 py-8" style="border-color: var(--color-border);">
        <p class="text-lg font-sans max-w-2xl" style="color: var(--color-text-secondary);">
          {author.data.bio}
        </p>
      </div>
    )}

    <!-- Social Links -->
    {author.data.social && (
      <div class="border-b px-6 md:px-8 py-6" style="border-color: var(--color-border);">
        <div class="flex gap-4">
          {author.data.social.github && (
            <a
              href={`https://github.com/${author.data.social.github}`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-sm font-mono uppercase tracking-widest transition-colors"
              style="color: var(--color-text-muted);"
              onmouseenter="this.style.color='var(--color-text-primary)'"
              onmouseleave="this.style.color='var(--color-text-muted)'"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              GitHub
            </a>
          )}
          {author.data.social.twitter && (
            <a
              href={`https://twitter.com/${author.data.social.twitter}`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-sm font-mono uppercase tracking-widest transition-colors"
              style="color: var(--color-text-muted);"
              onmouseenter="this.style.color='var(--color-text-primary)'"
              onmouseleave="this.style.color='var(--color-text-muted)'"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.007 4.126H5.078z"/>
              </svg>
              X/Twitter
            </a>
          )}
        </div>
      </div>
    )}

    <!-- Articles by Author -->
    <div class="border-b px-6 md:px-8 py-8" style="border-color: var(--color-border);">
      <h2 class="text-sm font-mono font-bold uppercase tracking-widest mb-6" style="color: var(--color-text-primary);">
        // Articles by {author.data.name}
      </h2>
      
      {authorArticles.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-0" style="border-color: var(--color-border);">
          {authorArticles.map((article) => (
            <a
              href={`/articles/${article.id}`}
              class="group flex flex-col h-full transition-colors border"
              style="border-color: var(--color-border);"
              onmouseenter="this.style.backgroundColor='var(--color-hover)'"
              onmouseleave="this.style.backgroundColor=''"
            >
              <div class="p-6 md:p-8 grow">
                <div class="aspect-video rounded-none overflow-hidden mb-6 border" style="background-color: var(--color-image-bg); border-color: var(--color-border);">
                  <Image
                    src={article.data.imageUrl}
                    alt={article.data.imageAlt ?? article.data.title}
                    class="w-full h-full object-cover"
                    width={600}
                    height={338}
                    format="webp"
                    quality={80}
                    loading="lazy"
                    lqip="color"
                  />
                </div>
                <div class="flex items-center gap-2 text-[11px] font-mono uppercase tracking-widest mb-3" style="color: var(--color-text-muted);">
                  <span>// {article.data.category}</span>
                </div>
                <h3 class="text-lg font-display font-bold tracking-tight mb-3" style="color: var(--color-text-primary);">
                  {article.data.title}
                </h3>
                {article.data.description && (
                  <p class="text-sm font-sans line-clamp-2" style="color: var(--color-text-secondary);">
                    {article.data.description}
                  </p>
                )}
              </div>
              <div class="border-t p-4 px-6 md:px-8 flex items-center justify-between mt-auto" style="border-color: var(--color-border);">
                <div class="text-[11px] font-mono uppercase tracking-widest" style="color: var(--color-text-muted);">
                  {article.data.publishedAt.toISOString().split('T')[0]}
                </div>
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" style="color: var(--color-text-muted);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-sm font-sans" style="color: var(--color-text-secondary);">No articles published yet.</p>
      )}
    </div>

  </div>
</BaseLayout>
