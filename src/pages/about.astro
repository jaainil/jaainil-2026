---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Schema } from 'astro-seo-schema';

const SITE_URL = 'https://jaainil.com';
const pageUrl = `${SITE_URL}/about`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'About', item: pageUrl },
  ],
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${pageUrl}#webpage`,
  name: 'About Jainil Prajapati — Full-Stack Developer & DevOps Engineer',
  description: 'Learn about Jainil Prajapati: full-stack developer and DevOps engineer experienced in Next.js, Node.js, Docker containerization, Linux systems, and open-source contributions.',
  url: pageUrl,
  inLanguage: 'en',
  isPartOf: { '@id': `${SITE_URL}/#website` },
  about: { '@id': `${SITE_URL}/#person` },
  mainEntity: { '@id': `${SITE_URL}/#person` },
};

const competencies = [
  {
    n: '1',
    title: 'Full-stack web development',
    body: 'Web applications with Next.js, React, Astro, Node.js and Express, backed by Prisma ORM on PostgreSQL or MongoDB.',
  },
  {
    n: '2',
    title: 'DevOps and CI/CD pipelines',
    body: 'GitHub Actions workflows for automated tests, Docker image builds, container deployments and environment configuration.',
  },
  {
    n: '3',
    title: 'Linux server administration and networking',
    body: 'Debian and Ubuntu production nodes, Nginx reverse proxies, DNS records, UFW firewall rules and Bash automation.',
  },
  {
    n: '4',
    title: 'Virtualization and self-hosting',
    body: 'Proxmox VE hypervisor administration, VLAN bridges, ZFS storage and self-hosted application stacks on my own hardware.',
  },
  {
    n: '5',
    title: 'Community and open source',
    body: 'Maintaining an npm package, contributing to Dokploy, and growing the r/AI_India community from 1,000 to 21,000 members.',
  },
];
---

<BaseLayout
  title="About Jainil Prajapati — Full-Stack Developer & DevOps Engineer"
  description="Learn about Jainil Prajapati: full-stack developer and DevOps engineer experienced in Next.js, Node.js, Docker containerization, Linux systems, and open-source contributions."
>
  <Fragment slot="head">
    <Schema item={breadcrumbSchema as any} />
    <Schema item={webPageSchema as any} />
  </Fragment>

  <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-10 sm:pt-16 pb-16">
    <div class="grid lg:grid-cols-12 gap-10 items-start mb-14">
      <div class="lg:col-span-8">
        <h1 class="text-4xl sm:text-5xl font-black tracking-tight mb-5" style="color: var(--ink);">About the builder</h1>
        <p class="text-lg leading-relaxed mb-5 font-medium" style="color: var(--color-text-secondary);">
          I'm Jainil, a full-stack developer and DevOps engineer based in Anand, Gujarat. I build web applications with Next.js and Node.js, containerize them with Docker, and run the Linux servers they live on.
        </p>
        <p class="leading-relaxed mb-5" style="color: var(--color-text-secondary);">
          Right now I work at <a href="https://aexaware.com" target="_blank" rel="noopener noreferrer" class="font-bold underline underline-offset-4" style="color: var(--color-link);">Aexaware Infotech</a> in Vadodara, building client applications and the CI/CD workflows that ship them. A normal day covers frontend layouts, API routes, database migrations, and Nginx reverse proxies with SSL on Debian servers.
        </p>
        <p class="leading-relaxed mb-5" style="color: var(--color-text-secondary);">
          In open source, I've merged <a href="https://github.com/Dokploy/templates/pulls?q=is%3Apr+author%3Ajaainil" target="_blank" rel="noopener noreferrer" class="font-bold underline underline-offset-4" style="color: var(--color-link);">more than ten pull requests into Dokploy's templates</a> and I maintain <a href="https://www.npmjs.com/package/@imjp/writenex-astro" target="_blank" rel="noopener noreferrer" class="font-bold underline underline-offset-4" style="color: var(--color-link);">Writenex CMS on npm</a>, a visual editor for Astro content collections.
        </p>
        <p class="leading-relaxed" style="color: var(--color-text-secondary);">
          Before that I founded <strong style="color: var(--ink);">Shravonix</strong>, an independent tech publication that reached 5,000 monthly readers. The archive lives on in the <a href="/articles" class="font-bold underline underline-offset-4" style="color: var(--color-link);">field notes section</a>.
        </p>
      </div>

      <div class="lg:col-span-4">
        <div class="rounded-2xl p-4" style="background: var(--paper); border: 2px solid var(--keyline); box-shadow: 0 4px 0 var(--keyline);">
          <div class="stud-grid rounded-xl overflow-hidden mb-3" style="border: 2px dashed var(--color-border-soft);">
            <img
              src="/profile.png"
              alt="Jainil Prajapati"
              class="w-full aspect-square object-cover"
              width="400"
              height="400"
              loading="lazy"
              decoding="async"
            />
          </div>
          <p class="text-sm font-bold text-center" style="color: var(--ink);">Jainil Prajapati</p>
          <p class="text-xs font-semibold text-center" style="color: var(--color-text-muted);">Anand, Gujarat, India</p>
        </div>
      </div>
    </div>

    <section class="mb-14">
      <h2 class="text-2xl sm:text-3xl font-black tracking-tight mb-3" style="color: var(--ink);">Parts inventory</h2>
      <p class="text-lg mb-8 max-w-2xl" style="color: var(--color-text-secondary);">What's in the kit, and what each part is for.</p>

      <div class="rounded-2xl overflow-hidden" style="background: var(--paper); border: 2px solid var(--keyline); box-shadow: 0 4px 0 var(--keyline);">
        {competencies.map((c, i) => (
          <div class={`flex items-start gap-5 px-6 py-5 ${i > 0 ? 'border-t-2' : ''}`} style="border-color: var(--keyline);">
            <span class="grid place-items-center w-9 h-9 shrink-0 rounded-lg text-base font-black" style="border: 2px solid var(--keyline); background: var(--marker); color: #10151b;">{c.n}</span>
            <div>
              <h3 class="text-lg font-extrabold tracking-tight mb-1" style="color: var(--ink);">{c.title}</h3>
              <p class="text-sm leading-relaxed" style="color: var(--color-text-secondary);">{c.body}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="rounded-2xl p-7 sm:p-10" style="background: var(--paper); border: 2px solid var(--keyline); box-shadow: 0 4px 0 var(--keyline);">
      <h2 class="text-2xl sm:text-3xl font-black tracking-tight mb-4" style="color: var(--ink);">Say hello</h2>
      <p class="leading-relaxed mb-7 max-w-xl" style="color: var(--color-text-secondary);">
        Up for discussing infrastructure, homelab architecture or open source. Email works fastest.
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href="mailto:jainilprajapati9@gmail.com"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl font-bold transition-transform hover:-translate-y-0.5"
          style="background: var(--piece); color: #fff; border: 2px solid var(--keyline); box-shadow: 0 3px 0 var(--keyline);"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          Email me
        </a>
        <a
          href="https://github.com/jaainil"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl font-bold transition-transform hover:-translate-y-0.5"
          style="background: var(--paper); color: var(--ink); border: 2px solid var(--keyline); box-shadow: 0 3px 0 var(--keyline);"
        >
          GitHub
        </a>
        <a
          href="https://www.linkedin.com/in/jaainil/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl font-bold transition-transform hover:-translate-y-0.5"
          style="background: var(--paper); color: var(--ink); border: 2px solid var(--keyline); box-shadow: 0 3px 0 var(--keyline);"
        >
          LinkedIn
        </a>
        <a
          href="https://www.npmjs.com/~imjp"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl font-bold transition-transform hover:-translate-y-0.5"
          style="background: var(--paper); color: var(--ink); border: 2px solid var(--keyline); box-shadow: 0 3px 0 var(--keyline);"
        >
          npm
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
