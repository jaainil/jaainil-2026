---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Schema } from 'astro-seo-schema';

const SITE_URL = 'https://jaainil.com';
const pageUrl = `${SITE_URL}/about`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'About', item: pageUrl },
  ],
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${pageUrl}#webpage`,
  name: 'About Jainil Prajapati: Full-Stack Developer & DevOps Engineer',
  description: 'Learn about Jainil Prajapati, a Full-Stack Developer and DevOps Engineer experienced in Next.js, Node.js, Docker, Linux server administration, and open-source ecosystems.',
  url: pageUrl,
  inLanguage: 'en',
  isPartOf: { '@id': `${SITE_URL}/#website` },
  about: { '@id': `${SITE_URL}/#person` },
};
---

<BaseLayout
  title="About: Jainil Prajapati (Full-Stack Developer & DevOps Engineer)"
  description="Learn about Jainil Prajapati, a Full-Stack Developer and DevOps Engineer experienced in Next.js, Node.js, Docker, Linux server administration, and open-source ecosystems."
>
  <Fragment slot="head">
    <Schema item={breadcrumbSchema as any} />
    <Schema item={webPageSchema as any} />
  </Fragment>
  <div class="w-full pb-16">
    
    <!-- Page heading -->
    <div class="border-b px-6 md:px-8 py-10" style="border-color: var(--color-border);">
      <p class="text-[11px] font-mono uppercase tracking-widest mb-2" style="color: var(--color-text-muted);">// About Me</p>
      <h1 class="text-4xl md:text-5xl font-display font-bold tracking-tight mb-2" style="color: var(--color-text-primary);">
        Jainil Prajapati
      </h1>
      <p class="text-sm font-mono uppercase tracking-wider" style="color: var(--color-text-secondary);">
        Full-Stack Developer & DevOps Engineer • AI Enthusiast • Anand, Gujarat, India
      </p>
    </div>

    <!-- Bio & Summary Section -->
    <section class="border-b px-6 md:px-8 py-16" style="border-color: var(--color-border);">
      <div class="max-w-3xl">
        <h2 class="text-sm font-mono font-bold uppercase tracking-widest mb-6" style="color: var(--color-text-primary);">
          // Background & Engineering Focus
        </h2>
        <p class="text-lg font-sans leading-relaxed mb-6" style="color: var(--color-text-secondary);">
          I am a full-stack developer and DevOps engineer based in Anand, Gujarat. I build web applications with Next.js and Node.js, containerize services using Docker, and manage production Linux servers.
        </p>
        <p class="text-base font-sans leading-relaxed mb-6" style="color: var(--color-text-secondary);">
          Currently working at <a href="https://aexaware.com" target="_blank" rel="noopener noreferrer" class="underline font-bold" style="color: var(--color-text-primary);">Aexawareinfotech Pvt. Ltd.</a> in Vadodara, I build client applications and maintain automated CI/CD workflows using GitHub Actions. My day-to-day work spans frontend layouts, backend API routes, database migrations, and server configuration with Nginx reverse proxies and SSL certificates.
        </p>
        <p class="text-base font-sans leading-relaxed mb-6" style="color: var(--color-text-secondary);">
          In the open-source community, I contribute to <a href="https://github.com/Dokploy/templates" target="_blank" rel="noopener noreferrer" class="underline font-bold" style="color: var(--color-text-primary);">Dokploy</a>, with 10+ merged pull requests across application blueprints, CLI validation tooling, and container networking. I also created <a href="https://www.npmjs.com/package/@imjp/writenex-astro" target="_blank" rel="noopener noreferrer" class="underline font-bold" style="color: var(--color-text-primary);">Writenex CMS</a>, an open-source headless CMS integration on npm with 79+ commits.
        </p>
        <p class="text-base font-sans leading-relaxed" style="color: var(--color-text-secondary);">
          Previously, I founded and ran <strong>Shravonix</strong>, an independent technical media site reaching 5K+ monthly readers with deep dives on Linux, AI models, and web architecture. I continue to publish in-depth technical writing, with all historical and new posts available in the <a href="/articles" class="underline font-bold" style="color: var(--color-text-primary);">Articles section</a> on this website.
        </p>
      </div>
    </section>

    <!-- Core Engineering Focus -->
    <section class="border-b px-6 md:px-8 py-16" style="border-color: var(--color-border);">
      <div class="max-w-3xl">
        <h2 class="text-sm font-mono font-bold uppercase tracking-widest mb-6" style="color: var(--color-text-primary);">
          // Core Competencies
        </h2>
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <span class="text-xs font-mono uppercase tracking-widest mt-1" style="color: var(--color-text-muted);">01</span>
            <div>
              <h3 class="text-base font-display font-bold mb-1" style="color: var(--color-text-primary);">Full-Stack Web Development</h3>
              <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Building web applications using Next.js, React, Astro, Node.js, Express, and Prisma ORM with PostgreSQL and MongoDB.</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <span class="text-xs font-mono uppercase tracking-widest mt-1" style="color: var(--color-text-muted);">02</span>
            <div>
              <h3 class="text-base font-display font-bold mb-1" style="color: var(--color-text-primary);">DevOps & CI/CD Pipelines</h3>
              <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Writing GitHub Actions workflows for automated tests, Docker image builds, container deployments, and environment configurations.</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <span class="text-xs font-mono uppercase tracking-widest mt-1" style="color: var(--color-text-muted);">03</span>
            <div>
              <h3 class="text-base font-display font-bold mb-1" style="color: var(--color-text-primary);">Linux Server Administration & Networking</h3>
              <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Managing Debian and Ubuntu production nodes, Nginx reverse proxy configuration, DNS records, firewall rules with UFW, and Bash automation.</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <span class="text-xs font-mono uppercase tracking-widest mt-1" style="color: var(--color-text-muted);">04</span>
            <div>
              <h3 class="text-base font-display font-bold mb-1" style="color: var(--color-text-primary);">Virtualization & Self-Hosting</h3>
              <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Proxmox VE hypervisor administration, VLAN network bridges, ZFS storage setups, and self-hosted application stacks.</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <span class="text-xs font-mono uppercase tracking-widest mt-1" style="color: var(--color-text-muted);">05</span>
            <div>
              <h3 class="text-base font-display font-bold mb-1" style="color: var(--color-text-primary);">Community & Open Source</h3>
              <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Maintaining open-source npm packages, contributing to Dokploy PaaS, and previously growing the r/AI_India Reddit community from 1K to 21K members.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Quick Navigation CTAs -->
    <section class="border-b px-6 md:px-8 py-16" style="border-color: var(--color-border);">
      <div class="max-w-3xl">
        <h2 class="text-sm font-mono font-bold uppercase tracking-widest mb-6" style="color: var(--color-text-primary);">
          // Explore Further
        </h2>
        <div class="flex flex-wrap gap-4">
          <a
            href="/#projects"
            class="inline-flex items-center gap-2 px-6 py-3 border text-xs font-mono uppercase tracking-widest transition-colors font-bold"
            style="border-color: var(--color-text-primary); background-color: var(--color-text-primary); color: var(--color-surface);"
          >
            Featured Projects
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>
          <a
            href="/#experience"
            class="inline-flex items-center gap-2 px-6 py-3 border text-xs font-mono uppercase tracking-widest transition-colors"
            style="border-color: var(--color-border); color: var(--color-text-primary); background-color: var(--color-surface);"
            onmouseenter="this.style.backgroundColor='var(--color-hover)'"
            onmouseleave="this.style.backgroundColor='var(--color-surface)'"
          >
            Work Experience
          </a>
          <a
            href="/articles"
            class="inline-flex items-center gap-2 px-6 py-3 border text-xs font-mono uppercase tracking-widest transition-colors"
            style="border-color: var(--color-border); color: var(--color-text-primary); background-color: var(--color-surface);"
            onmouseenter="this.style.backgroundColor='var(--color-hover)'"
            onmouseleave="this.style.backgroundColor='var(--color-surface)'"
          >
            Technical Articles
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="border-b px-6 md:px-8 py-16" style="border-color: var(--color-border);">
      <div class="max-w-3xl">
        <h2 class="text-sm font-mono font-bold uppercase tracking-widest mb-6" style="color: var(--color-text-primary);">
          // Get in Touch
        </h2>
        <div class="space-y-6">
          <p class="text-base font-sans leading-relaxed" style="color: var(--color-text-secondary);">
            Interested in discussing DevOps infrastructure, homelab architecture, or open-source collaboration? Let's connect.
          </p>
          <div class="flex flex-wrap gap-4">
            <a
              href="mailto:jainilprajapati9@gmail.com"
              class="inline-flex items-center gap-2 px-6 py-3 border text-xs font-mono uppercase tracking-widest transition-colors"
              style="border-color: var(--color-border); color: var(--color-text-primary); background-color: var(--color-surface);"
              onmouseenter="this.style.backgroundColor='var(--color-hover)'"
              onmouseleave="this.style.backgroundColor='var(--color-surface)'"
            >
              Email (jainilprajapati9@gmail.com)
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </a>
            <a
              href="https://www.linkedin.com/in/jaainil/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3 border text-xs font-mono uppercase tracking-widest transition-colors"
              style="border-color: var(--color-border); color: var(--color-text-primary); background-color: var(--color-surface);"
              onmouseenter="this.style.backgroundColor='var(--color-hover)'"
              onmouseleave="this.style.backgroundColor='var(--color-surface)'"
            >
              LinkedIn
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            <a
              href="https://github.com/jaainil"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3 border text-xs font-mono uppercase tracking-widest transition-colors"
              style="border-color: var(--color-border); color: var(--color-text-primary); background-color: var(--color-surface);"
              onmouseenter="this.style.backgroundColor='var(--color-hover)'"
              onmouseleave="this.style.backgroundColor='var(--color-surface)'"
            >
              GitHub
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            <a
              href="https://www.npmjs.com/~imjp"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3 border text-xs font-mono uppercase tracking-widest transition-colors"
              style="border-color: var(--color-border); color: var(--color-text-primary); background-color: var(--color-surface);"
              onmouseenter="this.style.backgroundColor='var(--color-hover)'"
              onmouseleave="this.style.backgroundColor='var(--color-surface)'"
            >
              npm
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>
