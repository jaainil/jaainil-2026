---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Schema } from 'astro-seo-schema';

const allAuthors = await getCollection('authors');
const teamMembers = allAuthors.map(a => ({
  name: a.data.name,
  avatarUrl: a.data.avatarUrl,
  role: a.data.role,
}));

const SITE_URL = 'https://shravonix.com';
const pageUrl = `${SITE_URL}/about`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'About', item: pageUrl },
  ],
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${pageUrl}#webpage`,
  name: 'About Shravonix — Tech News & Deep Dives',
  description: 'Learn about Shravonix, a technical publication delivering in-depth analysis of Linux, AI, IoT, and software engineering for developers and tech enthusiasts.',
  url: pageUrl,
  inLanguage: 'en',
  isPartOf: { '@id': `${SITE_URL}/#website` },
  about: { '@id': `${SITE_URL}/#organization` },
};
---

<BaseLayout
  title="About — Shravonix"
  description="Learn about Shravonix, a technical publication delivering in-depth analysis of Linux, AI, IoT, and software engineering for developers and tech enthusiasts."
>
  <Fragment slot="head">
    <Schema item={breadcrumbSchema as any} />
    <Schema item={webPageSchema as any} />
  </Fragment>
  <div class="w-full pb-16">
    
    <!-- Page heading -->
    <div class="border-b px-6 md:px-8 py-8" style="border-color: var(--color-border);">
      <p class="text-[11px] font-mono uppercase tracking-widest mb-2" style="color: var(--color-text-muted);">// About</p>
      <h1 class="text-4xl md:text-5xl font-display font-bold tracking-tight" style="color: var(--color-text-primary);">
        About Shravonix
      </h1>
    </div>

    <!-- Mission Section -->
    <section class="border-b px-6 md:px-8 py-16" style="border-color: var(--color-border);">
      <div class="max-w-3xl">
        <h2 class="text-sm font-mono font-bold uppercase tracking-widest mb-6" style="color: var(--color-text-primary);">
          // Mission
        </h2>
        <p class="text-lg font-sans leading-relaxed mb-6" style="color: var(--color-text-secondary);">
          Shravonix is a technical publication dedicated to bringing you deep, thoughtful analysis of the technologies that shape our world. We believe in going beyond surface-level reporting to explore the technical foundations, implications, and future directions of emerging technologies.
        </p>
        <p class="text-lg font-sans leading-relaxed" style="color: var(--color-text-secondary);">
          Our focus is on quality over quantity. Every piece we publish is researched thoroughly and written for readers who want to understand <em>how</em> technology works, not just what's trending.
        </p>
      </div>
    </section>

    <!-- What We Cover -->
    <section class="border-b px-6 md:px-8 py-16" style="border-color: var(--color-border);">
      <div class="max-w-3xl">
        <h2 class="text-sm font-mono font-bold uppercase tracking-widest mb-6" style="color: var(--color-text-primary);">
          // What We Cover
        </h2>
        <div class="space-y-4">
          <div class="flex items-start gap-4">
            <span class="text-xs font-mono uppercase tracking-widest mt-1" style="color: var(--color-accent-text);">01</span>
            <div>
              <h3 class="text-base font-display font-bold mb-2" style="color: var(--color-text-primary);">Linux</h3>
              <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Kernel updates, distributions, and open-source projects.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <span class="text-xs font-mono uppercase tracking-widest mt-1" style="color: var(--color-accent-text);">02</span>
            <div>
              <h3 class="text-base font-display font-bold mb-2" style="color: var(--color-text-primary);">Tech</h3>
              <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Industry trends, product launches, and tech ecosystem analysis.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <span class="text-xs font-mono uppercase tracking-widest mt-1" style="color: var(--color-accent-text);">03</span>
            <div>
              <h3 class="text-base font-display font-bold mb-2" style="color: var(--color-text-primary);">AI</h3>
              <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Artificial intelligence, machine learning, and automation.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <span class="text-xs font-mono uppercase tracking-widest mt-1" style="color: var(--color-accent-text);">04</span>
            <div>
              <h3 class="text-base font-display font-bold mb-2" style="color: var(--color-text-primary);">IoT</h3>
              <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Internet of Things, embedded systems, and smart devices.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <span class="text-xs font-mono uppercase tracking-widest mt-1" style="color: var(--color-accent-text);">05</span>
            <div>
              <h3 class="text-base font-display font-bold mb-2" style="color: var(--color-text-primary);">Opinions</h3>
              <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Thoughtful commentary on technology and its impact on society.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Team Section -->
    <section class="border-b px-6 md:px-8 py-16" style="border-color: var(--color-border);">
      <h2 class="text-sm font-mono font-bold uppercase tracking-widest mb-6" style="color: var(--color-text-primary);">
        // Team
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
        {teamMembers.map((member) => (
          <div class="border p-6 transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)'" onmouseleave="this.style.backgroundColor=''">
            <div class="flex items-center gap-4 mb-4">
              <img
                src={member.avatarUrl}
                alt={member.name}
                class="w-12 h-12 border"
                style="border-color: var(--color-border);"
              />
              <h3 class="text-base font-display font-bold" style="color: var(--color-text-primary);">
                {member.name}
              </h3>
            </div>
            <p class="text-xs font-mono uppercase tracking-widest" style="color: var(--color-text-muted);">
              Contributor
            </p>
          </div>
        ))}
      </div>
      <a
        href="/authors"
        class="inline-flex items-center gap-2 px-6 py-3 border text-xs font-mono uppercase tracking-widest transition-colors"
        style="border-color: var(--color-border); color: var(--color-text-secondary);"
        onmouseenter="this.style.backgroundColor='var(--color-hover)';this.style.color='var(--color-text-primary)'"
        onmouseleave="this.style.backgroundColor='';this.style.color='var(--color-text-secondary)'"
      >
        View All Authors
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </section>

    <!-- Contact Section -->
    <section class="border-b px-6 md:px-8 py-16" style="border-color: var(--color-border);">
      <div class="max-w-3xl">
        <h2 class="text-sm font-mono font-bold uppercase tracking-widest mb-6" style="color: var(--color-text-primary);">
          // Get in Touch
        </h2>
        <div class="space-y-6">
          <p class="text-base font-sans leading-relaxed" style="color: var(--color-text-secondary);">
            Have feedback, questions, or interested in contributing? We'd love to hear from you.
          </p>
          <div class="flex flex-wrap gap-4">
            <a
              href="https://github.com/jaainil/shravonix-com/issues/new?template=GUEST_POST.md"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3 border text-xs font-mono uppercase tracking-widest transition-colors"
              style="border-color: var(--color-text-primary); color: var(--color-text-primary);"
              onmouseenter="this.style.backgroundColor='var(--color-text-primary)';this.style.color='var(--color-surface)'"
              onmouseleave="this.style.backgroundColor='';this.style.color='var(--color-text-primary)'"
            >
              Write for Us
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            <a
              href="https://github.com/shravonix"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3 border text-xs font-mono uppercase tracking-widest transition-colors"
              style="border-color: var(--color-text-primary); color: var(--color-text-primary);"
              onmouseenter="this.style.backgroundColor='var(--color-text-primary)';this.style.color='var(--color-surface)'"
              onmouseleave="this.style.backgroundColor='';this.style.color='var(--color-text-primary)'"
            >
              GitHub
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            <a
              href="https://x.com/shravonix_com"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3 border text-xs font-mono uppercase tracking-widest transition-colors"
              style="border-color: var(--color-text-primary); color: var(--color-text-primary);"
              onmouseenter="this.style.backgroundColor='var(--color-text-primary)';this.style.color='var(--color-surface)'"
              onmouseleave="this.style.backgroundColor='';this.style.color='var(--color-text-primary)'"
            >
              X.com
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            <a
              href="mailto:hello@shravonix.com"
              class="inline-flex items-center gap-2 px-6 py-3 border text-xs font-mono uppercase tracking-widest transition-colors"
              style="border-color: var(--color-text-primary); color: var(--color-text-primary);"
              onmouseenter="this.style.backgroundColor='var(--color-text-primary)';this.style.color='var(--color-surface)'"
              onmouseleave="this.style.backgroundColor='';this.style.color='var(--color-text-primary)'"
            >
              Email
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>
