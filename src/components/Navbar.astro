---
import Logo from './Logo.astro';
---

<header class="sticky top-0 z-50 border-b font-sans transition-colors duration-200" style="background-color: var(--color-surface); border-color: var(--color-border);">
  <div class="w-full">
    <div class="flex justify-between items-stretch h-16">
      <div class="flex items-stretch">
        <div class="flex items-center px-4 sm:px-6 md:px-8 border-r h-full transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)'" onmouseleave="this.style.backgroundColor=''">
          <Logo />
        </div>
        <nav class="hidden lg:flex text-[11px] font-mono uppercase tracking-widest" style="color: var(--color-text-secondary);">
          <a href="/#experience" class="flex items-center px-4 xl:px-5 border-r transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)';this.style.color='var(--color-text-primary)'" onmouseleave="this.style.backgroundColor='';this.style.color=''">Experience</a>
          <a href="/#projects" class="flex items-center px-4 xl:px-5 border-r transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)';this.style.color='var(--color-text-primary)'" onmouseleave="this.style.backgroundColor='';this.style.color=''">Projects</a>
          <a href="/#skills" class="flex items-center px-4 xl:px-5 border-r transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)';this.style.color='var(--color-text-primary)'" onmouseleave="this.style.backgroundColor='';this.style.color=''">Skills</a>
          <a href="/#opensource" class="flex items-center px-4 xl:px-5 border-r transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)';this.style.color='var(--color-text-primary)'" onmouseleave="this.style.backgroundColor='';this.style.color=''">Open Source</a>
          <a href="/articles" class="flex items-center gap-1.5 px-4 xl:px-5 border-r transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)';this.style.color='var(--color-text-primary)'" onmouseleave="this.style.backgroundColor='';this.style.color=''">
            Shravonix Archive
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          </a>
          <a href="/about" class="flex items-center px-4 xl:px-5 border-r transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)';this.style.color='var(--color-text-primary)'" onmouseleave="this.style.backgroundColor='';this.style.color=''">About</a>
          <a href="/#contact" class="flex items-center px-4 xl:px-5 border-r transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)';this.style.color='var(--color-text-primary)'" onmouseleave="this.style.backgroundColor='';this.style.color=''">Contact</a>
        </nav>
      </div>
      <div class="flex items-stretch" style="color: var(--color-text-muted);">
        <!-- LinkedIn -->
        <a href="https://www.linkedin.com/in/jaainil/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="hidden sm:flex items-center px-3 sm:px-4 border-l transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)';this.style.color='var(--color-text-primary)'" onmouseleave="this.style.backgroundColor='';this.style.color=''">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
        </a>
        <!-- GitHub -->
        <a href="https://github.com/jaainil" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="flex items-center px-3 sm:px-4 border-l transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)';this.style.color='var(--color-text-primary)'" onmouseleave="this.style.backgroundColor='';this.style.color=''">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
        <!-- npmjs -->
        <a href="https://www.npmjs.com/~imjp" target="_blank" rel="noopener noreferrer" aria-label="npm" class="hidden sm:flex items-center px-3 sm:px-4 border-l transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)';this.style.color='var(--color-text-primary)'" onmouseleave="this.style.backgroundColor='';this.style.color=''">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M0 7.334v8h6.666v1.332H12v-1.332h12v-8H0zm6.666 6.666H4V9.999h2.666v4.001zm4 0H9.333V9.999h1.333v4.001zm10.667 0h-2.667v-4.001h-2.666v4.001h-2.667V9.999h8v4.001z"/>
          </svg>
        </a>
        <!-- Theme toggle -->
        <button
          id="theme-toggle"
          aria-label="Toggle dark mode"
          class="flex items-center px-3 sm:px-4 border-l transition-colors cursor-pointer"
          style="border-color: var(--color-border); background: none; color: var(--color-text-muted);"
          onmouseenter="this.style.backgroundColor='var(--color-hover)';this.style.color='var(--color-text-primary)'"
          onmouseleave="this.style.backgroundColor='';this.style.color=''"
        >
          <!-- Sun icon (shown in dark mode) -->
          <svg id="icon-sun" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z" />
          </svg>
          <!-- Moon icon (shown in light mode) -->
          <svg id="icon-moon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
          </svg>
        </button>
        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobile-menu-btn"
          aria-label="Toggle menu"
          class="flex lg:hidden items-center px-3 sm:px-4 border-l transition-colors cursor-pointer"
          style="border-color: var(--color-border); background: none; color: var(--color-text-muted);"
          onmouseenter="this.style.backgroundColor='var(--color-hover)';this.style.color='var(--color-text-primary)'"
          onmouseleave="this.style.backgroundColor='';this.style.color=''"
        >
          <svg id="menu-icon-open" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
    <!-- Mobile dropdown menu -->
    <div id="mobile-menu" class="hidden lg:hidden border-t font-mono text-xs uppercase tracking-widest" style="border-color: var(--color-border); background-color: var(--color-surface);">
      <div class="grid grid-cols-2 sm:grid-cols-3 divide-x divide-y" style="border-color: var(--color-border);">
        <a href="/#experience" class="mobile-nav-link p-4 flex items-center justify-between transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)'" onmouseleave="this.style.backgroundColor=''">
          <span>Experience</span>
          <span style="color: var(--color-text-muted);">//01</span>
        </a>
        <a href="/#projects" class="mobile-nav-link p-4 flex items-center justify-between transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)'" onmouseleave="this.style.backgroundColor=''">
          <span>Projects</span>
          <span style="color: var(--color-text-muted);">//02</span>
        </a>
        <a href="/#skills" class="mobile-nav-link p-4 flex items-center justify-between transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)'" onmouseleave="this.style.backgroundColor=''">
          <span>Skills</span>
          <span style="color: var(--color-text-muted);">//03</span>
        </a>
        <a href="/#opensource" class="mobile-nav-link p-4 flex items-center justify-between transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)'" onmouseleave="this.style.backgroundColor=''">
          <span>Open Source</span>
          <span style="color: var(--color-text-muted);">//04</span>
        </a>
        <a href="/articles" class="mobile-nav-link p-4 flex items-center justify-between transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)'" onmouseleave="this.style.backgroundColor=''">
          <span class="flex items-center gap-2">Shravonix Archive <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span></span>
          <span style="color: var(--color-text-muted);">//05</span>
        </a>
        <a href="/#contact" class="mobile-nav-link p-4 flex items-center justify-between transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)'" onmouseleave="this.style.backgroundColor=''">
          <span>Contact</span>
          <span style="color: var(--color-text-muted);">//06</span>
        </a>
      </div>
      <div class="flex items-center justify-around py-3 border-t text-[11px]" style="border-color: var(--color-border); color: var(--color-text-secondary);">
        <a href="https://github.com/jaainil" target="_blank" rel="noopener noreferrer" class="hover:underline">GitHub</a>
        <a href="https://www.linkedin.com/in/jaainil/" target="_blank" rel="noopener noreferrer" class="hover:underline">LinkedIn</a>
        <a href="https://www.npmjs.com/~imjp" target="_blank" rel="noopener noreferrer" class="hover:underline">npm</a>
        <a href="mailto:jainilprajapati9@gmail.com" class="hover:underline">Email</a>
      </div>
    </div>
  </div>
</header>

<script type="module">
  function initThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    const sun = document.getElementById('icon-sun');
    const moon = document.getElementById('icon-moon');
    const html = document.documentElement;

    function updateIcons() {
      const isDark = html.classList.contains('dark');
      sun?.classList.toggle('hidden', !isDark);
      moon?.classList.toggle('hidden', isDark);
    }

    updateIcons();

    btn?.addEventListener('click', () => {
      html.classList.toggle('dark');
      const isDark = html.classList.contains('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateIcons();
    });

    // Mobile menu toggle
    const menuBtn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    menuBtn?.addEventListener('click', () => {
      const isExpanded = !menu?.classList.contains('hidden');
      if (isExpanded) {
        menu?.classList.add('hidden');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
      } else {
        menu?.classList.remove('hidden');
        iconOpen?.classList.add('hidden');
        iconClose?.classList.remove('hidden');
      }
    });

    document.querySelectorAll('.mobile-nav-link').forEach(link => {
      link.addEventListener('click', () => {
        menu?.classList.add('hidden');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
      });
    });
  }

  initThemeToggle();
  document.addEventListener('astro:after-swap', initThemeToggle);
</script>

