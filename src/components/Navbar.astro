---
const links = [
  { href: '/#build', label: 'The build' },
  { href: '/#builds', label: 'Builds' },
  { href: '/#notes', label: 'Field notes' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-50" style="background-color: var(--page); border-bottom: 2px solid var(--keyline);">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex items-stretch justify-between h-16">
      <a href="/" class="flex items-center gap-3 group" aria-label="Jainil Prajapati, home">
        <span class="grid place-items-center w-9 h-9 rounded-lg transition-transform group-hover:-translate-y-0.5" style="background: var(--piece); border: 2px solid var(--keyline); box-shadow: 0 2px 0 var(--keyline);">
          <svg viewBox="0 0 24 24" class="w-5 h-5" aria-hidden="true">
            <circle cx="8.5" cy="8.5" r="2" fill="#fff" opacity="0.9"/>
            <circle cx="15.5" cy="8.5" r="2" fill="#fff" opacity="0.9"/>
            <circle cx="8.5" cy="15.5" r="2" fill="#fff" opacity="0.9"/>
            <circle cx="15.5" cy="15.5" r="2" fill="#fff" opacity="0.9"/>
          </svg>
        </span>
        <span class="font-extrabold text-lg tracking-tight" style="color: var(--ink);">Jainil Prajapati</span>
      </a>

      <div class="flex items-center gap-2">
        <nav class="hidden md:flex items-center gap-2" aria-label="Main">
          {links.map((l) => (
            <a
              href={l.href}
              class="px-3.5 py-2 rounded-lg text-sm font-semibold transition-colors hover:-translate-y-0.5"
              style="color: var(--ink); border: 2px solid var(--keyline); background: var(--paper); box-shadow: 0 2px 0 var(--keyline);"
            >
              {l.label}
            </a>
          ))}
        </nav>

        <button
          id="theme-toggle"
          aria-label="Toggle dark mode"
          class="grid place-items-center w-10 h-10 rounded-lg cursor-pointer transition-colors"
          style="border: 2px solid var(--keyline); background: var(--marker); box-shadow: 0 2px 0 var(--keyline); color: #10151b;"
        >
          <svg id="icon-sun" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" d="M12 4v2m0 12v2m8-8h-2M6 12H4m12.24-5.24l-1.42 1.42M9.18 14.82l-1.42 1.42m8.48 0l-1.42-1.42M9.18 9.18L7.76 7.76M12 8.5a3.5 3.5 0 100 7 3.5 3.5 0 000-7z" />
          </svg>
          <svg id="icon-moon" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
          </svg>
        </button>

        <button
          id="mobile-menu-btn"
          aria-label="Toggle menu"
          aria-expanded="false"
          class="md:hidden grid place-items-center w-10 h-10 rounded-lg cursor-pointer"
          style="border: 2px solid var(--keyline); background: var(--paper); box-shadow: 0 2px 0 var(--keyline); color: var(--ink);"
        >
          <svg id="menu-icon-open" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t-2" style="border-color: var(--keyline); background: var(--page);">
    <div class="px-4 py-4 flex flex-col gap-2">
      {links.map((l) => (
        <a
          href={l.href}
          class="mobile-nav-link px-4 py-3 rounded-lg text-base font-semibold"
          style="color: var(--ink); border: 2px solid var(--keyline); background: var(--paper); box-shadow: 0 2px 0 var(--keyline);"
        >
          {l.label}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  function initThemeToggle() {
    const html = document.documentElement;
    const toggles = document.querySelectorAll('#theme-toggle');

    function updateIcons() {
      const isDark = html.classList.contains('dark');
      document.querySelectorAll('#icon-sun, .theme-icon-sun').forEach((el) => el.classList.toggle('hidden', !isDark));
      document.querySelectorAll('#icon-moon, .theme-icon-moon').forEach((el) => el.classList.toggle('hidden', isDark));
    }

    updateIcons();

    toggles.forEach((btn) => {
      btn.addEventListener('click', () => {
        html.classList.toggle('dark');
        const isDark = html.classList.contains('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        updateIcons();
      });
    });

    const menuBtn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    menuBtn?.addEventListener('click', () => {
      const isExpanded = !menu?.classList.contains('hidden');
      menu?.classList.toggle('hidden');
      iconOpen?.classList.toggle('hidden');
      iconClose?.classList.toggle('hidden');
      menuBtn.setAttribute('aria-expanded', String(!isExpanded));
    });

    document.querySelectorAll('.mobile-nav-link').forEach((link) => {
      link.addEventListener('click', () => {
        menu?.classList.add('hidden');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
        menuBtn?.setAttribute('aria-expanded', 'false');
      });
    });
  }

  initThemeToggle();
  document.addEventListener('astro:after-swap', initThemeToggle);
</script>
