---
import Logo from './Logo.astro';
---

<header class="sticky top-0 z-50 border-b font-sans transition-colors duration-200" style="background-color: var(--color-surface); border-color: var(--color-border);">
  <div class="w-full">
    <div class="flex justify-between items-stretch h-16">
      <div class="flex items-stretch">
        <div class="flex items-center px-6 md:px-8 border-r h-full transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)'" onmouseleave="this.style.backgroundColor=''">
          <Logo />
        </div>
        <nav class="hidden md:flex text-[11px] font-mono uppercase tracking-widest" style="color: var(--color-text-secondary);">
          <a href="/articles" class="flex items-center px-6 border-r transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)';this.style.color='var(--color-text-primary)'" onmouseleave="this.style.backgroundColor='';this.style.color=''">Index</a>
          <a href="/about" class="flex items-center px-6 border-r transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)';this.style.color='var(--color-text-primary)'" onmouseleave="this.style.backgroundColor='';this.style.color=''">About</a>
          <a href="/guest" class="flex items-center px-6 border-r transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)';this.style.color='var(--color-text-primary)'" onmouseleave="this.style.backgroundColor='';this.style.color=''">Write for Us</a>
        </nav>
      </div>
      <div class="flex items-stretch" style="color: var(--color-text-muted);">
        <a href="https://github.com/jaainil/shravonix-com" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="flex items-center px-3 sm:px-4 md:px-6 border-l transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)';this.style.color='var(--color-text-primary)'" onmouseleave="this.style.backgroundColor='';this.style.color=''">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
        <a href="https://x.com/shravonix_com" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)" class="flex items-center px-3 sm:px-4 md:px-6 border-l transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)';this.style.color='var(--color-text-primary)'" onmouseleave="this.style.backgroundColor='';this.style.color=''">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.007 4.126H5.078z"/>
          </svg>
        </a>
        <a href="https://www.instagram.com/jaainil/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="flex items-center px-3 sm:px-4 md:px-6 border-l transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)';this.style.color='var(--color-text-primary)'" onmouseleave="this.style.backgroundColor='';this.style.color=''">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
        <!-- Theme toggle -->
        <button
          id="theme-toggle"
          aria-label="Toggle dark mode"
          class="flex items-center px-3 sm:px-4 md:px-6 border-l transition-colors cursor-pointer"
          style="border-color: var(--color-border); background: none; color: var(--color-text-muted);"
          onmouseenter="this.style.backgroundColor='var(--color-hover)';this.style.color='var(--color-text-primary)'"
          onmouseleave="this.style.backgroundColor='';this.style.color=''"
        >
          <!-- Sun icon (shown in dark mode) -->
          <svg id="icon-sun" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z" />
          </svg>
          <!-- Moon icon (shown in light mode) -->
          <svg id="icon-moon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
          </svg>
        </button>
        <a
          href="/rss.xml"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="RSS Feed"
          class="flex items-center px-3 sm:px-4 md:px-6 border-l transition-colors"
          style="border-color: var(--color-border);"
          onmouseenter="this.style.backgroundColor='var(--color-hover)';this.style.color='var(--color-text-primary)'"
          onmouseleave="this.style.backgroundColor='';this.style.color=''"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18a8 8 0 018-8 8 8 0 01-8 0M6 6a8 8 0 018 8 8 8 0 01-8 0" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2 5a3 3 0 116 0 3 3 0 01-6 0M2 14a3 3 0 116 0 3 3 0 01-6 0M2 11a3 3 0 116 0 3 3 0 01-6 0M2 19a3 3 0 116 0 3 3 0 01-6 0M12 5a3 3 0 100-6 3 3 0 000 6M12 14a3 3 0 100-6 3 3 0 000 6M12 11a3 3 0 100-6 3 3 0 000 6M12 19a3 3 0 100-6 3 3 0 000 6" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>

<script type="module">
  function initThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    const sun = document.getElementById('icon-sun');
    const moon = document.getElementById('icon-moon');
    const html = document.documentElement;

    function updateIcons() {
      const isDark = html.classList.contains('dark');
      sun?.classList.toggle('hidden', !isDark);
      moon?.classList.toggle('hidden', isDark);
    }

    updateIcons();

    btn?.addEventListener('click', () => {
      html.classList.toggle('dark');
      const isDark = html.classList.contains('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateIcons();
    });
  }

  initThemeToggle();
  document.addEventListener('astro:after-swap', initThemeToggle);
</script>
