---
import Logo from './Logo.astro';
---

<footer class="bg-zinc-900 text-zinc-400 font-sans border-t" style="border-color: var(--color-border);">
  <div class="w-full">
    <!-- Top banner / CTA -->
    <div class="grid grid-cols-1 md:grid-cols-2 border-b border-zinc-800">
      <div class="py-10 md:py-14 border-b md:border-b-0 md:border-r border-zinc-800 px-6 md:px-8">
        <p class="text-xs font-mono uppercase tracking-widest text-emerald-400 mb-2">// Available for Opportunities</p>
        <h2 class="text-2xl md:text-3xl font-display font-bold text-white mb-3 tracking-tight">
          Let's build scalable, reliable<br/>cloud infrastructure.
        </h2>
        <p class="text-sm text-zinc-400 font-sans leading-relaxed">
          Open for full-time DevOps & systems roles, homelab consulting, and open-source infrastructure projects.
        </p>
      </div>
      <div class="py-10 md:py-14 px-6 md:px-8 flex flex-col justify-center gap-4">
        <div class="flex flex-wrap gap-3">
          <a
            href="mailto:jainilprajapati9@gmail.com"
            class="inline-flex items-center gap-2 bg-white text-zinc-900 px-5 py-3 font-mono text-xs uppercase tracking-widest hover:bg-zinc-200 transition-colors font-semibold"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Send Email
          </a>
          <a
            href="https://www.linkedin.com/in/jaainil/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 border border-zinc-700 text-white px-5 py-3 font-mono text-xs uppercase tracking-widest hover:bg-zinc-800 transition-colors"
          >
            LinkedIn Profile
          </a>
        </div>
        <p class="text-[11px] font-mono text-zinc-500 uppercase tracking-widest">
          📍 Anand, Gujarat, India • +91 9725284302
        </p>
      </div>
    </div>

    <!-- Middle brand strip -->
    <div class="w-full py-8 bg-zinc-950 border-b border-zinc-800 flex items-center justify-between px-6 md:px-8 flex-wrap gap-4">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 flex items-center justify-center font-mono font-bold text-xs bg-white text-zinc-950 border border-zinc-700">
          JP
        </div>
        <div>
          <h3 class="text-white font-display font-bold text-base">Jainil Prajapati</h3>
          <p class="text-[10px] font-mono uppercase tracking-widest text-zinc-400">DevOps Engineer | Cloud & Platform Infrastructure</p>
        </div>
      </div>
      <div class="flex items-center gap-2 text-xs font-mono text-zinc-400">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
        <span class="text-white">Dokploy Contributor (10+ Merged PRs)</span>
      </div>
    </div>

    <!-- Navigation columns -->
    <div class="grid grid-cols-2 md:grid-cols-4">
      <div class="py-8 md:py-10 px-6 md:px-8 border-b md:border-b-0 border-r border-zinc-800">
        <h4 class="text-[11px] font-mono font-bold text-white uppercase tracking-widest mb-4">// Navigation</h4>
        <ul class="space-y-3 text-xs font-mono uppercase tracking-wider">
