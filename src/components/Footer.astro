---
const year = new Date().getFullYear();
---

<footer style="background: var(--color-footer-bg); border-top: 2px solid var(--keyline);">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-10">
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-8">
      <div class="max-w-sm">
        <div class="flex items-center gap-3 mb-3">
          <span class="grid place-items-center w-8 h-8 rounded-md" style="background: var(--piece); border: 2px solid var(--keyline);">
            <svg viewBox="0 0 24 24" class="w-4 h-4" aria-hidden="true">
              <circle cx="8.5" cy="8.5" r="2" fill="#fff" opacity="0.9"/>
              <circle cx="15.5" cy="8.5" r="2" fill="#fff" opacity="0.9"/>
              <circle cx="8.5" cy="15.5" r="2" fill="#fff" opacity="0.9"/>
              <circle cx="15.5" cy="15.5" r="2" fill="#fff" opacity="0.9"/>
            </svg>
          </span>
          <span class="font-extrabold text-base" style="color: var(--color-footer-heading);">Jainil Prajapati</span>
        </div>
        <p class="text-sm leading-relaxed" style="color: var(--color-footer-text);">
          This site is one page of Astro and Tailwind, hand-built, no template. Set and printed in Anand, Gujarat.
        </p>
      </div>

      <nav class="grid grid-cols-2 sm:grid-cols-3 gap-8 text-sm" aria-label="Footer">
        <div>
          <h2 class="font-bold mb-3 text-xs uppercase tracking-wider" style="color: var(--color-footer-heading);">Pages</h2>
          <ul class="space-y-2">
            <li><a href="/#builds" class="hover:underline underline-offset-4" style="color: var(--color-footer-text);">Builds</a></li>
            <li><a href="/#notes" class="hover:underline underline-offset-4" style="color: var(--color-footer-text);">Field notes</a></li>
            <li><a href="/articles" class="hover:underline underline-offset-4" style="color: var(--color-footer-text);">All articles</a></li>
            <li><a href="/about" class="hover:underline underline-offset-4" style="color: var(--color-footer-text);">About</a></li>
          </ul>
        </div>
        <div>
          <h2 class="font-bold mb-3 text-xs uppercase tracking-wider" style="color: var(--color-footer-heading);">Elsewhere</h2>
          <ul class="space-y-2">
            <li><a href="https://github.com/jaainil" target="_blank" rel="noopener noreferrer" class="hover:underline underline-offset-4" style="color: var(--color-footer-text);">GitHub</a></li>
            <li><a href="https://www.linkedin.com/in/jaainil/" target="_blank" rel="noopener noreferrer" class="hover:underline underline-offset-4" style="color: var(--color-footer-text);">LinkedIn</a></li>
            <li><a href="https://www.npmjs.com/~imjp" target="_blank" rel="noopener noreferrer" class="hover:underline underline-offset-4" style="color: var(--color-footer-text);">npm</a></li>
            <li><a href="https://www.reddit.com/user/enough_jainil/" target="_blank" rel="noopener noreferrer" class="hover:underline underline-offset-4" style="color: var(--color-footer-text);">Reddit</a></li>
          </ul>
        </div>
        <div>
          <h2 class="font-bold mb-3 text-xs uppercase tracking-wider" style="color: var(--color-footer-heading);">Feeds</h2>
          <ul class="space-y-2">
            <li><a href="/rss.xml" class="hover:underline underline-offset-4" style="color: var(--color-footer-text);">RSS</a></li>
            <li><a href="/llms.txt" class="hover:underline underline-offset-4" style="color: var(--color-footer-text);">llms.txt</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="mt-10 pt-5 flex flex-col sm:flex-row justify-between gap-2 text-xs" style="border-top: 1px solid var(--color-footer-border); color: var(--color-footer-text);">
      <p>© {year} Jainil Prajapati</p>
      <p>Full-stack & DevOps engineer · jaainil.com</p>
    </div>
  </div>
</footer>
