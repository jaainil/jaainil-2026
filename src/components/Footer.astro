    </div>

    <!-- Bottom copyright -->
    <div class="py-6 px-6 md:px-8 border-t border-zinc-800 text-[11px] font-mono uppercase tracking-widest text-zinc-500 flex flex-col md:flex-row justify-between items-center gap-3">
