            </a>
          </li>
          <li>
            <a href="https://www.linkedin.com/in/jaainil/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-2">
              LinkedIn
            </a>
          </li>
          <li>
            <a href="https://www.npmjs.com/~imjp" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-2">
