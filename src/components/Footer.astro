---
import Logo from './Logo.astro';
---

  <footer class="bg-zinc-900 text-zinc-400 font-sans border-t border-zinc-200">
    <div class="w-full">
      <div class="grid grid-cols-1 md:grid-cols-2 border-b border-zinc-800">
        <div class="py-12 md:py-16 border-b md:border-b-0 md:border-r border-zinc-800 px-6 md:px-8">
          <h2 class="text-3xl md:text-4xl font-display font-bold text-white mb-4 tracking-tight">
            Stay ahead of the curve<br/>in tech world.
          </h2>
        </div>
        <div class="py-12 md:py-16 px-6 md:px-12 flex flex-col justify-center">
          <h3 class="text-white font-bold mb-4 uppercase tracking-widest text-xs font-mono">Subscribe to our weekly newsletter</h3>
        <form class="flex gap-0 border border-zinc-700">
          <input 
            type="email" 
            placeholder="YOUR EMAIL ADDRESS" 
            autocomplete="off"
            class="bg-zinc-800 border-none rounded-none px-4 py-3 grow text-white focus:outline-none focus:ring-0 text-xs font-mono uppercase tracking-widest placeholder:text-zinc-500"
          />
          <button 
            type="submit" 
            class="bg-white text-zinc-900 px-6 py-3 rounded-none font-mono text-xs uppercase tracking-widest hover:bg-zinc-200 transition-colors border-l border-zinc-700"
          >
            Subscribe
          </button>
        </form>
      </div>
    </div>

    <div class="w-full h-40 bg-zinc-950 border-b border-zinc-800 flex items-center justify-center relative overflow-hidden">
      <div class="absolute inset-0 bg-[url('https://picsum.photos/seed/tech/1200/400')] opacity-10 mix-blend-luminosity bg-cover bg-center"></div>
      <div class="bg-white border border-zinc-200 p-6 z-10 shadow-2xl">
        <Logo />
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4">
      <div class="py-8 md:py-12 px-6 md:px-8 border-b md:border-b-0 border-r border-zinc-800">
        <h4 class="text-[11px] font-mono font-bold text-white uppercase tracking-widest mb-6">Categories</h4>
        <ul class="space-y-4 text-sm">
          <li><a href="/articles?category=AI" class="hover:text-white transition-colors">AI & Machine Learning</a></li>
          <li><a href="/articles?category=Programming" class="hover:text-white transition-colors">Web Development</a></li>
          <li><a href="/articles?category=Tech" class="hover:text-white transition-colors">Hardware</a></li>
          <li><a href="/articles?category=Opinions" class="hover:text-white transition-colors">Startups</a></li>
        </ul>
      </div>
      <div class="py-8 md:py-12 px-6 md:px-8 border-b md:border-b-0 md:border-r border-zinc-800">
        <h4 class="text-[11px] font-mono font-bold text-white uppercase tracking-widest mb-6">Company</h4>
        <ul class="space-y-4 text-sm">
          <li><a href="/about" class="hover:text-white transition-colors">About Us</a></li>
          <li><a href="/authors" class="hover:text-white transition-colors">Authors</a></li>
          <li><a href="/guest" class="hover:text-white transition-colors">Write for Us</a></li>
          <li><a href="/guest" class="hover:text-white transition-colors">Advertise</a></li>
          <li><a href="/legal/terms" class="hover:text-white transition-colors">Terms of Service</a></li>
          <li><a href="/legal/privacy" class="hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href="/legal/cookies" class="hover:text-white transition-colors">Cookie Policy</a></li>
          <li><a href="https://github.com/jaainil/shravonix-com/issues/new?template=GUEST_POST.md" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-2">
            Write for Us
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a></li>
        </ul>
      </div>
      <div class="py-8 md:py-12 px-6 md:px-8">
        <h4 class="text-[11px] font-mono font-bold text-white uppercase tracking-widest mb-6">Social</h4>
        <ul class="space-y-4 text-sm">
          <li><a href="https://github.com/jaainil/shravonix-com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-3">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            GitHub
          </a></li>
          <li><a href="https://x.com/shravonix_com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-3">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.007 4.126H5.078z"/>
            </svg>
            X.com
          </a></li>
          <li><a href="https://www.instagram.com/jaainil/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-3">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            Instagram
          </a></li>
          <li><a href="https://discord.gg/shravonix" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-3">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/>
            </svg>
            Discord
          </a></li>
        </ul>
      </div>
    </div>

    <div class="py-8 px-6 md:px-8 border-t border-zinc-800 text-[11px] font-mono uppercase tracking-widest text-zinc-500 flex justify-between items-center">
      <p>© 2026 SHRAVONIX MEDIA. ALL RIGHTS RESERVED.</p>
    </div>
  </div>
</footer>