---
/**
 * Article comments via giscus (GitHub Discussions), framed as a booklet sheet.
 * The iframe is skinned with custom Primer themes (public/giscus/theme-*.css)
 * and re-skinned live when the site's dark toggle flips. Theme URLs are built
 * from location.origin so they resolve in every deploy environment.
 */
const discussionsUrl = 'https://github.com/jaainil/jaainil-2026/discussions';
---

<section class="mt-12 max-w-4xl mx-auto rounded-2xl overflow-hidden" aria-label="Comments" style="background: var(--paper); border: 2px solid var(--keyline); box-shadow: 0 4px 0 var(--keyline);">
  <div class="px-6 sm:px-10 py-5 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1" style="border-bottom: 2px solid var(--keyline);">
    <h2 class="text-xl sm:text-2xl font-black tracking-tight" style="color: var(--ink);">Margin notes</h2>
    <p class="text-sm font-semibold" style="color: var(--color-text-muted);">
      The thread lives on
      <a href={discussionsUrl} target="_blank" rel="noopener noreferrer" class="font-bold underline underline-offset-4 decoration-2" style="color: var(--color-link);">GitHub Discussions</a>
      — sign in there to join.
    </p>
  </div>
  <div class="px-2 sm:px-6 py-2 giscus-frame-host">
    <script
      is:inline
      async
      src="https://giscus.app/client.js"
      id="giscus-script"
      data-repo="jaainil/jaainil-2026"
      data-repo-id="R_kgDOT-bjLA"
      data-category="Comments Website"
      data-category-id="DIC_kwDOT-bjLM4DESuq"
      data-mapping="pathname"
      data-strict="1"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="preferred_color_scheme"
      data-lang="en"
      data-loading="lazy"
      crossorigin="anonymous"
    ></script>
  </div>
  <script is:inline>
    (function () {
      var LIGHT = window.location.origin + '/giscus/theme-light.css';
      var DARK = window.location.origin + '/giscus/theme-dark.css';
      function bookletTheme() {
        return document.documentElement.classList.contains('dark') ? DARK : LIGHT;
      }
      // giscus reads data-theme when it boots (async + lazy), so correct it before that.
      var script = document.getElementById('giscus-script');
      if (script) script.setAttribute('data-theme', bookletTheme());
      // Live sync: the site's dark toggle flips a class on <html>.
      new MutationObserver(function () {
        var frame = document.querySelector('iframe.giscus-frame');
        if (!frame) return;
        frame.contentWindow.postMessage({ giscus: { setConfig: { theme: bookletTheme() } } }, 'https://giscus.app');
      }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    })();
  </script>
</section>
