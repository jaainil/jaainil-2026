---
/**
 * Article comments via giscus (GitHub Discussions), framed as a booklet sheet.
 * The iframe is skinned with custom Primer themes (public/giscus/theme-*.css)
 * and re-skinned live when the site's dark toggle flips. Theme URLs are built
 * from location.origin so they resolve in every deploy environment.
 */
const discussionsUrl = 'https://github.com/jaainil/jaainil-2026/discussions';
---

<section class="mt-12 max-w-4xl mx-auto rounded-2xl overflow-hidden" aria-label="Comments" style="background: var(--paper); border: 2px solid var(--keyline); box-shadow: 0 4px 0 var(--keyline);">
  <div class="px-6 sm:px-10 py-5 flex flex-col sm:flex-row sm:items-baseline justify-between gap-x-4 gap-y-2" style="border-bottom: 2px solid var(--keyline);">
    <h2 class="text-xl sm:text-2xl font-black tracking-tight" style="color: var(--ink);">Margin notes</h2>
    <div class="text-right sm:text-right">
      <p class="text-sm font-semibold" style="color: var(--color-text-muted);">
        The thread lives on
        <a href={discussionsUrl} target="_blank" rel="noopener noreferrer" class="font-bold underline underline-offset-4 decoration-2" style="color: var(--color-link);">GitHub Discussions</a>
        — sign in there to join.
      </p>
      <p class="text-[11px] mt-0.5" style="color: var(--color-text-muted);">
        Third-party embed: comments are processed under <a href="https://docs.github.com/en/site-policy/privacy-policies/github-privacy-statement" target="_blank" rel="noopener noreferrer" class="underline" style="color: var(--color-link);">GitHub's Privacy Statement</a>.
      </p>
    </div>
  </div>
  <div class="px-2 sm:px-6 py-2 giscus-frame-host">
    <script
      is:inline
      type="text/plain"
      id="giscus-script"
      data-repo="jaainil/jaainil-2026"
      data-repo-id="R_kgDOT-bjLA"
      data-category="Comments Website"
      data-category-id="DIC_kwDOT-bjLM4DESuq"
      data-mapping="pathname"
      data-strict="1"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="preferred_color_scheme"
      data-lang="en"
      data-loading="lazy"
      crossorigin="anonymous"
    ></script>
  </div>
  <script is:inline>
    (function () {
      var LIGHT = window.location.origin + '/giscus/theme-light.css';
      var DARK = window.location.origin + '/giscus/theme-dark.css';
      function bookletTheme() {
        return document.documentElement.classList.contains('dark') ? DARK : LIGHT;
      }
      // giscus is a third-party embed: load it only after the visitor accepts all (cookie_consent_v1 === 'all').
      // The placeholder above is type="text/plain" so the browser never executes it; we clone its attributes into a real script.
      var placeholder = document.getElementById('giscus-script');
      function loadGiscus() {
        if (!placeholder || document.getElementById('giscus-client')) return;
        var s = document.createElement('script');
        for (var i = 0; i < placeholder.attributes.length; i++) {
          var a = placeholder.attributes[i];
          if (a.name !== 'type' && a.name !== 'id') s.setAttribute(a.name, a.value);
        }
        s.id = 'giscus-client';
        s.async = true;
        s.src = 'https://giscus.app/client.js';
        // giscus reads data-theme when it boots, so set the booklet theme before insertion.
        s.setAttribute('data-theme', bookletTheme());
        placeholder.parentNode.appendChild(s);
      }
      var consent = null;
      try { consent = localStorage.getItem('cookie_consent_v1'); } catch (e) {}
      if (consent === 'all') loadGiscus();
      window.addEventListener('cookie-consent-change', function (e) {
        if (e.detail === 'all') loadGiscus();
      });
      // Live sync: the site's dark toggle flips a class on <html>.
      new MutationObserver(function () {
        var frame = document.querySelector('iframe.giscus-frame');
        if (!frame) return;
        frame.contentWindow.postMessage({ giscus: { setConfig: { theme: bookletTheme() } } }, 'https://giscus.app');
      }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    })();
  </script>
</section>
