---
interface Props {
  items: Array<{ id: string; title: string }>;
}

const { items } = Astro.props;
---

{items.length >= 2 && (
  <div id="toc-dock" class="fixed bottom-4 left-1/2 -translate-x-1/2 z-50 w-max max-w-[94vw]" data-open="false">
    <nav
      class="rounded-2xl overflow-hidden"
      aria-label="On this page"
      style="background: var(--paper); border: 2px solid var(--keyline); box-shadow: 0 3px 0 var(--keyline);"
    >
      <!-- Collapsed bar: current section -->
      <button
        id="toc-toggle"
        class="flex items-center gap-2.5 pl-3 pr-3.5 py-2.5 cursor-pointer w-full"
        aria-expanded="false"
        aria-controls="toc-panel"
      >
        <svg viewBox="0 0 24 24" class="w-4 h-4 shrink-0" aria-hidden="true">
          <rect x="3" y="7" width="18" height="11" rx="2" fill="var(--piece)" stroke="var(--keyline)" stroke-width="2"/>
          <circle cx="8.5" cy="7" r="2.4" fill="var(--piece)" stroke="var(--keyline)" stroke-width="2"/>
          <circle cx="15.5" cy="7" r="2.4" fill="var(--piece)" stroke="var(--keyline)" stroke-width="2"/>
        </svg>
        <span id="toc-current" class="text-sm font-bold truncate max-w-[260px] sm:max-w-[340px]" style="color: var(--ink);"></span>
        <svg id="toc-chevron" class="w-4 h-4 shrink-0 ml-1 transition-transform duration-200" fill="none" stroke="var(--ink)" stroke-width="2.6" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M18 15l-6-6-6 6" />
        </svg>
      </button>

      <!-- Expanded panel: full contents -->
      <div id="toc-panel" class="hidden border-t-2" style="border-color: var(--keyline);">
        <ul id="toc-list" class="py-2 max-h-[50vh] overflow-y-auto">
          {items.map((item, i) => (
            <li>
              <a
                href={`#${item.id}`}
                class="toc-link flex items-center gap-3 px-4 py-2.5 text-sm font-semibold transition-colors hover:bg-[var(--color-hover)]"
                data-id={item.id}
              >
                <span class="toc-num grid place-items-center w-6 h-6 shrink-0 rounded-md text-[11px] font-black" style="border: 2px solid var(--keyline); background: var(--paper); color: var(--ink);">{i + 1}</span>
                <span class="truncate" style="color: var(--color-text-secondary);">{item.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  </div>
)}

<script define:vars={{ items }}>
  const dock = document.getElementById('toc-dock');
  if (dock && items.length >= 2) {
    const toggle = document.getElementById('toc-toggle');
    const panel = document.getElementById('toc-panel');
    const chevron = document.getElementById('toc-chevron');
    const currentEl = document.getElementById('toc-current');
    const links = dock.querySelectorAll('.toc-link');
    const nums = dock.querySelectorAll('.toc-num');

    const setOpen = (open) => {
      dock.dataset.open = String(open);
      panel.classList.toggle('hidden', !open);
      chevron.style.transform = open ? 'rotate(180deg)' : '';
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener('click', () => setOpen(dock.dataset.open !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
    document.addEventListener('click', (e) => {
      if (dock.dataset.open === 'true' && !dock.contains(e.target)) setOpen(false);
    });
    links.forEach((link) => link.addEventListener('click', () => setOpen(false)));

    const getActiveId = () => {
      const scrollY = window.scrollY + 120;
      let current = items[0].id;
      let closest = Infinity;

      for (const item of items) {
        const el = document.getElementById(item.id);
        if (el) {
          const rect = el.getBoundingClientRect();
          const top = rect.top + window.scrollY;
          const distance = Math.abs(top - scrollY);
          if (rect.top <= 140 && distance < closest) {
            current = item.id;
            closest = distance;
          }
        }
      }
      return current;
    };

    const update = () => {
      const activeId = getActiveId();
      const active = items.find((i) => i.id === activeId);
      if (currentEl && active) currentEl.textContent = active.title;

      links.forEach((link) => {
        const isActive = link.getAttribute('data-id') === activeId;
        link.style.background = isActive ? 'var(--color-hover)' : '';
        const num = link.querySelector('.toc-num');
        if (num) {
          num.style.background = isActive ? 'var(--piece)' : 'var(--paper)';
          num.style.color = isActive ? '#ffffff' : 'var(--ink)';
        }
      });
    };

    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
